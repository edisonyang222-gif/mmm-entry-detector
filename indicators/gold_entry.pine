// 黃金進場指標（從頭重做 · 單一檔案）
// 用途：XAUUSD / GOLD，建議 H1 或 H4
//@version=5
indicator("黃金進場指標", shorttitle="黃金進場", overlay=true, max_labels_count=300)

// ───────── 參數 ─────────
grp1 = "趨勢"
emaFast = input.int(20, "快線 EMA", minval=5, group=grp1)
emaSlow = input.int(50, "慢線 EMA", minval=10, group=grp1)
emaBias = input.int(100, "方向 EMA", minval=50, group=grp1)

grp2 = "進場"
rsiLen = input.int(14, "RSI 週期", group=grp2)
atrLen = input.int(14, "ATR 週期", group=grp2)
adxLen = input.int(14, "ADX 週期", group=grp2)
adxMin = input.float(18.0, "最低 ADX（過濾盤整）", step=0.5, group=grp2)
cooldown = input.int(8, "訊號冷卻根數", minval=1, group=grp2)

grp3 = "風控"
slMult = input.float(2.0, "停損 ATR 倍數", step=0.1, group=grp3)
tp1Mult = input.float(3.0, "目標1 ATR 倍數", step=0.1, group=grp3)
tp2Mult = input.float(5.0, "目標2 ATR 倍數", step=0.1, group=grp3)

grp4 = "時段（台北時間）"
useSess = input.bool(true, "啟用時段過濾", group=grp4)
tz = "Asia/Taipei"
doAsia = input.bool(false, "亞盤 07:00–14:00", group=grp4)
doLon  = input.bool(true,  "倫敦 15:00–23:30", group=grp4)
doNy   = input.bool(true,  "美盤 21:30–04:00", group=grp4)
asiaS  = input.session("0700-1400", "亞盤", group=grp4)
lonS   = input.session("1500-2330", "倫敦", group=grp4)
nyS    = input.session("2130-0400", "美盤", group=grp4)

grp5 = "顯示"
showPanel = input.bool(true, "顯示面板", group=grp5)
panelPos  = input.string("右上", "面板位置", options=["左上", "中上", "右上", "左中", "右中", "左下", "中下", "右下"], group=grp5)
showLvl   = input.bool(true, "顯示停損/目標", group=grp5)

posOf(s) =>
    switch s
        "左上" => position.top_left
        "中上" => position.top_center
        "右上" => position.top_right
        "左中" => position.middle_left
        "右中" => position.middle_right
        "左下" => position.bottom_left
        "中下" => position.bottom_center
        "右下" => position.bottom_right
        => position.top_right

// ───────── 計算 ─────────
f = ta.ema(close, emaFast)
s = ta.ema(close, emaSlow)
b = ta.ema(close, emaBias)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
[_, _, adx] = ta.dmi(adxLen, adxLen)

bull = f > s and close > b
bear = f < s and close < b
trendOk = adx >= adxMin
volOk = atr > 0

inAsia = not na(time(timeframe.period, asiaS, tz))
inLon  = not na(time(timeframe.period, lonS, tz))
inNy   = not na(time(timeframe.period, nyS, tz))
sessOk = not useSess or ((doAsia and inAsia) or (doLon and inLon) or (doNy and inNy))
sessName = inLon and inNy ? "倫美重疊" : inNy ? "美盤" : inLon ? "倫敦" : inAsia ? "亞盤" : "休市"

// 順勢回檔進場
pullLong  = low <= f * 1.001 and close > f and close > open and close > close[1]
pullShort = high >= f * 0.999 and close < f and close < open and close < close[1]
rsiLong   = rsi >= 35 and rsi <= 55
rsiShort  = rsi <= 65 and rsi >= 45

longRaw  = bull and trendOk and sessOk and pullLong and rsiLong and volOk
shortRaw = bear and trendOk and sessOk and pullShort and rsiShort and volOk

var int lastL = na
var int lastS = na
longFire  = longRaw  and (na(lastL) or bar_index - lastL >= cooldown)
shortFire = shortRaw and (na(lastS) or bar_index - lastS >= cooldown)
if longFire
    lastL := bar_index
if shortFire
    lastS := bar_index

slL  = close - atr * slMult
tp1L = close + atr * tp1Mult
tp2L = close + atr * tp2Mult
slS  = close + atr * slMult
tp1S = close - atr * tp1Mult
tp2S = close - atr * tp2Mult

// ───────── 繪圖 ─────────
plot(f, "快線", color=color.new(#2E7D32, 0), linewidth=2)
plot(s, "慢線", color=color.new(#C62828, 0), linewidth=2)
plot(b, "方向", color=color.new(#546E7A, 40), linewidth=2)
plotshape(longFire,  title="做多", style=shape.triangleup,   location=location.belowbar, color=color.new(#00C853, 0), size=size.small, text="做多")
plotshape(shortFire, title="做空", style=shape.triangledown, location=location.abovebar, color=color.new(#FF1744, 0), size=size.small, text="做空")
bgcolor(bull ? color.new(#1B5E20, 94) : bear ? color.new(#B71C1C, 94) : color.new(#78909C, 94))

if showLvl and longFire
    label.new(bar_index, low, "停損 " + str.tostring(slL, format.mintick) + "\n目標1 " + str.tostring(tp1L, format.mintick) + "\n目標2 " + str.tostring(tp2L, format.mintick), style=label.style_label_up, color=color.new(#00C853, 20), textcolor=color.white, size=size.small)
if showLvl and shortFire
    label.new(bar_index, high, "停損 " + str.tostring(slS, format.mintick) + "\n目標1 " + str.tostring(tp1S, format.mintick) + "\n目標2 " + str.tostring(tp2S, format.mintick), style=label.style_label_down, color=color.new(#FF1744, 20), textcolor=color.white, size=size.small)

alertcondition(longFire,  "做多", "黃金做多 | {{ticker}} @ {{close}}")
alertcondition(shortFire, "做空", "黃金做空 | {{ticker}} @ {{close}}")

// ───────── 面板 ─────────
var table dash = na
var string prevPos = na
if showPanel
    if na(dash) or prevPos != panelPos
        if not na(dash)
            table.delete(dash)
        dash := table.new(posOf(panelPos), 2, 7, bgcolor=color.new(#102027, 15), border_width=1)
        prevPos := panelPos
    if barstate.islast
        table.cell(dash, 0, 0, "黃金進場", text_color=color.white, text_size=size.small)
        table.cell(dash, 1, 0, "XAU", text_color=color.gray, text_size=size.small)
        table.cell(dash, 0, 1, "方向", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 1, bull ? "多頭" : bear ? "空頭" : "盤整", text_color=bull ? color.lime : bear ? color.red : color.orange, text_size=size.small)
        table.cell(dash, 0, 2, "ADX", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 2, str.tostring(adx, "#.0"), text_color=trendOk ? color.lime : color.orange, text_size=size.small)
        table.cell(dash, 0, 3, "RSI", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 3, str.tostring(rsi, "#.0"), text_color=color.white, text_size=size.small)
        table.cell(dash, 0, 4, "時段", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 4, sessOk ? sessName : sessName + "·休", text_color=sessOk ? color.lime : color.red, text_size=size.small)
        table.cell(dash, 0, 5, "狀態", text_color=color.gray, text_size=size.small)
        st = longFire ? "做多" : shortFire ? "做空" : not trendOk ? "盤整觀望" : "等待"
        table.cell(dash, 1, 5, st, text_color=longFire ? color.lime : shortFire ? color.red : color.gray, text_size=size.small)
        table.cell(dash, 0, 6, "風控", text_color=color.gray, text_size=size.small)
        table.cell(dash, 1, 6, "SL " + str.tostring(slMult) + " / TP " + str.tostring(tp1Mult) + "-" + str.tostring(tp2Mult), text_color=color.white, text_size=size.small)
else if not na(dash)
    table.delete(dash)
    dash := na
    prevPos := na
