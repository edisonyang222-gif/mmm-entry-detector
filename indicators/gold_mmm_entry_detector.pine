// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// 黃金 MMM 進場偵測器
// 趨勢共振模型 + 盤整均值回歸模型（多空雙吃）+ 專屬盤整面板

//@version=5
indicator("黃金MMM進場偵測", shorttitle="黃金MMM", overlay=true, max_labels_count=500, max_boxes_count=50)

// ═══════════════════════════════════════════════════════════
// ① 運作模式
// ═══════════════════════════════════════════════════════════
grpMode = "① 運作模式"
modelMode = input.string("自動切換", "模型模式", options=["自動切換", "只做趨勢", "只做盤整"], group=grpMode, tooltip="自動：有趨勢走趨勢模型；判定盤整走盤整模型（多空雙吃）。")
tradeMode = input.string("多空皆可", "交易方向", options=["多空皆可", "只做多", "只做空"], group=grpMode)

// ═══════════════════════════════════════════════════════════
// ② 趨勢模型參數
// ═══════════════════════════════════════════════════════════
grpTrend = "② 趨勢模型 · 均線"
emaFastLen = input.int(20,  "快線 EMA", minval=5, group=grpTrend)
emaSlowLen = input.int(50,  "慢線 EMA", minval=10, group=grpTrend)
emaBiasLen = input.int(100, "方向 EMA", minval=50, group=grpTrend)

grpMom = "② 趨勢模型 · 動能"
rsiLen      = input.int(14, "RSI 週期", minval=2, group=grpMom)
rsiBuyLow   = input.int(35, "趨勢多 RSI 下限", minval=10, maxval=50, group=grpMom)
rsiBuyHigh  = input.int(55, "趨勢多 RSI 上限", minval=40, maxval=70, group=grpMom)
rsiSellHigh = input.int(65, "趨勢空 RSI 上限", minval=50, maxval=90, group=grpMom)
rsiSellLow  = input.int(45, "趨勢空 RSI 下限", minval=30, maxval=60, group=grpMom)

grpMtf = "② 趨勢模型 · 高週期共振"
useMtf    = input.bool(true, "啟用高週期共振", group=grpMtf)
htf1      = input.timeframe("240", "第一共振週期", group=grpMtf)
useHtf2   = input.bool(true, "啟用第二共振週期", group=grpMtf)
htf2      = input.timeframe("D", "第二共振週期", group=grpMtf)
htfEmaLen = input.int(50, "高週期 EMA", minval=10, group=grpMtf)

grpMacd = "② 趨勢模型 · MACD / 斜率"
useMacd   = input.bool(true, "啟用 MACD 共振", group=grpMacd)
macdFast  = input.int(12, "MACD 快線", minval=2, group=grpMacd)
macdSlow  = input.int(26, "MACD 慢線", minval=5, group=grpMacd)
macdSig   = input.int(9, "MACD 訊號線", minval=2, group=grpMacd)
useSlope  = input.bool(true, "啟用斜率過濾", group=grpMacd)
slopeBars = input.int(3, "斜率回看根數", minval=1, group=grpMacd)
minScore  = input.int(5, "趨勢最低共振分數", minval=2, maxval=8, group=grpMacd)

// ═══════════════════════════════════════════════════════════
// ③ 盤整判定（兩模型共用）
// ═══════════════════════════════════════════════════════════
grpRangeDetect = "③ 盤整判定"
adxLen   = input.int(14, "ADX 週期", minval=5, group=grpRangeDetect)
chopLen  = input.int(14, "Choppiness 週期", minval=5, group=grpRangeDetect)
erLen    = input.int(10, "效率比週期", minval=3, group=grpRangeDetect)
// 趨勢模型：這些條件「失敗」→ 視為盤整，禁止趨勢單
adxMinTrend     = input.float(18.0, "趨勢最低 ADX", minval=5, step=0.5, group=grpRangeDetect)
chopMaxTrend    = input.float(65.0, "趨勢最高 CHOP", minval=38, maxval=80, step=0.1, group=grpRangeDetect)
emaGapMinAtr    = input.float(0.25, "趨勢最小均線間距(ATR)", minval=0.05, step=0.05, group=grpRangeDetect)
erMinTrend      = input.float(0.18, "趨勢最低效率比", minval=0.05, maxval=1, step=0.05, group=grpRangeDetect)
// 盤整模型：這些條件「成立」→ 確認可做盤整單（需達分數）
adxMaxRange     = input.float(22.0, "盤整最高 ADX", minval=5, step=0.5, group=grpRangeDetect)
chopMinRange    = input.float(55.0, "盤整最低 CHOP", minval=38, maxval=80, step=0.1, group=grpRangeDetect)
emaGapMaxAtr    = input.float(0.55, "盤整最大均線間距(ATR)", minval=0.05, step=0.05, group=grpRangeDetect)
erMaxRange      = input.float(0.30, "盤整最高效率比", minval=0.05, maxval=1, step=0.05, group=grpRangeDetect)
minRangeConfirm = input.int(2, "盤整確認最少條件數", minval=1, maxval=4, group=grpRangeDetect, tooltip="ADX低 / CHOP高 / 均線糾結 / 效率比低，至少幾個成立才啟用盤整模型。")

// ═══════════════════════════════════════════════════════════
// ④ 盤整模型 · 入場與過濾
// ═══════════════════════════════════════════════════════════
grpRangeEntry = "④ 盤整模型 · 入場條件"
bbLen        = input.int(20, "布林週期", minval=5, group=grpRangeEntry)
bbMult       = input.float(2.0, "布林倍數", minval=1.0, step=0.1, group=grpRangeEntry)
donLen       = input.int(20, "唐奇安通道週期", minval=5, group=grpRangeEntry)
rangeRsiBuy  = input.int(35, "盤整做多 RSI ≤", minval=10, maxval=45, group=grpRangeEntry)
rangeRsiSell = input.int(65, "盤整做空 RSI ≥", minval=55, maxval=90, group=grpRangeEntry)
minRangeWidthAtr = input.float(1.2, "最小通道寬度(ATR倍)", minval=0.3, step=0.1, group=grpRangeEntry, tooltip="通道太窄沒有利潤空間，不開盤整單。")
maxRangeWidthAtr = input.float(6.0, "最大通道寬度(ATR倍)", minval=2.0, step=0.1, group=grpRangeEntry, tooltip="通道過寬可能是假盤整/波動擴張。")
requireReject    = input.bool(true, "必須影線拒絕確認", group=grpRangeEntry)
requireCloseIn   = input.bool(true, "收盤必須回到通道內", group=grpRangeEntry)
blockBreakout    = input.bool(true, "禁止收盤突破通道", group=grpRangeEntry)
useStochFilter   = input.bool(true, "隨機指標同向過濾", group=grpRangeEntry)
stochK           = input.int(14, "Stoch K", minval=3, group=grpRangeEntry)
stochD           = input.int(3, "Stoch D", minval=1, group=grpRangeEntry)
stochBuy         = input.int(25, "盤多 Stoch ≤", minval=5, maxval=40, group=grpRangeEntry)
stochSell        = input.int(75, "盤空 Stoch ≥", minval=60, maxval=95, group=grpRangeEntry)
minRangeScore    = input.int(4, "盤整進場最低分數", minval=2, maxval=7, group=grpRangeEntry, tooltip="觸軌、RSI、拒絕K、通道寬、Stoch、波動正常、收盤回通道。")
rangeCooldown     = input.int(6, "盤整訊號冷卻根數", minval=1, group=grpRangeEntry)

grpRangeRisk = "④ 盤整模型 · 風控"
rangeSlBufAtr = input.float(0.25, "停損緩衝(ATR)", minval=0.05, step=0.05, group=grpRangeRisk)
useMidTp      = input.bool(true, "TP1 = 通道中軌", group=grpRangeRisk)
rangeTp2Opp   = input.bool(true, "TP2 = 對側軌道", group=grpRangeRisk)

// ═══════════════════════════════════════════════════════════
// ⑤ 共用：波動 / 時段 / 趨勢風控 / 顯示
// ═══════════════════════════════════════════════════════════
grpVol = "⑤ 波動率 ATR"
atrLen     = input.int(14, "ATR 週期", minval=1, group=grpVol)
atrMaLen   = input.int(50, "ATR 均線", minval=5, group=grpVol)
minAtrMult = input.float(0.6, "ATR 下限倍數", minval=0.1, step=0.05, group=grpVol)
maxAtrMult = input.float(2.5, "ATR 上限倍數（爆衝不做）", minval=1.0, step=0.05, group=grpVol)

grpTrendRisk = "⑤ 趨勢模型 · 風控"
slAtrMult    = input.float(2.0, "趨勢停損 ATR", minval=0.5, step=0.1, group=grpTrendRisk)
tp1AtrMult   = input.float(3.0, "趨勢TP1 ATR", minval=0.5, step=0.1, group=grpTrendRisk)
tp2AtrMult   = input.float(5.0, "趨勢TP2 ATR", minval=1.0, step=0.1, group=grpTrendRisk)
cooldownBars = input.int(8, "趨勢訊號冷卻", minval=1, group=grpTrendRisk)

grpSession = "⑤ 時段過濾（台北時間）"
useSession  = input.bool(true, "啟用時段過濾", group=grpSession)
tz          = input.string("Asia/Taipei", "時區", options=["Asia/Taipei", "UTC", "America/New_York", "Europe/London"], group=grpSession)
tradeAsia   = input.bool(false, "交易亞盤", group=grpSession)
tradeLondon = input.bool(true, "交易倫敦盤", group=grpSession)
tradeNy     = input.bool(true, "交易美盤", group=grpSession)
useOverlap  = input.bool(false, "只做倫敦與美盤重疊", group=grpSession)
asiaSess    = input.session("0700-1400", "亞盤 07:00–14:00", group=grpSession)
londonSess  = input.session("1500-2330", "倫敦 15:00–23:30", group=grpSession)
nySess      = input.session("2130-0400", "美盤 21:30–04:00", group=grpSession)

grpUi = "⑥ 顯示"
showLevels    = input.bool(true, "訊號顯示停損/停利", group=grpUi)
showBg        = input.bool(true, "依模型上色背景", group=grpUi)
showBands     = input.bool(true, "顯示盤整通道", group=grpUi)
showTrendDash = input.bool(true, "顯示趨勢面板", group=grpUi)
trendDashPos  = input.string("右上", "趨勢面板位置", options=["左上", "中上", "右上", "左中", "右中", "左下", "中下", "右下"], group=grpUi)
showRangeDash = input.bool(true, "顯示盤整專屬面板", group=grpUi)
rangeDashPos  = input.string("左上", "盤整面板位置", options=["左上", "中上", "右上", "左中", "右中", "左下", "中下", "右下"], group=grpUi)

// 面板位置對照
f_panelPos(p) =>
    switch p
        "左上" => position.top_left
        "中上" => position.top_center
        "右上" => position.top_right
        "左中" => position.middle_left
        "右中" => position.middle_right
        "左下" => position.bottom_left
        "中下" => position.bottom_center
        "右下" => position.bottom_right
        => position.top_right

// ═══════════════════════════════════════════════════════════
// 基礎計算
// ═══════════════════════════════════════════════════════════
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaBias = ta.ema(close, emaBiasLen)
rsiVal  = ta.rsi(close, rsiLen)
atrVal  = ta.atr(atrLen)
atrMa   = ta.sma(atrVal, atrMaLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

basis = ta.sma(close, bbLen)
dev   = bbMult * ta.stdev(close, bbLen)
bbUpper = basis + dev
bbLower = basis - dev
bbMid   = basis
donHigh = ta.highest(high, donLen)
donLow  = ta.lowest(low, donLen)
donMid  = (donHigh + donLow) / 2
// 通道取布林與唐奇安的「交集感」：上軌取較緊的一側、下軌取較緊的一側，精準觸軌
rangeUpper = math.min(bbUpper, donHigh)
rangeLower = math.max(bbLower, donLow)
rangeMid   = (rangeUpper + rangeLower) / 2
rangeWidth = rangeUpper - rangeLower
rangeWidthAtr = atrVal > 0 ? rangeWidth / atrVal : 0.0

smoothK = ta.sma(ta.stoch(close, high, low, stochK), stochD)
smoothD = ta.sma(smoothK, stochD)

bullTrend = emaFast > emaSlow and close > emaBias
bearTrend = emaFast < emaSlow and close < emaBias
emaSlopeUp   = emaFast > emaFast[slopeBars]
emaSlopeDown = emaFast < emaFast[slopeBars]
volOk = atrMa > 0 and atrVal / atrMa >= minAtrMult and atrVal / atrMa <= maxAtrMult

inAsia   = not na(time(timeframe.period, asiaSess, tz))
inLondon = not na(time(timeframe.period, londonSess, tz))
inNY     = not na(time(timeframe.period, nySess, tz))
inAllowed = (tradeAsia and inAsia) or (tradeLondon and inLondon) or (tradeNy and inNY)
sessionOk = not useSession or (useOverlap ? (inLondon and inNY) : inAllowed)
sessionName = inLondon and inNY ? "倫美重疊" : inNY ? "美盤" : inLondon ? "倫敦盤" : inAsia ? "亞盤" : "休市"

allowLong  = tradeMode != "只做空"
allowShort = tradeMode != "只做多"

// ═══════════════════════════════════════════════════════════
// 盤整 / 趨勢 環境判定
// ═══════════════════════════════════════════════════════════
atrSumChop = math.sum(ta.tr(true), chopLen)
hiChop = ta.highest(high, chopLen)
loChop = ta.lowest(low, chopLen)
chopRange = hiChop - loChop
chopVal = chopRange > 0 ? 100 * math.log10(atrSumChop / chopRange) / math.log10(chopLen) : 100.0
emaGapAtr = atrVal > 0 ? math.abs(emaFast - emaSlow) / atrVal : 0.0
erMove = math.abs(close - close[erLen])
erPath = math.sum(math.abs(close - close[1]), erLen)
erVal = erPath > 0 ? erMove / erPath : 0.0

// 趨勢可做：四項都偏趨勢
trendAdxOk  = adxVal >= adxMinTrend
trendChopOk = chopVal <= chopMaxTrend
trendGapOk  = emaGapAtr >= emaGapMinAtr
trendErOk   = erVal >= erMinTrend
trendEnvOk  = trendAdxOk and trendChopOk and trendGapOk and trendErOk

// 盤整確認分數（專門給盤整模型）
rngCondAdx  = adxVal <= adxMaxRange
rngCondChop = chopVal >= chopMinRange
rngCondGap  = emaGapAtr <= emaGapMaxAtr
rngCondEr   = erVal <= erMaxRange
rangeConfirmScore = (rngCondAdx ? 1 : 0) + (rngCondChop ? 1 : 0) + (rngCondGap ? 1 : 0) + (rngCondEr ? 1 : 0)
widthOk = rangeWidthAtr >= minRangeWidthAtr and rangeWidthAtr <= maxRangeWidthAtr
rangeEnvOk = rangeConfirmScore >= minRangeConfirm and widthOk

isRanging = rangeEnvOk
isTrending = trendEnvOk and not rangeEnvOk

enableTrend = modelMode == "只做趨勢" or (modelMode == "自動切換" and isTrending)
enableRange = modelMode == "只做盤整" or (modelMode == "自動切換" and isRanging)
// 自動切換若兩者都不明確 → 觀望
activeModel = enableRange ? "盤整" : enableTrend ? "趨勢" : "觀望"

// ═══════════════════════════════════════════════════════════
// 趨勢模型訊號
// ═══════════════════════════════════════════════════════════
htf1Close = request.security(syminfo.tickerid, htf1, close, lookahead=barmerge.lookahead_off)
htf1Ema   = request.security(syminfo.tickerid, htf1, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htf1Bull  = htf1Close > htf1Ema
htf1Bear  = htf1Close < htf1Ema
htf2Close = request.security(syminfo.tickerid, htf2, close, lookahead=barmerge.lookahead_off)
htf2Ema   = request.security(syminfo.tickerid, htf2, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htf2Bull  = htf2Close > htf2Ema
htf2Bear  = htf2Close < htf2Ema
mtfLongOk  = (not useMtf or htf1Bull) and (not useMtf or not useHtf2 or htf2Bull)
mtfShortOk = (not useMtf or htf1Bear) and (not useMtf or not useHtf2 or htf2Bear)

pullbackLong  = low <= emaFast * 1.001 and close > emaFast
pullbackShort = high >= emaFast * 0.999 and close < emaFast
rsiTrendLong  = rsiVal >= rsiBuyLow and rsiVal <= rsiBuyHigh
rsiTrendShort = rsiVal <= rsiSellHigh and rsiVal >= rsiSellLow
bullCandle = close > open and close > close[1]
bearCandle = close < open and close < close[1]
macdLongOk  = not useMacd or (macdHist > 0 and macdHist > macdHist[1])
macdShortOk = not useMacd or (macdHist < 0 and macdHist < macdHist[1])
slopeLongOk  = not useSlope or emaSlopeUp
slopeShortOk = not useSlope or emaSlopeDown

tScoreL = 0
tScoreL += bullTrend ? 1 : 0
tScoreL += pullbackLong ? 1 : 0
tScoreL += rsiTrendLong ? 1 : 0
tScoreL += volOk ? 1 : 0
tScoreL += (useMtf and htf1Bull) ? 1 : (useMtf ? 0 : 1)
tScoreL += (useMtf and useHtf2 and htf2Bull) ? 1 : ((useMtf and useHtf2) ? 0 : 1)
tScoreL += trendAdxOk ? 1 : 0
tScoreL += (useMacd and macdLongOk) ? 1 : (useMacd ? 0 : 1)

tScoreS = 0
tScoreS += bearTrend ? 1 : 0
tScoreS += pullbackShort ? 1 : 0
tScoreS += rsiTrendShort ? 1 : 0
tScoreS += volOk ? 1 : 0
tScoreS += (useMtf and htf1Bear) ? 1 : (useMtf ? 0 : 1)
tScoreS += (useMtf and useHtf2 and htf2Bear) ? 1 : ((useMtf and useHtf2) ? 0 : 1)
tScoreS += trendAdxOk ? 1 : 0
tScoreS += (useMacd and macdShortOk) ? 1 : (useMacd ? 0 : 1)

trendLongRaw  = enableTrend and allowLong and sessionOk and slopeLongOk and bullCandle and pullbackLong and bullTrend and mtfLongOk and tScoreL >= minScore
trendShortRaw = enableTrend and allowShort and sessionOk and slopeShortOk and bearCandle and pullbackShort and bearTrend and mtfShortOk and tScoreS >= minScore

var int lastTrendLong = na
var int lastTrendShort = na
trendLongFire  = trendLongRaw  and (na(lastTrendLong)  or bar_index - lastTrendLong  >= cooldownBars)
trendShortFire = trendShortRaw and (na(lastTrendShort) or bar_index - lastTrendShort >= cooldownBars)
if trendLongFire
    lastTrendLong := bar_index
if trendShortFire
    lastTrendShort := bar_index

// ═══════════════════════════════════════════════════════════
// 盤整模型訊號（均值回歸 · 多空雙吃）
// ═══════════════════════════════════════════════════════════
touchLower = low <= rangeLower * 1.001 or low <= bbLower * 1.001
touchUpper = high >= rangeUpper * 0.999 or high >= bbUpper * 0.999
rejectLow  = close > open and close > low + (high - low) * 0.55 and close >= rangeLower
rejectHigh = close < open and close < high - (high - low) * 0.55 and close <= rangeUpper
closeInside = close >= rangeLower and close <= rangeUpper
noBreakout  = not blockBreakout or closeInside
stochLongOk  = not useStochFilter or (smoothK <= stochBuy and smoothK >= smoothD)
stochShortOk = not useStochFilter or (smoothK >= stochSell and smoothK <= smoothD)
rsiRangeLong  = rsiVal <= rangeRsiBuy
rsiRangeShort = rsiVal >= rangeRsiSell
rejectLongOk  = not requireReject or rejectLow
rejectShortOk = not requireReject or rejectHigh
closeInLongOk  = not requireCloseIn or close >= rangeLower
closeInShortOk = not requireCloseIn or close <= rangeUpper

// 盤整進場分數（7項）
rScoreL = 0
rScoreL += touchLower ? 1 : 0
rScoreL += rsiRangeLong ? 1 : 0
rScoreL += rejectLongOk ? 1 : 0
rScoreL += widthOk ? 1 : 0
rScoreL += stochLongOk ? 1 : 0
rScoreL += volOk ? 1 : 0
rScoreL += closeInLongOk and noBreakout ? 1 : 0

rScoreS = 0
rScoreS += touchUpper ? 1 : 0
rScoreS += rsiRangeShort ? 1 : 0
rScoreS += rejectShortOk ? 1 : 0
rScoreS += widthOk ? 1 : 0
rScoreS += stochShortOk ? 1 : 0
rScoreS += volOk ? 1 : 0
rScoreS += closeInShortOk and noBreakout ? 1 : 0

rangeLongRaw  = enableRange and allowLong and sessionOk and touchLower and rsiRangeLong and rejectLongOk and closeInLongOk and noBreakout and widthOk and volOk and stochLongOk and rScoreL >= minRangeScore
rangeShortRaw = enableRange and allowShort and sessionOk and touchUpper and rsiRangeShort and rejectShortOk and closeInShortOk and noBreakout and widthOk and volOk and stochShortOk and rScoreS >= minRangeScore

var int lastRangeLong = na
var int lastRangeShort = na
rangeLongFire  = rangeLongRaw  and (na(lastRangeLong)  or bar_index - lastRangeLong  >= rangeCooldown)
rangeShortFire = rangeShortRaw and (na(lastRangeShort) or bar_index - lastRangeShort >= rangeCooldown)
if rangeLongFire
    lastRangeLong := bar_index
if rangeShortFire
    lastRangeShort := bar_index

// 風控價位
trendLongSL  = close - atrVal * slAtrMult
trendLongTP1 = close + atrVal * tp1AtrMult
trendLongTP2 = close + atrVal * tp2AtrMult
trendShortSL  = close + atrVal * slAtrMult
trendShortTP1 = close - atrVal * tp1AtrMult
trendShortTP2 = close - atrVal * tp2AtrMult

rangeLongSL  = math.min(low, rangeLower) - atrVal * rangeSlBufAtr
rangeLongTP1 = useMidTp ? rangeMid : close + atrVal * 1.0
rangeLongTP2 = rangeTp2Opp ? rangeUpper : close + atrVal * 2.0
rangeShortSL  = math.max(high, rangeUpper) + atrVal * rangeSlBufAtr
rangeShortTP1 = useMidTp ? rangeMid : close - atrVal * 1.0
rangeShortTP2 = rangeTp2Opp ? rangeLower : close - atrVal * 2.0

// ═══════════════════════════════════════════════════════════
// 繪圖
// ═══════════════════════════════════════════════════════════
plot(emaFast, "快線EMA", color=color.new(#2E7D32, 0), linewidth=2)
plot(emaSlow, "慢線EMA", color=color.new(#C62828, 0), linewidth=2)
plot(emaBias, "方向EMA", color=color.new(#546E7A, 35), linewidth=2)
pUpper = plot(showBands ? rangeUpper : na, "盤整上軌", color=color.new(#FF8F00, 0), linewidth=1)
pLower = plot(showBands ? rangeLower : na, "盤整下軌", color=color.new(#FF8F00, 0), linewidth=1)
plot(showBands ? rangeMid : na, "盤整中軌", color=color.new(#FF8F00, 50), linewidth=1, style=plot.style_stepline)
fill(pUpper, pLower, color=showBands and isRanging ? color.new(#FF8F00, 92) : na, title="盤整通道")

plotshape(trendLongFire,  title="趨勢多", style=shape.triangleup,   location=location.belowbar, color=color.new(#00C853, 0), size=size.small, text="趨多")
plotshape(trendShortFire, title="趨勢空", style=shape.triangledown, location=location.abovebar, color=color.new(#FF1744, 0), size=size.small, text="趨空")
plotshape(rangeLongFire,  title="盤整多", style=shape.circle, location=location.belowbar, color=color.new(#FFB300, 0), size=size.small, text="盤多")
plotshape(rangeShortFire, title="盤整空", style=shape.circle, location=location.abovebar, color=color.new(#FF6D00, 0), size=size.small, text="盤空")

bgcolor(showBg ? (isRanging ? color.new(#FF8F00, 94) : isTrending and bullTrend ? color.new(#1B5E20, 94) : isTrending and bearTrend ? color.new(#B71C1C, 94) : color.new(#546E7A, 94)) : na)

if showLevels and trendLongFire
    label.new(bar_index, low, "趨多\n停損 " + str.tostring(trendLongSL, format.mintick) + "\nTP1 " + str.tostring(trendLongTP1, format.mintick) + "\nTP2 " + str.tostring(trendLongTP2, format.mintick), style=label.style_label_up, color=color.new(#00C853, 15), textcolor=color.white, size=size.tiny)
if showLevels and trendShortFire
    label.new(bar_index, high, "趨空\n停損 " + str.tostring(trendShortSL, format.mintick) + "\nTP1 " + str.tostring(trendShortTP1, format.mintick) + "\nTP2 " + str.tostring(trendShortTP2, format.mintick), style=label.style_label_down, color=color.new(#FF1744, 15), textcolor=color.white, size=size.tiny)
if showLevels and rangeLongFire
    label.new(bar_index, low, "盤多\n停損 " + str.tostring(rangeLongSL, format.mintick) + "\n中軌 " + str.tostring(rangeLongTP1, format.mintick) + "\n上軌 " + str.tostring(rangeLongTP2, format.mintick) + "\n分 " + str.tostring(rScoreL), style=label.style_label_up, color=color.new(#FF8F00, 10), textcolor=color.white, size=size.tiny)
if showLevels and rangeShortFire
    label.new(bar_index, high, "盤空\n停損 " + str.tostring(rangeShortSL, format.mintick) + "\n中軌 " + str.tostring(rangeShortTP1, format.mintick) + "\n下軌 " + str.tostring(rangeShortTP2, format.mintick) + "\n分 " + str.tostring(rScoreS), style=label.style_label_down, color=color.new(#E65100, 10), textcolor=color.white, size=size.tiny)

alertcondition(trendLongFire,  title="趨勢做多", message="黃金MMM 趨勢做多 | {{ticker}} @ {{close}}")
alertcondition(trendShortFire, title="趨勢做空", message="黃金MMM 趨勢做空 | {{ticker}} @ {{close}}")
alertcondition(rangeLongFire,  title="盤整做多", message="黃金MMM 盤整做多 | {{ticker}} @ {{close}}")
alertcondition(rangeShortFire, title="盤整做空", message="黃金MMM 盤整做空 | {{ticker}} @ {{close}}")
alertcondition(trendLongFire or trendShortFire or rangeLongFire or rangeShortFire, title="任一進場", message="黃金MMM 進場 | {{ticker}} @ {{close}}")

// ═══════════════════════════════════════════════════════════
// 趨勢面板
// ═══════════════════════════════════════════════════════════
var table trendDash = na
var string trendPosPrev = na
if showTrendDash
    if na(trendDash) or trendPosPrev != trendDashPos
        if not na(trendDash)
            table.delete(trendDash)
        trendDash := table.new(f_panelPos(trendDashPos), 2, 9, bgcolor=color.new(#102027, 10), border_width=1)
        trendPosPrev := trendDashPos
    if barstate.islast
        table.cell(trendDash, 0, 0, "趨勢模型", text_color=color.white, text_size=size.small)
        table.cell(trendDash, 1, 0, activeModel, text_color=activeModel == "趨勢" ? color.lime : color.gray, text_size=size.small)
        table.cell(trendDash, 0, 1, "方向", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 1, bullTrend ? "多頭" : bearTrend ? "空頭" : "中性", text_color=bullTrend ? color.lime : bearTrend ? color.red : color.orange, text_size=size.small)
        table.cell(trendDash, 0, 2, "環境", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 2, enableTrend ? "可做趨勢" : "停用", text_color=enableTrend ? color.lime : color.gray, text_size=size.small)
        table.cell(trendDash, 0, 3, "高週期", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 3, not useMtf ? "關" : (htf1Bull ? "多" : "空") + "/" + (not useHtf2 ? "-" : htf2Bull ? "多" : "空"), text_color=color.white, text_size=size.small)
        table.cell(trendDash, 0, 4, "ADX/CHOP", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 4, str.tostring(adxVal, "#.0") + "/" + str.tostring(chopVal, "#.0"), text_color=color.white, text_size=size.small)
        table.cell(trendDash, 0, 5, "時段", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 5, sessionOk ? sessionName : sessionName + "·休", text_color=sessionOk ? color.lime : color.red, text_size=size.small)
        table.cell(trendDash, 0, 6, "多分/空分", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 6, str.tostring(tScoreL) + " / " + str.tostring(tScoreS), text_color=color.white, text_size=size.small)
        table.cell(trendDash, 0, 7, "狀態", text_color=color.gray, text_size=size.small)
        tReady = trendLongFire ? "趨多" : trendShortFire ? "趨空" : enableTrend ? "等待" : "—"
        table.cell(trendDash, 1, 7, tReady, text_color=trendLongFire ? color.lime : trendShortFire ? color.red : color.gray, text_size=size.small)
        table.cell(trendDash, 0, 8, "模式", text_color=color.gray, text_size=size.small)
        table.cell(trendDash, 1, 8, modelMode, text_color=color.aqua, text_size=size.small)
else if not na(trendDash)
    table.delete(trendDash)
    trendDash := na
    trendPosPrev := na

// ═══════════════════════════════════════════════════════════
// 盤整模型專屬面板 — 條件清單 + 過濾狀態
// ═══════════════════════════════════════════════════════════
fOk(cond) => cond ? "✓" : "✗"
fCol(cond) => cond ? color.lime : color.red

var table rangeDash = na
var string rangePosPrev = na
if showRangeDash
    if na(rangeDash) or rangePosPrev != rangeDashPos
        if not na(rangeDash)
            table.delete(rangeDash)
        rangeDash := table.new(f_panelPos(rangeDashPos), 2, 16, bgcolor=color.new(#3E2723, 8), border_width=1)
        rangePosPrev := rangeDashPos
    if barstate.islast
        table.cell(rangeDash, 0, 0, "盤整模型面板", text_color=color.white, text_size=size.small)
        table.cell(rangeDash, 1, 0, enableRange ? "啟用中" : "待機", text_color=enableRange ? color.lime : color.gray, text_size=size.small)

        table.cell(rangeDash, 0, 1, "— 環境過濾 —", text_color=color.orange, text_size=size.small)
        table.cell(rangeDash, 1, 1, str.tostring(rangeConfirmScore) + "/4", text_color=rangeEnvOk ? color.lime : color.orange, text_size=size.small)

        table.cell(rangeDash, 0, 2, "ADX≤" + str.tostring(adxMaxRange, "#"), text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 2, fOk(rngCondAdx) + " " + str.tostring(adxVal, "#.0"), text_color=fCol(rngCondAdx), text_size=size.small)

        table.cell(rangeDash, 0, 3, "CHOP≥" + str.tostring(chopMinRange, "#"), text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 3, fOk(rngCondChop) + " " + str.tostring(chopVal, "#.0"), text_color=fCol(rngCondChop), text_size=size.small)

        table.cell(rangeDash, 0, 4, "均線糾結", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 4, fOk(rngCondGap) + " " + str.tostring(emaGapAtr, "#.2"), text_color=fCol(rngCondGap), text_size=size.small)

        table.cell(rangeDash, 0, 5, "效率比低", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 5, fOk(rngCondEr) + " " + str.tostring(erVal, "#.2"), text_color=fCol(rngCondEr), text_size=size.small)

        table.cell(rangeDash, 0, 6, "通道寬度", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 6, fOk(widthOk) + " " + str.tostring(rangeWidthAtr, "#.1") + "ATR", text_color=fCol(widthOk), text_size=size.small)

        table.cell(rangeDash, 0, 7, "時段/波動", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 7, fOk(sessionOk) + "/" + fOk(volOk) + " " + sessionName, text_color=sessionOk and volOk ? color.lime : color.red, text_size=size.small)

        table.cell(rangeDash, 0, 8, "— 做多條件 —", text_color=color.orange, text_size=size.small)
        table.cell(rangeDash, 1, 8, str.tostring(rScoreL) + "/7", text_color=rScoreL >= minRangeScore ? color.lime : color.orange, text_size=size.small)

        table.cell(rangeDash, 0, 9, "觸下軌", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 9, fOk(touchLower), text_color=fCol(touchLower), text_size=size.small)

        table.cell(rangeDash, 0, 10, "RSI超賣/拒絕K", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 10, fOk(rsiRangeLong) + "/" + fOk(rejectLongOk) + " " + str.tostring(rsiVal, "#.0"), text_color=rsiRangeLong and rejectLongOk ? color.lime : color.red, text_size=size.small)

        table.cell(rangeDash, 0, 11, "Stoch/回通道", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 11, fOk(stochLongOk) + "/" + fOk(closeInLongOk and noBreakout), text_color=stochLongOk and closeInLongOk and noBreakout ? color.lime : color.red, text_size=size.small)

        table.cell(rangeDash, 0, 12, "— 做空條件 —", text_color=color.orange, text_size=size.small)
        table.cell(rangeDash, 1, 12, str.tostring(rScoreS) + "/7", text_color=rScoreS >= minRangeScore ? color.lime : color.orange, text_size=size.small)

        table.cell(rangeDash, 0, 13, "觸上軌", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 13, fOk(touchUpper), text_color=fCol(touchUpper), text_size=size.small)

        table.cell(rangeDash, 0, 14, "RSI超買/拒絕K", text_color=color.gray, text_size=size.small)
        table.cell(rangeDash, 1, 14, fOk(rsiRangeShort) + "/" + fOk(rejectShortOk) + " " + str.tostring(rsiVal, "#.0"), text_color=rsiRangeShort and rejectShortOk ? color.lime : color.red, text_size=size.small)

        table.cell(rangeDash, 0, 15, "盤整狀態", text_color=color.gray, text_size=size.small)
        rReady = rangeLongFire ? "盤多進場" : rangeShortFire ? "盤空進場" : enableRange ? "等待觸軌" : "非盤整"
        table.cell(rangeDash, 1, 15, rReady, text_color=rangeLongFire ? color.lime : rangeShortFire ? color.red : enableRange ? color.orange : color.gray, text_size=size.small)
else if not na(rangeDash)
    table.delete(rangeDash)
    rangeDash := na
    rangePosPrev := na
