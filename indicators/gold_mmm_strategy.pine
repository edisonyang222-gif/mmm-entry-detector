//
// 黃金 MMM 策略：趨勢共振 + 盤整均值回歸（多空雙吃）

//@version=5
strategy("黃金MMM策略", shorttitle="黃金MMM策略", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=5,
     commission_type=strategy.commission.percent, commission_value=0.02,
     slippage=2, pyramiding=0, calc_on_every_tick=false)

grpMode = "① 模式"
modelMode = input.string("自動切換", "模型模式", options=["自動切換", "只做趨勢", "只做盤整"], group=grpMode)
tradeMode = input.string("多空皆可", "交易方向", options=["多空皆可", "只做多", "只做空"], group=grpMode)

emaFastLen = input.int(20, "快線", group="② 趨勢")
emaSlowLen = input.int(50, "慢線", group="② 趨勢")
emaBiasLen = input.int(100, "方向線", group="② 趨勢")
rsiLen = input.int(14, "RSI", group="② 趨勢")
useMtf = input.bool(true, "高週期共振", group="② 趨勢")
htf1 = input.timeframe("240", "HTF1", group="② 趨勢")
htf2 = input.timeframe("D", "HTF2", group="② 趨勢")
minScore = input.int(5, "趨勢分數", group="② 趨勢")
slAtrMult = input.float(2.0, "趨勢SL", group="② 趨勢")
tp1AtrMult = input.float(3.0, "趨勢TP1", group="② 趨勢")
tp2AtrMult = input.float(5.0, "趨勢TP2", group="② 趨勢")
cooldownBars = input.int(8, "趨勢冷卻", group="② 趨勢")

adxLen = input.int(14, "ADX", group="③ 盤整判定")
chopLen = input.int(14, "CHOP", group="③ 盤整判定")
erLen = input.int(10, "ER", group="③ 盤整判定")
adxMinTrend = input.float(18.0, "趨勢最低ADX", group="③ 盤整判定")
chopMaxTrend = input.float(65.0, "趨勢最高CHOP", group="③ 盤整判定")
emaGapMinAtr = input.float(0.25, "趨勢最小間距", group="③ 盤整判定")
erMinTrend = input.float(0.18, "趨勢最低ER", group="③ 盤整判定")
adxMaxRange = input.float(22.0, "盤整最高ADX", group="③ 盤整判定")
chopMinRange = input.float(55.0, "盤整最低CHOP", group="③ 盤整判定")
emaGapMaxAtr = input.float(0.55, "盤整最大間距", group="③ 盤整判定")
erMaxRange = input.float(0.30, "盤整最高ER", group="③ 盤整判定")
minRangeConfirm = input.int(2, "盤整確認數", group="③ 盤整判定")

bbLen = input.int(20, "布林", group="④ 盤整入場")
bbMult = input.float(2.0, "布林倍", group="④ 盤整入場")
donLen = input.int(20, "唐奇安", group="④ 盤整入場")
rangeRsiBuy = input.int(35, "盤多RSI≤", group="④ 盤整入場")
rangeRsiSell = input.int(65, "盤空RSI≥", group="④ 盤整入場")
minRangeWidthAtr = input.float(1.2, "最小通道寬", group="④ 盤整入場")
maxRangeWidthAtr = input.float(6.0, "最大通道寬", group="④ 盤整入場")
minRangeScore = input.int(4, "盤整分數", group="④ 盤整入場")
rangeCooldown = input.int(6, "盤整冷卻", group="④ 盤整入場")
rangeSlBufAtr = input.float(0.25, "盤整SL緩衝", group="④ 盤整入場")

atrLen = input.int(14, "ATR", group="⑤ 共用")
atrMaLen = input.int(50, "ATR均", group="⑤ 共用")
minAtrMult = input.float(0.6, "ATR下限", group="⑤ 共用")
maxAtrMult = input.float(2.5, "ATR上限", group="⑤ 共用")
useSession = input.bool(true, "時段過濾", group="⑤ 共用")
tz = input.string("Asia/Taipei", "時區", options=["Asia/Taipei", "UTC"], group="⑤ 共用")
tradeAsia = input.bool(false, "亞盤", group="⑤ 共用")
tradeLondon = input.bool(true, "倫敦", group="⑤ 共用")
tradeNy = input.bool(true, "美盤", group="⑤ 共用")
asiaSess = input.session("0700-1400", "亞盤", group="⑤ 共用")
londonSess = input.session("1500-2330", "倫敦", group="⑤ 共用")
nySess = input.session("2130-0400", "美盤", group="⑤ 共用")

emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
emaBias = ta.ema(close, emaBiasLen)
rsiVal = ta.rsi(close, rsiLen)
atrVal = ta.atr(atrLen)
atrMa = ta.sma(atrVal, atrMaLen)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)

basis = ta.sma(close, bbLen)
dev = bbMult * ta.stdev(close, bbLen)
bbUpper = basis + dev
bbLower = basis - dev
donHigh = ta.highest(high, donLen)
donLow = ta.lowest(low, donLen)
rangeUpper = math.min(bbUpper, donHigh)
rangeLower = math.max(bbLower, donLow)
rangeMid = (rangeUpper + rangeLower) / 2
rangeWidthAtr = atrVal > 0 ? (rangeUpper - rangeLower) / atrVal : 0.0

atrSumChop = math.sum(ta.tr(true), chopLen)
chopVal = (ta.highest(high, chopLen) - ta.lowest(low, chopLen)) > 0 ? 100 * math.log10(atrSumChop / (ta.highest(high, chopLen) - ta.lowest(low, chopLen))) / math.log10(chopLen) : 100.0
emaGapAtr = atrVal > 0 ? math.abs(emaFast - emaSlow) / atrVal : 0.0
erPath = math.sum(math.abs(close - close[1]), erLen)
erVal = erPath > 0 ? math.abs(close - close[erLen]) / erPath : 0.0

trendEnvOk = adxVal >= adxMinTrend and chopVal <= chopMaxTrend and emaGapAtr >= emaGapMinAtr and erVal >= erMinTrend
rangeConfirmScore = (adxVal <= adxMaxRange ? 1 : 0) + (chopVal >= chopMinRange ? 1 : 0) + (emaGapAtr <= emaGapMaxAtr ? 1 : 0) + (erVal <= erMaxRange ? 1 : 0)
widthOk = rangeWidthAtr >= minRangeWidthAtr and rangeWidthAtr <= maxRangeWidthAtr
rangeEnvOk = rangeConfirmScore >= minRangeConfirm and widthOk
enableTrend = modelMode == "只做趨勢" or (modelMode == "自動切換" and trendEnvOk and not rangeEnvOk)
enableRange = modelMode == "只做盤整" or (modelMode == "自動切換" and rangeEnvOk)

volOk = atrMa > 0 and atrVal / atrMa >= minAtrMult and atrVal / atrMa <= maxAtrMult
inAsia = not na(time(timeframe.period, asiaSess, tz))
inLondon = not na(time(timeframe.period, londonSess, tz))
inNY = not na(time(timeframe.period, nySess, tz))
sessionOk = not useSession or ((tradeAsia and inAsia) or (tradeLondon and inLondon) or (tradeNy and inNY))
allowLong = tradeMode != "只做空"
allowShort = tradeMode != "只做多"

bullTrend = emaFast > emaSlow and close > emaBias
bearTrend = emaFast < emaSlow and close < emaBias
htf1Bull = request.security(syminfo.tickerid, htf1, close > ta.ema(close, 50), lookahead=barmerge.lookahead_off)
htf2Bull = request.security(syminfo.tickerid, htf2, close > ta.ema(close, 50), lookahead=barmerge.lookahead_off)
htf1Bear = not htf1Bull
htf2Bear = not htf2Bull
pullL = low <= emaFast * 1.001 and close > emaFast
pullS = high >= emaFast * 0.999 and close < emaFast
bullC = close > open and close > close[1]
bearC = close < open and close < close[1]

tScoreL = (bullTrend ? 1 : 0) + (pullL ? 1 : 0) + (rsiVal >= 35 and rsiVal <= 55 ? 1 : 0) + (volOk ? 1 : 0) + ((not useMtf or htf1Bull) ? 1 : 0) + ((not useMtf or htf2Bull) ? 1 : 0) + (adxVal >= adxMinTrend ? 1 : 0) + (macdHist > 0 ? 1 : 0)
tScoreS = (bearTrend ? 1 : 0) + (pullS ? 1 : 0) + (rsiVal <= 65 and rsiVal >= 45 ? 1 : 0) + (volOk ? 1 : 0) + ((not useMtf or htf1Bear) ? 1 : 0) + ((not useMtf or htf2Bear) ? 1 : 0) + (adxVal >= adxMinTrend ? 1 : 0) + (macdHist < 0 ? 1 : 0)

var int lastTL = na
var int lastTS = na
trendLong = enableTrend and allowLong and sessionOk and bullC and pullL and bullTrend and (not useMtf or (htf1Bull and htf2Bull)) and tScoreL >= minScore and (na(lastTL) or bar_index - lastTL >= cooldownBars)
trendShort = enableTrend and allowShort and sessionOk and bearC and pullS and bearTrend and (not useMtf or (htf1Bear and htf2Bear)) and tScoreS >= minScore and (na(lastTS) or bar_index - lastTS >= cooldownBars)
if trendLong
    lastTL := bar_index
if trendShort
    lastTS := bar_index

touchL = low <= rangeLower * 1.001
touchU = high >= rangeUpper * 0.999
rejectL = close > open and close >= rangeLower
rejectS = close < open and close <= rangeUpper
closeIn = close >= rangeLower and close <= rangeUpper
rScoreL = (touchL ? 1 : 0) + (rsiVal <= rangeRsiBuy ? 1 : 0) + (rejectL ? 1 : 0) + (widthOk ? 1 : 0) + (volOk ? 1 : 0) + (closeIn ? 1 : 0) + 1
rScoreS = (touchU ? 1 : 0) + (rsiVal >= rangeRsiSell ? 1 : 0) + (rejectS ? 1 : 0) + (widthOk ? 1 : 0) + (volOk ? 1 : 0) + (closeIn ? 1 : 0) + 1

var int lastRL = na
var int lastRS = na
rangeLong = enableRange and allowLong and sessionOk and touchL and rsiVal <= rangeRsiBuy and rejectL and closeIn and widthOk and volOk and rScoreL >= minRangeScore and (na(lastRL) or bar_index - lastRL >= rangeCooldown)
rangeShort = enableRange and allowShort and sessionOk and touchU and rsiVal >= rangeRsiSell and rejectS and closeIn and widthOk and volOk and rScoreS >= minRangeScore and (na(lastRS) or bar_index - lastRS >= rangeCooldown)
if rangeLong
    lastRL := bar_index
if rangeShort
    lastRS := bar_index

plot(emaFast, color=color.new(#2E7D32, 0))
plot(emaSlow, color=color.new(#C62828, 0))
plot(rangeUpper, color=color.new(#FF8F00, 0))
plot(rangeLower, color=color.new(#FF8F00, 0))
plot(rangeMid, color=color.new(#FF8F00, 50), style=plot.style_stepline)
plotshape(trendLong, style=shape.triangleup, location=location.belowbar, color=color.lime, text="趨多")
plotshape(trendShort, style=shape.triangledown, location=location.abovebar, color=color.red, text="趨空")
plotshape(rangeLong, style=shape.circle, location=location.belowbar, color=color.orange, text="盤多")
plotshape(rangeShort, style=shape.circle, location=location.abovebar, color=#FF6D00, text="盤空")

if trendLong
    strategy.entry("趨多", strategy.long)
    strategy.exit("趨多出", from_entry="趨多", qty_percent=50, stop=close - atrVal * slAtrMult, limit=close + atrVal * tp1AtrMult)
    strategy.exit("趨多出2", from_entry="趨多", stop=close - atrVal * slAtrMult, limit=close + atrVal * tp2AtrMult)
if trendShort
    strategy.entry("趨空", strategy.short)
    strategy.exit("趨空出", from_entry="趨空", qty_percent=50, stop=close + atrVal * slAtrMult, limit=close - atrVal * tp1AtrMult)
    strategy.exit("趨空出2", from_entry="趨空", stop=close + atrVal * slAtrMult, limit=close - atrVal * tp2AtrMult)

if rangeLong
    strategy.entry("盤多", strategy.long)
    strategy.exit("盤多出", from_entry="盤多", qty_percent=50, stop=math.min(low, rangeLower) - atrVal * rangeSlBufAtr, limit=rangeMid)
    strategy.exit("盤多出2", from_entry="盤多", stop=math.min(low, rangeLower) - atrVal * rangeSlBufAtr, limit=rangeUpper)
if rangeShort
    strategy.entry("盤空", strategy.short)
    strategy.exit("盤空出", from_entry="盤空", qty_percent=50, stop=math.max(high, rangeUpper) + atrVal * rangeSlBufAtr, limit=rangeMid)
    strategy.exit("盤空出2", from_entry="盤空", stop=math.max(high, rangeUpper) + atrVal * rangeSlBufAtr, limit=rangeLower)

if strategy.position_size > 0 and bearTrend and enableTrend
    strategy.close("趨多", comment="趨勢翻轉")
if strategy.position_size < 0 and bullTrend and enableTrend
    strategy.close("趨空", comment="趨勢翻轉")
if strategy.position_size > 0 and not rangeEnvOk and strategy.opentrades.entry_id(strategy.opentrades - 1) == "盤多"
    strategy.close("盤多", comment="離開盤整")
if strategy.position_size < 0 and not rangeEnvOk and strategy.opentrades.entry_id(strategy.opentrades - 1) == "盤空"
    strategy.close("盤空", comment="離開盤整")
