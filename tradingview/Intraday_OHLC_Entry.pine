//@version=6
indicator("Intraday OHLC Entry", overlay=true, max_labels_count=500, max_lines_count=500)

// --- Inputs ---
mode          = input.string("ALL", "Mode", options=["BREAKOUT", "REJECTION", "OPEN", "ALL"])
sessionHour   = input.int(4, "交易日開始：時", minval=0, maxval=23)
sessionMinute = input.int(45, "交易日開始：分", minval=0, maxval=59)
orbBars       = input.int(4, "Opening range bars", minval=1)
atrLen        = input.int(14, "ATR period")
touchTolAtr   = input.float(0.05, "Touch tolerance (ATR)", step=0.01)
minBreakAtr   = input.float(0.02, "Min break (ATR)", step=0.01)
rejectBody    = input.float(0.45, "Rejection body/range", step=0.05)
stopAtrMult   = input.float(0.8, "Stop ATR mult", step=0.1)
minRR         = input.float(1.5, "Min RR", step=0.1)
tpRR          = input.float(2.0, "TP RR", step=0.1)
useLevelTP    = input.bool(true, "Prefer OHLC level TP")
onePerDay     = input.bool(true, "One signal per day per side")
showBuy       = input.bool(true, "Show buy")
showSell      = input.bool(true, "Show sell")
showLevels    = input.bool(true, "顯示 PDH/PDL 等價格線")
showSessionV  = input.bool(true, "每天開始畫黃色虛線（垂直）")
showLevelLbl  = input.bool(true, "價格線標籤")

enableBO  = mode == "BREAKOUT" or mode == "ALL"
enableREJ = mode == "REJECTION" or mode == "ALL"
enableOPN = mode == "OPEN" or mode == "ALL"
enableORB = mode == "BREAKOUT" or mode == "ALL"

atr = ta.atr(atrLen)

//══ 交易日：預設每天 04:45 起算 ══
sessToday = timestamp(year, month, dayofmonth, sessionHour, sessionMinute)
sessKey   = time >= sessToday ? sessToday : sessToday - 86400000
newDay    = nz(ta.change(sessKey), 0) != 0

var float pdh = na
var float pdl = na
var float pdo = na
var float pdc = na
var float dayOpen = na
var float dayHigh = na
var float dayLow = na
var float orbHigh = na
var float orbLow = na
var int   barsInDay = 0
var bool  orbReady = false
var int   lastBuyDay = -1
var int   lastSellDay = -1

// 當日水平價格線（連續，非中斷 plot）
var line lnPdh = na
var line lnPdl = na
var line lnMid = na
var line lnDo  = na
var line lnOrh = na
var line lnOrl = na
var line lnPdc = na
var label lbPdh = na
var label lbPdl = na
var label lbDo  = na
var int   sessStartTime = na

f_endPrevLines() =>
    int tPrev = time[1]
    if not na(lnPdh)
        line.set_x2(lnPdh, tPrev)
    if not na(lnPdl)
        line.set_x2(lnPdl, tPrev)
    if not na(lnMid)
        line.set_x2(lnMid, tPrev)
    if not na(lnDo)
        line.set_x2(lnDo, tPrev)
    if not na(lnOrh)
        line.set_x2(lnOrh, tPrev)
    if not na(lnOrl)
        line.set_x2(lnOrl, tPrev)
    if not na(lnPdc)
        line.set_x2(lnPdc, tPrev)

f_newHLine(float price, color col, int w) =>
    line.new(time, price, time, price, xloc=xloc.bar_time, extend=extend.none, color=col, style=line.style_solid, width=w)

if newDay
    // 結束前一日水平線到昨日最後一根
    f_endPrevLines()
    sessStartTime := time

    // 滾動前一日 OHLC → 今日 PDH/PDL…
    pdh := dayHigh
    pdl := dayLow
    pdo := dayOpen
    pdc := close[1]
    dayOpen := open
    dayHigh := high
    dayLow := low
    orbHigh := high
    orbLow := low
    barsInDay := 1
    orbReady := orbBars <= 1

    // 黃色虛線垂直分隔（每日 04:45）— 時間錨點
    if showSessionV
        line.new(time, low, time, high, xloc=xloc.bar_time, extend=extend.both, color=color.yellow, style=line.style_dashed, width=1)

    // 從本日開始畫水平價格線（到當日結束會一直延長）
    if showLevels and not na(pdh) and not na(pdl)
        float mid0 = (pdh + pdl) * 0.5
        lnPdh := f_newHLine(pdh, color.teal, 2)
        lnPdl := f_newHLine(pdl, color.maroon, 2)
        lnMid := f_newHLine(mid0, color.gray, 1)
        lnPdc := f_newHLine(pdc, color.silver, 1)
        lnDo  := f_newHLine(dayOpen, color.orange, 2)
        if orbReady
            lnOrh := f_newHLine(orbHigh, color.aqua, 1)
            lnOrl := f_newHLine(orbLow, color.fuchsia, 1)
        else
            lnOrh := na
            lnOrl := na
        if showLevelLbl
            // 標籤錨在當日 04:45 起點，拖移圖表跟著 K 線走
            lbPdh := label.new(time, pdh, "R " + str.tostring(pdh, format.mintick), xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.maroon, 70), textcolor=color.maroon, size=size.small)
            lbPdl := label.new(time, pdl, "S " + str.tostring(pdl, format.mintick), xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.teal, 70), textcolor=color.teal, size=size.small)
            lbDo  := label.new(time, dayOpen, "Open " + str.tostring(dayOpen, format.mintick), xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.orange, 70), textcolor=color.orange, size=size.small)
else
    dayHigh := math.max(nz(dayHigh, high), high)
    dayLow := math.min(nz(dayLow, low), low)
    barsInDay += 1
    if not orbReady
        orbHigh := math.max(nz(orbHigh, high), high)
        orbLow := math.min(nz(orbLow, low), low)
        if barsInDay >= orbBars
            orbReady := true
            if showLevels
                int t0 = not na(lnDo) ? int(line.get_x1(lnDo)) : nz(sessStartTime, time)
                lnOrh := line.new(t0, orbHigh, time, orbHigh, xloc=xloc.bar_time, extend=extend.none, color=color.aqua, style=line.style_solid, width=1)
                lnOrl := line.new(t0, orbLow, time, orbLow, xloc=xloc.bar_time, extend=extend.none, color=color.fuchsia, style=line.style_solid, width=1)

// 當日水平線延長到目前K（連續價格線；x 用 bar_time）
if showLevels
    if not na(lnPdh)
        line.set_x2(lnPdh, time)
        line.set_y1(lnPdh, pdh)
        line.set_y2(lnPdh, pdh)
    if not na(lnPdl)
        line.set_x2(lnPdl, time)
        line.set_y1(lnPdl, pdl)
        line.set_y2(lnPdl, pdl)
    if not na(lnMid) and not na(pdh) and not na(pdl)
        float midNow = (pdh + pdl) * 0.5
        line.set_x2(lnMid, time)
        line.set_y1(lnMid, midNow)
        line.set_y2(lnMid, midNow)
    if not na(lnPdc)
        line.set_x2(lnPdc, time)
        line.set_y1(lnPdc, pdc)
        line.set_y2(lnPdc, pdc)
    if not na(lnDo)
        line.set_x2(lnDo, time)
        line.set_y1(lnDo, dayOpen)
        line.set_y2(lnDo, dayOpen)
    if not na(lnOrh)
        line.set_x2(lnOrh, time)
        line.set_y1(lnOrh, orbHigh)
        line.set_y2(lnOrh, orbHigh)
    if not na(lnOrl)
        line.set_x2(lnOrl, time)
        line.set_y1(lnOrl, orbLow)
        line.set_y2(lnOrl, orbLow)
    // 標籤固定在當日起點時間，只更新文字/價格（跟著那根 K 移動）
    if showLevelLbl and not na(lbPdh)
        label.set_y(lbPdh, pdh)
        label.set_text(lbPdh, "R " + str.tostring(pdh, format.mintick))
    if showLevelLbl and not na(lbPdl)
        label.set_y(lbPdl, pdl)
        label.set_text(lbPdl, "S " + str.tostring(pdl, format.mintick))
    if showLevelLbl and not na(lbDo)
        label.set_y(lbDo, dayOpen)
        label.set_text(lbDo, "Open " + str.tostring(dayOpen, format.mintick))

float mid = not na(pdh) and not na(pdl) ? (pdh + pdl) * 0.5 : na
levelsReady = not na(pdh) and not na(pdl)

tol = touchTolAtr * atr
brk = minBreakAtr * atr
rng = high - low
body = math.abs(close - open)
earlyBar = barsInDay <= 1
dayId = int(sessKey / 1000)

allowBuy  = not onePerDay or lastBuyDay != dayId
allowSell = not onePerDay or lastSellDay != dayId

f_plan(sideIsBuy, entry, level, structural) =>
    stopDist = stopAtrMult * atr
    stop = sideIsBuy ? entry - stopDist : entry + stopDist
    float tp = na
    if useLevelTP and not na(structural)
        if sideIsBuy and structural > entry
            tp := structural
        if not sideIsBuy and structural < entry
            tp := structural
    risk = math.abs(entry - stop)
    if na(tp) or (sideIsBuy ? tp <= entry : tp >= entry)
        tp := sideIsBuy ? entry + tpRR * risk : entry - tpRR * risk
    rr = risk > 0 ? math.abs(tp - entry) / risk : 0.0
    if rr < minRR
        tp := sideIsBuy ? entry + tpRR * risk : entry - tpRR * risk
        rr := risk > 0 ? math.abs(tp - entry) / risk : 0.0
    [rr >= minRR, stop, tp, rr]

var string sigType = ""
buySignal = false
sellSignal = false
var float sigEntry = na
var float sigSL = na
var float sigTP = na

if barstate.isconfirmed and levelsReady and atr > 0 and not earlyBar
    if enableBO and allowBuy and close[1] <= pdh + tol and close > pdh + brk
        meas = close + (pdh - pdl)
        [ok, sl, tp, rr] = f_plan(true, close, pdh, meas)
        if ok
            buySignal := true
            sigType := "PDH_BO"
            sigEntry := close
            sigSL := sl
            sigTP := tp
            lastBuyDay := dayId
    if not buySignal and enableBO and allowSell and close[1] >= pdl - tol and close < pdl - brk
        meas = close - (pdh - pdl)
        [ok, sl, tp, rr] = f_plan(false, close, pdl, meas)
        if ok
            sellSignal := true
            sigType := "PDL_BO"
            sigEntry := close
            sigSL := sl
            sigTP := tp
            lastSellDay := dayId
    if not buySignal and not sellSignal and enableOPN
        if allowBuy and close[1] <= dayOpen + tol and close > dayOpen + brk
            structLvl = mid > close ? mid : pdh
            [ok, sl, tp, rr] = f_plan(true, close, dayOpen, structLvl)
            if ok
                buySignal := true
                sigType := "OPEN_BUY"
                sigEntry := close
                sigSL := sl
                sigTP := tp
                lastBuyDay := dayId
        if not buySignal and allowSell and close[1] >= dayOpen - tol and close < dayOpen - brk
            structLvl = mid < close ? mid : pdl
            [ok, sl, tp, rr] = f_plan(false, close, dayOpen, structLvl)
            if ok
                sellSignal := true
                sigType := "OPEN_SELL"
                sigEntry := close
                sigSL := sl
                sigTP := tp
                lastSellDay := dayId
    if not buySignal and not sellSignal and enableREJ and rng > 0 and body / rng >= rejectBody
        if allowSell and high >= pdh - tol and close < pdh - brk and close < open
            structLvl = mid < close ? mid : pdl
            [ok, sl, tp, rr] = f_plan(false, close, pdh, structLvl)
            if ok
                sellSignal := true
                sigType := "PDH_REJ"
                sigEntry := close
                sigSL := sl
                sigTP := tp
                lastSellDay := dayId
        if not sellSignal and allowBuy and low <= pdl + tol and close > pdl + brk and close > open
            structLvl = mid > close ? mid : pdh
            [ok, sl, tp, rr] = f_plan(true, close, pdl, structLvl)
            if ok
                buySignal := true
                sigType := "PDL_REJ"
                sigEntry := close
                sigSL := sl
                sigTP := tp
                lastBuyDay := dayId
    if not buySignal and not sellSignal and enableORB and orbReady and barsInDay > orbBars
        if allowBuy and close[1] <= orbHigh + tol and close > orbHigh + brk
            [ok, sl, tp, rr] = f_plan(true, close, orbHigh, pdh)
            if ok
                buySignal := true
                sigType := "ORB_BUY"
                sigEntry := close
                sigSL := sl
                sigTP := tp
                lastBuyDay := dayId
        if not buySignal and allowSell and close[1] >= orbLow - tol and close < orbLow - brk
            [ok, sl, tp, rr] = f_plan(false, close, orbLow, pdl)
            if ok
                sellSignal := true
                sigType := "ORB_SELL"
                sigEntry := close
                sigSL := sl
                sigTP := tp
                lastSellDay := dayId

plotshape(showBuy and buySignal, title="Buy", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="B")
plotshape(showSell and sellSignal, title="Sell", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="S")

if buySignal or sellSignal
    label.new(time, buySignal ? low : high, sigType, xloc=xloc.bar_time, style=buySignal ? label.style_label_up : label.style_label_down, color=buySignal ? color.teal : color.maroon, textcolor=color.white, size=size.tiny)

alertcondition(buySignal, "OHLC Buy", "Intraday OHLC buy signal")
alertcondition(sellSignal, "OHLC Sell", "Intraday OHLC sell signal")
