//@version=6
indicator("MMXM 進場偵測器", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ICT Market Maker Model 進場偵測
// 流程：HTF 偏向 → LTF 累積 → 掃蕩 → 擴張/MSS + FVG → 第四階段回踩進場
// ERT 交易系統：Entry（進場）/ Risk（風險停損）/ Target（T1·T2 目標）
// 時區無關（只看 OHLC）。禁止在函式內改全域變數（CE10088）。

// ===== ICT 進場模型 =====
string entryModel = input.string("ERT交易系統", "進場模型", options=["MMXM第四階段", "ERT交易系統"], group="ICT進場模型", tooltip="ERT=高週期偏向過濾 + LTF MMXM第四階段進場，並標示 E/R/T1/T2。MMXM第四階段=僅本週期結構。")
string entryFill  = input.string("中點CE", "進場參考價", options=["中點CE", "近端", "OTE62"], group="ICT進場模型", tooltip="中點CE=FVG 50%；近端=先碰到的FVG邊界；OTE62=位移腿 62% 回撤（若落在FVG內優先，否則用中點）")
string entryTrigger = input.string("收K確認進場", "進場確認方式", options=["觸價可進場", "收K確認進場", "收K進入失衡區"], group="ICT進場模型", tooltip="觸價可進場=影線碰到即可（偏限價）；收K確認進場=碰到後收盤回到進場側；收K進入失衡區=收盤落入FVG內才算")
bool   requireMss = input.bool(true, "需要結構突破MSS（收破累積區間）", group="ICT進場模型")
bool   requireBullBearClose = input.bool(true, "收K確認時需同向收盤（多收陽/空收陰）", group="ICT進場模型")

// ===== HTF → LTF 多週期 =====
bool   useHtfFilter = input.bool(true, "啟用高週期(HTF)偏向過濾", group="HTF→LTF多週期", tooltip="僅在高週期偏向與低週期進場方向一致時才出訊號。ERT模式建議開啟。")
string htfTf = input.timeframe("60", "高週期時間框", group="HTF→LTF多週期", tooltip="例：圖表用 5/15 分，高週期用 60 或 240。留空=自動上一檔週期。")
string htfBiasMode = input.string("結構突破BOS", "HTF偏向判定", options=["結構突破BOS", "收盤相對中軸", "EMA方向"], group="HTF→LTF多週期")
int    htfSwingLen = input.int(10, "HTF結構回看根數", minval=3, group="HTF→LTF多週期")
int    htfEmaLen = input.int(20, "HTF EMA週期", minval=2, group="HTF→LTF多週期")
bool   htfAllowFlat = input.bool(false, "HTF中性時仍允許進場", group="HTF→LTF多週期", tooltip="關閉=中性時不出訊號（較嚴）")

// ===== ERL / IRL 流動性路徑 =====
bool   useErlIrl = input.bool(true, "啟用ERL↔IRL判別", group="ERL/IRL流動性", tooltip="偵測 Dealing Range 外部流動性(ERL)與內部流動性(IRL)，判斷目前往哪邊抽")
int    dealRangeLen = input.int(50, "Dealing Range 回看根數", minval=10, group="ERL/IRL流動性")
float  eqTolPct = input.float(0.05, "視為到達IRL(均衡)容差（佔區間）", minval=0.01, maxval=0.25, step=0.01, group="ERL/IRL流動性")
bool   erlIrlFilter = input.bool(false, "進場需順DOL方向", group="ERL/IRL流動性", tooltip="開啟後：多單需DOL偏多、空單需DOL偏空")
bool   showDealRange = input.bool(true, "顯示ERL高/低與IRL均衡線", group="ERL/IRL流動性")

// ===== ERT 交易系統（Entry / Risk / Target）=====
bool   ertLabels = input.bool(true, "標示 E / R / T1 / T2", group="ERT交易系統", tooltip="E=進場價、R=風險停損、T1=1R部分停利、T2=最終目標")
bool   ertRequireHtf = input.bool(true, "ERT強制要求HTF同向", group="ERT交易系統")
float  ertT1RR = input.float(1.0, "T1 部分目標（報酬比）", minval=0.5, step=0.5, group="ERT交易系統")
bool   showErtChecklist = input.bool(true, "狀態表顯示ERT清單", group="ERT交易系統")

// ===== 盈虧比 / 停損停利 =====
string tpMode = input.string("兩者取遠", "停利計算方式", options=["固定報酬比", "結構投射", "兩者取遠"], group="盈虧設定", tooltip="固定報酬比=進場±風險×目標倍數；結構投射=掃蕩深度投射；兩者取遠=取較遠目標（報酬比較高）")
float  targetRR = input.float(2.0, "目標報酬比（1:X）= T2", minval=0.5, step=0.5, group="盈虧設定")
float  minRR = input.float(1.5, "最小可接受報酬比", minval=0.5, step=0.1, group="盈虧設定", tooltip="算出來的實際RR低於此值，整筆設定作廢")
float  stopBufAtrMult = input.float(0.05, "停損緩衝（×ATR）", minval=0.0, step=0.01, group="盈虧設定")
bool   showTP1 = input.bool(true, "另外標示 1R / T1 參考線", group="盈虧設定")

// ===== 結構偵測 =====
int   lookback = input.int(20, "累積區間回看根數", minval=5, group="結構偵測")
int   minAccBars = input.int(5, "最少累積根數", minval=2, group="結構偵測")
int   atrPeriod = input.int(14, "ATR 週期", minval=1, group="結構偵測")
float maxRangeAtrMult = input.float(2.5, "最大區間寬度（×ATR）", minval=0.5, step=0.1, group="結構偵測")
float manipAtrMult = input.float(0.25, "最少掃蕩深度（×ATR）", minval=0.0, step=0.05, group="結構偵測")
float minSweepOfRange = input.float(0.15, "最少掃蕩深度（佔區間比例）", minval=0.0, step=0.05, group="結構偵測")
float dispBodyRatio = input.float(0.55, "位移K線實體比例", minval=0.1, maxval=1.0, step=0.05, group="結構偵測")
float dispAtrMult = input.float(0.9, "位移K線最小幅度（×ATR）", minval=0.1, step=0.1, group="結構偵測")
int   maxWaitBars = input.int(20, "最多等待回踩根數", minval=3, group="結構偵測")

// ===== 顯示 =====
bool showBuy = input.bool(true, "顯示作多模型（MMBM）", group="顯示設定")
bool showSell = input.bool(true, "顯示作空模型（MMSM）", group="顯示設定")
bool showRrBoxes = input.bool(true, "顯示盈虧色帶", group="顯示設定")
bool showLevelLines = input.bool(true, "顯示E/R/T橫貫價位線", group="顯示設定")
bool showFvgBox = input.bool(false, "顯示失衡區框（已停用）", group="顯示設定")
bool showAccBox = input.bool(false, "顯示累積區間框（已停用）", group="顯示設定")
bool showPending = input.bool(true, "顯示等待回踩背景", group="顯示設定")
bool showMarkers = input.bool(true, "顯示進場標記", group="顯示設定")
bool showInfoTable = input.bool(true, "顯示右上固定盈虧表", group="顯示設定")
int  boxBars = input.int(25, "進場區色帶根數", minval=5, maxval=200, group="顯示設定")

color buyRiskCol = input.color(color.new(#ef5350, 75), "作多風險區顏色", group="顏色")
color buyRewardCol = input.color(color.new(#26a69a, 75), "作多獲利區顏色", group="顏色")
color sellRiskCol = input.color(color.new(#ef5350, 75), "作空風險區顏色", group="顏色")
color sellRewardCol = input.color(color.new(#26a69a, 75), "作空獲利區顏色", group="顏色")
color fvgCol = input.color(color.new(#42a5f5, 80), "失衡區框顏色", group="顏色")
color accCol = input.color(color.new(#ab47bc, 88), "累積框顏色", group="顏色")
color pendingCol = input.color(color.new(#ffca28, 85), "等待回踩框顏色", group="顏色")

bool isErtMode = entryModel == "ERT交易系統"
bool htfFilterOn = useHtfFilter or (isErtMode and ertRequireHtf)

float atrVal = ta.atr(atrPeriod)

int IDLE = 0
int ACC = 1
int MAN = 2
int EXP = 3
int WAIT = 4
int ENT = 5
int INV = 6

f_phaseName(int p) =>
    switch p
        ACC => "累積中"
        MAN => "掃蕩中"
        EXP => "擴張中"
        WAIT => "等待回踩"
        ENT => "已進場"
        INV => "已失效"
        => "待機"

f_isDisp(bool bull) =>
    float rng = high - low
    float body = math.abs(close - open)
    bool ok = rng > 0.0 and not na(atrVal) and atrVal > 0.0 and body / rng >= dispBodyRatio and rng >= dispAtrMult * atrVal
    ok and (bull ? close > open : close < open)

f_hasBullFvg() =>
    low > high[2]

f_hasBearFvg() =>
    high < low[2]

f_bullFvgTop() =>
    low

f_bullFvgBot() =>
    high[2]

f_bearFvgTop() =>
    low[2]

f_bearFvgBot() =>
    high

f_px(float v) =>
    str.tostring(v, format.mintick)

// HTF bias: 1=bull, -1=bear, 0=flat/unknown
f_htfBiasCalc() =>
    float swingHi = ta.highest(high, htfSwingLen)
    float swingLo = ta.lowest(low, htfSwingLen)
    float mid = (swingHi + swingLo) * 0.5
    float ema = ta.ema(close, htfEmaLen)
    int bias = 0
    if htfBiasMode == "EMA方向"
        if not na(ema)
            bias := close > ema ? 1 : close < ema ? -1 : 0
    else if htfBiasMode == "收盤相對中軸"
        if not na(mid)
            bias := close > mid ? 1 : close < mid ? -1 : 0
    else
        bool bullBos = not na(swingHi[1]) and close > swingHi[1]
        bool bearBos = not na(swingLo[1]) and close < swingLo[1]
        if bullBos
            bias := 1
        else if bearBos
            bias := -1
        else if not na(mid)
            bias := close >= mid ? 1 : -1
    bias

int htfBiasRaw = request.security(syminfo.tickerid, htfTf, f_htfBiasCalc(), barmerge.gaps_off, barmerge.lookahead_off)
int htfBias = nz(htfBiasRaw, 0)

f_htfName(int b) =>
    b > 0 ? "偏多" : b < 0 ? "偏空" : "中性"

f_htfAllows(bool isBuy) =>
    if not htfFilterOn
        true
    else if htfBias == 0
        htfAllowFlat
    else
        isBuy ? htfBias > 0 : htfBias < 0

// ----- ERL / IRL：Dealing Range 與流動性抽向 -----
// ERL = 區間外緣高低（BSL/SSL）；IRL = 區間內均衡(EQ)等內部目標
// 典型路徑：掃到 ERL → 回抽 IRL → 再往另一側 ERL
float drHi = ta.highest(high, dealRangeLen)
float drLo = ta.lowest(low, dealRangeLen)
float drEq = (drHi + drLo) * 0.5
float drSpan = drHi - drLo
float eqBand = drSpan > 0.0 ? drSpan * eqTolPct : 0.0

var int lastErlSide = 0  // 1=掃到ERL高(BSL), -1=掃到ERL低(SSL)
var int dolDir = 0       // 1=偏多, -1=偏空
var int dolPhase = 0     // 1=ERL→IRL, 2=IRL→ERL
var float dolTarget = float(na)

bool sweptErlHigh = not na(drHi[1]) and high >= drHi[1]
bool sweptErlLow = not na(drLo[1]) and low <= drLo[1]
if useErlIrl
    if sweptErlHigh
        lastErlSide := 1
    else if sweptErlLow
        lastErlSide := -1

    bool nearIrl = not na(drEq) and math.abs(close - drEq) <= eqBand
    bool aboveEq = not na(drEq) and close > drEq
    bool belowEq = not na(drEq) and close < drEq

    if lastErlSide < 0
        // 剛掃 SSL(ERL低) → 先往上抽 IRL，過均衡後往 ERL高
        dolDir := 1
        if belowEq or nearIrl
            dolPhase := 1
            dolTarget := drEq
        else
            dolPhase := 2
            dolTarget := drHi
    else if lastErlSide > 0
        // 剛掃 BSL(ERL高) → 先往下抽 IRL，過均衡後往 ERL低
        dolDir := -1
        if aboveEq or nearIrl
            dolPhase := 1
            dolTarget := drEq
        else
            dolPhase := 2
            dolTarget := drLo
    else
        // 尚無掃蕩：依溢價/折價推估下一抽向
        if aboveEq
            dolDir := -1
            dolPhase := 2
            dolTarget := drLo
        else if belowEq
            dolDir := 1
            dolPhase := 2
            dolTarget := drHi
        else
            dolDir := 0
            dolPhase := 0
            dolTarget := drEq

f_dolPathName() =>
    if not useErlIrl
        "關閉"
    else if dolPhase == 1 and dolDir > 0
        "ERL→IRL 偏多"
    else if dolPhase == 1 and dolDir < 0
        "ERL→IRL 偏空"
    else if dolPhase == 2 and dolDir > 0
        "IRL→ERL 偏多"
    else if dolPhase == 2 and dolDir < 0
        "IRL→ERL 偏空"
    else
        "觀望"

f_dolTargetName() =>
    if not useErlIrl or na(dolTarget)
        "-"
    else if dolPhase == 1
        "IRL均衡 " + f_px(dolTarget)
    else if dolDir > 0
        "ERL高 " + f_px(dolTarget)
    else if dolDir < 0
        "ERL低 " + f_px(dolTarget)
    else
        f_px(dolTarget)

f_dolAllows(bool isBuy) =>
    if not useErlIrl or not erlIrlFilter
        true
    else if dolDir == 0
        false
    else
        isBuy ? dolDir > 0 : dolDir < 0

f_entryLevel(bool isBuy, float top, float bot, float manip, float expExtreme) =>
    float proximal = isBuy ? bot : top
    float mid = (top + bot) * 0.5
    float ote = isBuy ? (expExtreme - (expExtreme - manip) * 0.62) : (expExtreme + (manip - expExtreme) * 0.62)
    float result = mid
    if entryFill == "近端"
        result := proximal
    else if entryFill == "OTE62"
        bool oteInFvg = ote <= top and ote >= bot
        result := oteInFvg ? ote : mid
    result

// 盈虧顯示：畫面固定用「水平價位線 + linefill + 右上表格」
// （不用 box/label 貼在進場K上，移動圖表時不會跟蠟燭分離）
type TradeSetup
    int x1
    float entry
    float sl
    float tp
    bool isBuy
    string modeTxt

var TradeSetup[] trades = array.new<TradeSetup>()

f_registerSetup(bool isBuy, float entry, float sl, float tp, float fvgTop, float fvgBot, float accHi, float accLo, int accStartBar, int fvgBar, string modeTxt) =>
    float risk = math.abs(entry - sl)
    float reward = math.abs(tp - entry)
    float rr = risk > 0.0 ? reward / risk : 0.0
    array.push(trades, TradeSetup.new(bar_index, entry, sl, tp, isBuy, modeTxt))
    if array.size(trades) > 40
        array.shift(trades)
    rr

f_entryConfirmed(bool isBuy, float entry, float fvgTop, float fvgBot) =>
    bool tappedZone = isBuy ? (low <= fvgTop and high >= fvgBot) : (high >= fvgBot and low <= fvgTop)
    bool tappedCE = low <= entry and high >= entry
    bool closeInFvg = close <= fvgTop and close >= fvgBot
    bool closeBack = isBuy ? (close >= entry or close >= fvgBot) : (close <= entry or close <= fvgTop)
    bool dirOk = not requireBullBearClose or (isBuy ? close > open : close < open)
    bool ok = false
    if entryTrigger == "觸價可進場"
        ok := tappedZone or tappedCE
    else if entryTrigger == "收K進入失衡區"
        ok := closeInFvg and dirOk
    else
        ok := (tappedZone or tappedCE) and closeBack and dirOk
    ok

// ---- Buy state ----
var int bPhase = IDLE
var float bAccHi = float(na)
var float bAccLo = float(na)
var int bAccStartBar = 0
var int bAccStartTime = na
var int bAccCount = 0
var float bManip = float(na)
var int bExpBar = 0
var int bFvgBar = 0
var int bFvgTime = na
var float bFvgTop = float(na)
var float bFvgBot = float(na)
var float bExpExt = float(na)
var float bEntry = float(na)
var float bSL = float(na)
var float bTP = float(na)

// ---- Sell state ----
var int sPhase = IDLE
var float sAccHi = float(na)
var float sAccLo = float(na)
var int sAccStartBar = 0
var int sAccStartTime = na
var int sAccCount = 0
var float sManip = float(na)
var int sExpBar = 0
var int sFvgBar = 0
var int sFvgTime = na
var float sFvgTop = float(na)
var float sFvgBot = float(na)
var float sExpExt = float(na)
var float sEntry = float(na)
var float sSL = float(na)
var float sTP = float(na)

var bool buySignal = false
var bool sellSignal = false
var float buyRR = float(na)
var float sellRR = float(na)

buySignal := false
sellSignal := false

float candHi = ta.highest(high, lookback)
float candLo = ta.lowest(low, lookback)
bool candTight = not na(atrVal) and atrVal > 0.0 and not na(candHi) and not na(candLo) and (candHi - candLo) <= maxRangeAtrMult * atrVal and (candHi - candLo) > 0.0

bool runModel = entryModel == "MMXM第四階段" or entryModel == "ERT交易系統"

if bar_index >= math.max(lookback, atrPeriod) and runModel
    // ===================== BUY =====================
    if bPhase == ENT or bPhase == INV
        bPhase := IDLE
        bAccHi := float(na)
        bAccLo := float(na)
        bAccCount := 0
        bManip := float(na)
        bExpBar := 0
        bFvgBar := 0
        bFvgTime := na
        bFvgTop := float(na)
        bFvgBot := float(na)
        bExpExt := float(na)
        bEntry := float(na)
        bSL := float(na)
        bTP := float(na)

    if bPhase == IDLE or bPhase == ACC
        if bPhase == ACC and bAccCount >= minAccBars and not na(bAccLo)
            float sweepDepth = bAccLo - low
            float minSweep = math.max(manipAtrMult * atrVal, minSweepOfRange * (bAccHi - bAccLo))
            if sweepDepth >= minSweep
                bPhase := MAN
                bManip := low
            else if candTight
                bAccCount := bAccCount + 1
            else
                bPhase := IDLE
                bAccHi := float(na)
                bAccLo := float(na)
                bAccCount := 0
                bManip := float(na)
                bExpBar := 0
                bFvgBar := 0
                bFvgTime := na
                bFvgTop := float(na)
                bFvgBot := float(na)
                bExpExt := float(na)
                bEntry := float(na)
                bSL := float(na)
                bTP := float(na)
        else if candTight
            if bPhase == IDLE or na(bAccLo)
                bPhase := ACC
                bAccHi := candHi
                bAccLo := candLo
                bAccStartBar := bar_index - lookback + 1
                bAccStartTime := time[lookback - 1]
                bAccCount := lookback
            else
                bAccHi := math.min(bAccHi, candHi)
                bAccLo := math.max(bAccLo, candLo)
                if bAccHi <= bAccLo
                    bAccHi := candHi
                    bAccLo := candLo
                bAccCount := bAccCount + 1
        else
            bPhase := IDLE
            bAccHi := float(na)
            bAccLo := float(na)
            bAccCount := 0
            bManip := float(na)
            bExpBar := 0
            bFvgBar := 0
            bFvgTime := na
            bFvgTop := float(na)
            bFvgBot := float(na)
            bExpExt := float(na)
            bEntry := float(na)
            bSL := float(na)
            bTP := float(na)

    else if bPhase == MAN
        if not na(bManip) and low < bManip
            bManip := low
        bool mssOk = not requireMss or close > bAccHi
        bool bullDisp = f_isDisp(true) and mssOk
        if bullDisp
            bPhase := EXP
            bExpBar := bar_index
            bExpExt := high
            if f_hasBullFvg()
                bFvgTop := f_bullFvgTop()
                bFvgBot := f_bullFvgBot()
                bFvgBar := bar_index
                bFvgTime := time
        else if close < bAccLo - math.max(manipAtrMult * atrVal, bAccHi - bAccLo) * 1.5
            bPhase := INV

    else if bPhase == EXP
        if high > bExpExt
            bExpExt := high
        if na(bFvgTop) and f_hasBullFvg()
            bFvgTop := f_bullFvgTop()
            bFvgBot := f_bullFvgBot()
            bFvgBar := bar_index
            bFvgTime := time
        if not na(bFvgTop) and not na(bFvgBot) and not na(bManip)
            float entry = f_entryLevel(true, bFvgTop, bFvgBot, bManip, bExpExt)
            float sl = bManip - stopBufAtrMult * atrVal
            float risk = entry - sl
            float fixedTp = entry + risk * targetRR
            float depth = bAccHi - bManip
            float structTp = math.max(bAccHi + depth, bAccHi + (bAccHi - bAccLo))
            float tp = fixedTp
            if tpMode == "結構投射"
                tp := structTp
            else if tpMode == "兩者取遠"
                tp := math.max(fixedTp, structTp)
            float reward = tp - entry
            float rr = risk > 0.0 ? reward / risk : 0.0
            if risk > 0.0 and reward > 0.0 and rr >= minRR
                bEntry := entry
                bSL := sl
                bTP := tp
                bPhase := WAIT
            else
                bPhase := INV
        else if bar_index - bExpBar >= 3
            bPhase := INV

    else if bPhase == WAIT
        bool timedOut = bar_index - bFvgBar >= maxWaitBars
        bool stopped = close < bSL
        bool fvgBroken = close < bFvgBot
        if timedOut or stopped or fvgBroken
            bPhase := INV
        else if f_entryConfirmed(true, bEntry, bFvgTop, bFvgBot) and showBuy and f_htfAllows(true) and f_dolAllows(true)
            buySignal := true
            buyRR := f_registerSetup(true, bEntry, bSL, bTP, bFvgTop, bFvgBot, bAccHi, bAccLo, bAccStartBar, bFvgBar, entryTrigger)
            bPhase := ENT

    // ===================== SELL =====================
    if sPhase == ENT or sPhase == INV
        sPhase := IDLE
        sAccHi := float(na)
        sAccLo := float(na)
        sAccCount := 0
        sManip := float(na)
        sExpBar := 0
        sFvgBar := 0
        sFvgTime := na
        sFvgTop := float(na)
        sFvgBot := float(na)
        sExpExt := float(na)
        sEntry := float(na)
        sSL := float(na)
        sTP := float(na)

    if sPhase == IDLE or sPhase == ACC
        if sPhase == ACC and sAccCount >= minAccBars and not na(sAccHi)
            float sweepDepth = high - sAccHi
            float minSweep = math.max(manipAtrMult * atrVal, minSweepOfRange * (sAccHi - sAccLo))
            if sweepDepth >= minSweep
                sPhase := MAN
                sManip := high
            else if candTight
                sAccCount := sAccCount + 1
            else
                sPhase := IDLE
                sAccHi := float(na)
                sAccLo := float(na)
                sAccCount := 0
                sManip := float(na)
                sExpBar := 0
                sFvgBar := 0
                sFvgTime := na
                sFvgTop := float(na)
                sFvgBot := float(na)
                sExpExt := float(na)
                sEntry := float(na)
                sSL := float(na)
                sTP := float(na)
        else if candTight
            if sPhase == IDLE or na(sAccHi)
                sPhase := ACC
                sAccHi := candHi
                sAccLo := candLo
                sAccStartBar := bar_index - lookback + 1
                sAccStartTime := time[lookback - 1]
                sAccCount := lookback
            else
                sAccHi := math.min(sAccHi, candHi)
                sAccLo := math.max(sAccLo, candLo)
                if sAccHi <= sAccLo
                    sAccHi := candHi
                    sAccLo := candLo
                sAccCount := sAccCount + 1
        else
            sPhase := IDLE
            sAccHi := float(na)
            sAccLo := float(na)
            sAccCount := 0
            sManip := float(na)
            sExpBar := 0
            sFvgBar := 0
            sFvgTime := na
            sFvgTop := float(na)
            sFvgBot := float(na)
            sExpExt := float(na)
            sEntry := float(na)
            sSL := float(na)
            sTP := float(na)

    else if sPhase == MAN
        if not na(sManip) and high > sManip
            sManip := high
        bool mssOk = not requireMss or close < sAccLo
        bool bearDisp = f_isDisp(false) and mssOk
        if bearDisp
            sPhase := EXP
            sExpBar := bar_index
            sExpExt := low
            if f_hasBearFvg()
                sFvgTop := f_bearFvgTop()
                sFvgBot := f_bearFvgBot()
                sFvgBar := bar_index
                sFvgTime := time
        else if close > sAccHi + math.max(manipAtrMult * atrVal, sAccHi - sAccLo) * 1.5
            sPhase := INV

    else if sPhase == EXP
        if low < sExpExt
            sExpExt := low
        if na(sFvgTop) and f_hasBearFvg()
            sFvgTop := f_bearFvgTop()
            sFvgBot := f_bearFvgBot()
            sFvgBar := bar_index
            sFvgTime := time
        if not na(sFvgTop) and not na(sFvgBot) and not na(sManip)
            float entry = f_entryLevel(false, sFvgTop, sFvgBot, sManip, sExpExt)
            float sl = sManip + stopBufAtrMult * atrVal
            float risk = sl - entry
            float fixedTp = entry - risk * targetRR
            float depth = sManip - sAccLo
            float structTp = math.min(sAccLo - depth, sAccLo - (sAccHi - sAccLo))
            float tp = fixedTp
            if tpMode == "結構投射"
                tp := structTp
            else if tpMode == "兩者取遠"
                tp := math.min(fixedTp, structTp)
            float reward = entry - tp
            float rr = risk > 0.0 ? reward / risk : 0.0
            if risk > 0.0 and reward > 0.0 and rr >= minRR
                sEntry := entry
                sSL := sl
                sTP := tp
                sPhase := WAIT
            else
                sPhase := INV
        else if bar_index - sExpBar >= 3
            sPhase := INV

    else if sPhase == WAIT
        bool timedOut = bar_index - sFvgBar >= maxWaitBars
        bool stopped = close > sSL
        bool fvgBroken = close > sFvgTop
        if timedOut or stopped or fvgBroken
            sPhase := INV
        else if f_entryConfirmed(false, sEntry, sFvgTop, sFvgBot) and showSell and f_htfAllows(false) and f_dolAllows(false)
            sellSignal := true
            sellRR := f_registerSetup(false, sEntry, sSL, sTP, sFvgTop, sFvgBot, sAccHi, sAccLo, sAccStartBar, sFvgBar, entryTrigger)
            sPhase := ENT

// ---- 畫面固定：最新一筆 E/R/T 畫成橫貫價位線 + 色帶（移動圖表仍看得到）----
var line lnE = na
var line lnR = na
var line lnT = na
var line lnT1 = na
var line lnErlHi = na
var line lnErlLo = na
var line lnIrlEq = na
var line lnDol = na
var linefill fillRisk = na
var linefill fillRew = na
var label labE = na
var label labR = na
var label labT = na
var label labT1 = na
var label labDol = na

float lastEntry = float(na)
float lastSl = float(na)
float lastTp = float(na)
float lastT1 = float(na)
float lastRr = float(na)
bool lastIsBuy = false
int lastX1 = na
string lastSide = "-"

if array.size(trades) > 0
    TradeSetup lastT = array.get(trades, array.size(trades) - 1)
    lastEntry := lastT.entry
    lastSl := lastT.sl
    lastTp := lastT.tp
    float lastRisk = math.abs(lastT.entry - lastT.sl)
    lastT1 := lastT.isBuy ? lastT.entry + lastRisk * ertT1RR : lastT.entry - lastRisk * ertT1RR
    lastRr := lastRisk > 0.0 ? math.abs(lastT.tp - lastT.entry) / lastRisk : float(na)
    lastIsBuy := lastT.isBuy
    lastX1 := lastT.x1
    lastSide := lastT.isBuy ? "作多" : "作空"

if barstate.islast
    // 刪掉舊線再建，避免殘留
    if not na(lnE)
        line.delete(lnE)
    if not na(lnR)
        line.delete(lnR)
    if not na(lnT)
        line.delete(lnT)
    if not na(lnT1)
        line.delete(lnT1)
    if not na(lnErlHi)
        line.delete(lnErlHi)
    if not na(lnErlLo)
        line.delete(lnErlLo)
    if not na(lnIrlEq)
        line.delete(lnIrlEq)
    if not na(lnDol)
        line.delete(lnDol)
    if not na(fillRisk)
        linefill.delete(fillRisk)
    if not na(fillRew)
        linefill.delete(fillRew)
    if not na(labE)
        label.delete(labE)
    if not na(labR)
        label.delete(labR)
    if not na(labT)
        label.delete(labT)
    if not na(labT1)
        label.delete(labT1)
    if not na(labDol)
        label.delete(labDol)
    lnE := na
    lnR := na
    lnT := na
    lnT1 := na
    lnErlHi := na
    lnErlLo := na
    lnIrlEq := na
    lnDol := na
    fillRisk := na
    fillRew := na
    labE := na
    labR := na
    labT := na
    labT1 := na
    labDol := na

    if useErlIrl and showDealRange and not na(drHi) and not na(drLo)
        int xL = math.max(bar_index - dealRangeLen, 0)
        int xR = bar_index + boxBars
        lnErlHi := line.new(xL, drHi, xR, drHi, color=color.new(#42a5f5, 0), width=1, style=line.style_dashed, extend=extend.both)
        lnErlLo := line.new(xL, drLo, xR, drLo, color=color.new(#42a5f5, 0), width=1, style=line.style_dashed, extend=extend.both)
        lnIrlEq := line.new(xL, drEq, xR, drEq, color=color.new(#ab47bc, 0), width=1, style=line.style_dotted, extend=extend.both)
        if not na(dolTarget)
            color dolC = dolDir > 0 ? color.teal : dolDir < 0 ? color.orange : color.gray
            lnDol := line.new(xL, dolTarget, xR, dolTarget, color=dolC, width=2, extend=extend.both)
            labDol := label.new(bar_index, dolTarget, f_dolPathName() + " → " + f_dolTargetName(), style=label.style_label_left, color=color.new(dolC, 20), textcolor=color.white, size=size.normal)

    if not na(lastEntry) and not na(lastX1) and showLevelLines
        color eC = lastIsBuy ? color.teal : color.orange
        int xRight = bar_index + boxBars
        lnE := line.new(lastX1, lastEntry, xRight, lastEntry, color=eC, width=2, extend=extend.both)
        lnR := line.new(lastX1, lastSl, xRight, lastSl, color=color.red, width=2, style=line.style_dashed, extend=extend.both)
        lnT := line.new(lastX1, lastTp, xRight, lastTp, color=color.lime, width=2, style=line.style_dashed, extend=extend.both)
        if showTP1 or isErtMode or ertLabels
            lnT1 := line.new(lastX1, lastT1, xRight, lastT1, color=color.new(color.yellow, 20), width=1, style=line.style_dotted, extend=extend.both)
            labT1 := label.new(bar_index, lastT1, "T1 " + f_px(lastT1), style=label.style_label_left, color=color.new(color.yellow, 70), textcolor=color.black, size=size.small)
        if showRrBoxes
            fillRisk := linefill.new(lnE, lnR, lastIsBuy ? buyRiskCol : sellRiskCol)
            fillRew := linefill.new(lnE, lnT, lastIsBuy ? buyRewardCol : sellRewardCol)
        labE := label.new(bar_index, lastEntry, (isErtMode or ertLabels ? "E " : "進場 ") + f_px(lastEntry), style=label.style_label_left, color=color.new(eC, 20), textcolor=color.white, size=size.normal)
        labR := label.new(bar_index, lastSl, (isErtMode or ertLabels ? "R " : "停損 ") + f_px(lastSl), style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)
        labT := label.new(bar_index, lastTp, (isErtMode or ertLabels ? "T2 " : "停利 ") + f_px(lastTp), style=label.style_label_left, color=color.new(color.green, 20), textcolor=color.white, size=size.normal)

// 進場當根附近也留一段 plot 色帶（跟K線）
float rrEntry = float(na)
float rrSl = float(na)
float rrTp = float(na)
bool rrOn = false
bool rrIsBuy = false
if array.size(trades) > 0
    for i = 0 to array.size(trades) - 1
        TradeSetup t = array.get(trades, i)
        if bar_index >= t.x1 and bar_index <= t.x1 + boxBars
            rrEntry := t.entry
            rrSl := t.sl
            rrTp := t.tp
            rrOn := true
            rrIsBuy := t.isBuy

plotE = plot(showRrBoxes and rrOn ? rrEntry : na, title="E區", color=color.new(color.teal, 100), style=plot.style_linebr)
plotR = plot(showRrBoxes and rrOn ? rrSl : na, title="R區", color=color.new(color.red, 100), style=plot.style_linebr)
plotT = plot(showRrBoxes and rrOn ? rrTp : na, title="T區", color=color.new(color.lime, 100), style=plot.style_linebr)
fill(plotE, plotR, title="風險區", color=showRrBoxes and rrOn ? (rrIsBuy ? buyRiskCol : sellRiskCol) : na)
fill(plotE, plotT, title="目標區", color=showRrBoxes and rrOn ? (rrIsBuy ? buyRewardCol : sellRewardCol) : na)

bgcolor(showPending and bPhase == WAIT ? color.new(#ffca28, 88) : na, title="等待作多回踩")
bgcolor(showPending and sPhase == WAIT ? color.new(#ffb300, 88) : na, title="等待作空回踩")

plotshape(showMarkers and showBuy and buySignal and isErtMode, title="ERT作多", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.normal, text="E多")
plotshape(showMarkers and showBuy and buySignal and not isErtMode, title="作多進場", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.normal, text="作多")
plotshape(showMarkers and showSell and sellSignal and isErtMode, title="ERT作空", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.normal, text="E空")
plotshape(showMarkers and showSell and sellSignal and not isErtMode, title="作空進場", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.normal, text="作空")

// 右上表格 = 真正畫面固定（捲動也不會跑）
var table info = table.new(position.top_right, 2, 16, bgcolor=color.new(#111111, 20), border_width=1, border_color=color.gray)
if showInfoTable and barstate.islast
    table.cell(info, 0, 0, "ERT畫面固定", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, lastSide, text_color=lastIsBuy ? color.teal : color.orange, text_size=size.small)
    table.cell(info, 0, 1, "E 進場", text_color=color.aqua, text_size=size.small)
    table.cell(info, 1, 1, not na(lastEntry) ? f_px(lastEntry) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 2, "R 停損", text_color=color.red, text_size=size.small)
    table.cell(info, 1, 2, not na(lastSl) ? f_px(lastSl) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 3, "T1", text_color=color.yellow, text_size=size.small)
    table.cell(info, 1, 3, not na(lastT1) ? f_px(lastT1) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 4, "T2 停利", text_color=color.lime, text_size=size.small)
    table.cell(info, 1, 4, not na(lastTp) ? f_px(lastTp) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 5, "報酬比", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 5, not na(lastRr) ? "1:" + str.tostring(lastRr, "#.##") : "-", text_color=color.lime, text_size=size.small)
    table.cell(info, 0, 6, "模型", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 6, entryModel, text_color=color.aqua, text_size=size.tiny)
    table.cell(info, 0, 7, "HTF偏向", text_color=color.gray, text_size=size.tiny)
    color htfCol = htfBias > 0 ? color.teal : htfBias < 0 ? color.orange : color.gray
    string htfTxt = htfFilterOn ? f_htfName(htfBias) + " (" + (htfTf == "" ? "自動" : htfTf) + ")" : "關閉"
    table.cell(info, 1, 7, htfTxt, text_color=htfCol, text_size=size.tiny)
    table.cell(info, 0, 8, "確認方式", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 8, entryTrigger, text_color=color.white, text_size=size.tiny)
    table.cell(info, 0, 9, "作多階段", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 9, f_phaseName(bPhase), text_color=color.teal, text_size=size.tiny)
    table.cell(info, 0, 10, "作空階段", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 10, f_phaseName(sPhase), text_color=color.orange, text_size=size.tiny)
    table.cell(info, 0, 11, "作多等待E", text_color=color.gray, text_size=size.tiny)
    string bWait = bPhase == WAIT and not na(bEntry) ? f_px(bEntry) + (f_htfAllows(true) ? "" : "·等HTF") : "-"
    table.cell(info, 1, 11, bWait, text_color=color.teal, text_size=size.tiny)
    table.cell(info, 0, 12, "作空等待E", text_color=color.gray, text_size=size.tiny)
    string sWait = sPhase == WAIT and not na(sEntry) ? f_px(sEntry) + (f_htfAllows(false) ? "" : "·等HTF") : "-"
    table.cell(info, 1, 12, sWait, text_color=color.orange, text_size=size.tiny)
    table.cell(info, 0, 13, "區間收斂", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 13, candTight ? "是" : "否", text_color=candTight ? color.lime : color.red, text_size=size.tiny)
    if showErtChecklist
        bool ertE = not na(lastEntry) or bPhase == WAIT or sPhase == WAIT
        bool ertR = not na(lastSl) or (bPhase == WAIT and not na(bSL)) or (sPhase == WAIT and not na(sSL))
        bool ertT = not na(lastTp)
        bool ertH = f_htfAllows(true) or f_htfAllows(false) or not htfFilterOn
        table.cell(info, 0, 14, "ERT清單", text_color=color.white, text_size=size.tiny)
        table.cell(info, 1, 14, "E" + (ertE ? "✓" : "·") + " R" + (ertR ? "✓" : "·") + " T" + (ertT ? "✓" : "·"), text_color=color.aqua, text_size=size.tiny)
        table.cell(info, 0, 15, "HTF過濾", text_color=color.gray, text_size=size.tiny)
        table.cell(info, 1, 15, htfFilterOn ? (ertH ? "通過/就緒" : "阻擋反向") : "未啟用", text_color=htfFilterOn ? color.lime : color.gray, text_size=size.tiny)

alertcondition(buySignal, "作多進場", "ICT MMXM/ERT 作多進場")
alertcondition(sellSignal, "作空進場", "ICT MMXM/ERT 作空進場")
