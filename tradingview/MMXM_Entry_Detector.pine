// 過濾系統（各自勾選）
bool   revFiltLiq = input.bool(true, "過濾：需BSL/SSL掃蕩", group="反轉過濾系統", tooltip="多=已掃SSL；空=已掃BSL")
bool   revFiltCisd = input.bool(true, "過濾：需CISD", group="反轉過濾系統")
bool   revFiltDisp = input.bool(true, "過濾：需位移K", group="反轉過濾系統")
bool   revFiltFvg = input.bool(true, "過濾：需FVG", group="反轉過濾系統")
bool   revFiltMss = input.bool(false, "過濾：需MSS/結構翻轉", group="反轉過濾系統", tooltip="收破近期擺動高低")
bool   revFiltHtf = input.bool(true, "過濾：HTF同向", group="反轉過濾系統")
bool   revFiltKz = input.bool(true, "過濾：需在Killzone", group="反轉過濾系統")
bool   revFiltTime = input.bool(false, "過濾：套用①時間模組", group="反轉過濾系統")
bool   revFiltModules = input.bool(false, "過濾：套用四大模組全開條件", group="反轉過濾系統")
bool   revFiltMutex = input.bool(true, "過濾：與當根趨勢進場互斥", group="反轉過濾系統", tooltip="同根已有ALG/MMXM進場則不出反轉")
int    revMinScore = input.int(3, "過濾最低分數", minval=1, maxval=8, group="反轉過濾系統", tooltip="掃蕩/CISD/位移/FVG/MSS/HTF/KZ/時間 各1分")

// ===== ICT 合流（Killzone / IPDA / 計分）=====
bool   useAlgo = input.bool(true, "啟用ICT合流計分", group="ICT合流", tooltip="Killzone + HTF + PO3 + 模組狀態 合流計分（可與四大模組並用）")
string algoTz = input.string("America/New_York", "Killzone時區", options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Taipei", "UTC"], group="ICT合流")
bool   useLondonKz = input.bool(true, "倫敦Killzone 02–05", group="ICT合流")
bool   useNyKz = input.bool(true, "紐約Killzone 08–11", group="ICT合流")
bool   useSilverBullet = input.bool(true, "Silver Bullet 10–11", group="ICT合流")
bool   algoRequireKz = input.bool(false, "合流進場需在Killzone內", group="ICT合流", tooltip="時間細節改由①時間演算法模組控制時可關閉")
bool   algoRequirePo3Dist = input.bool(false, "合流進場需PO3派發同向", group="ICT合流")
bool   algoRequireHtf = input.bool(true, "合流進場需HTF同向", group="ICT合流")
bool   algoRequireDol = input.bool(false, "合流進場需舊DOL同向", group="ICT合流")
int    algoMinScore = input.int(2, "最低合流分數", minval=1, maxval=8, group="ICT合流", tooltip="各模組/條件各1分")
bool   useIpda = input.bool(true, "啟用IPDA 20/40/60日區間", group="ICT合流")
bool   showIpdaLines = input.bool(false, "顯示IPDA高低線（可選）", group="ICT合流")
bool   showKzBg = input.bool(false, "Killzone背景提示（可選）", group="ICT合流")

// ===== PO3 Power of Three（AMD）=====
bool   usePo3 = input.bool(true, "啟用PO3（AMD）判別", group="PO3 Power of Three", tooltip="Accumulation累積 → Manipulation操控(Judas) → Distribution派發")
string po3Tf = input.timeframe("D", "PO3參考週期", group="PO3 Power of Three", tooltip="常用日線 D：以當日開盤為錨，判斷當日PO3階段")
int    po3MinAccBars = input.int(3, "累積最少根數", minval=1, group="PO3 Power of Three")
bool   po3Filter = input.bool(false, "進場需在派發階段且同向", group="PO3 Power of Three", tooltip="開啟後：多單需PO3派發偏多、空單需派發偏空。選PO3派發進場時自動啟用。")
bool   showPo3Zones = input.bool(true, "顯示累積/操控區間底色", group="PO3 Power of Three")
bool   showPo3Tip = input.bool(true, "派發前三角提示進場", group="PO3 Power of Three")
color  po3AccCol = input.color(color.new(#42a5f5, 82), "累積區底色", group="PO3 Power of Three")
color  po3ManCol = input.color(color.new(#ef5350, 82), "操控區底色", group="PO3 Power of Three")

// ===== HTF → LTF 多週期 =====
bool   useHtfFilter = input.bool(true, "啟用高週期(HTF)偏向過濾", group="HTF→LTF多週期", tooltip="僅在高週期偏向與低週期進場方向一致時才出訊號。ERT模式建議開啟。")
string htfTf = input.timeframe("60", "高週期時間框", group="HTF→LTF多週期", tooltip="例：圖表用 5/15 分，高週期用 60 或 240。留空=自動上一檔週期。")
string htfBiasMode = input.string("結構突破BOS", "HTF偏向判定", options=["結構突破BOS", "收盤相對中軸", "EMA方向"], group="HTF→LTF多週期")
int    htfSwingLen = input.int(10, "HTF結構回看根數", minval=3, group="HTF→LTF多週期")
int    htfEmaLen = input.int(20, "HTF EMA週期", minval=2, group="HTF→LTF多週期")
bool   htfAllowFlat = input.bool(false, "HTF中性時仍允許進場", group="HTF→LTF多週期", tooltip="關閉=中性時不出訊號（較嚴）")

// ===== ERL / IRL 流動性路徑 =====
bool   useErlIrl = input.bool(true, "啟用ERL↔IRL判別", group="ERL/IRL流動性", tooltip="偵測 Dealing Range 外部流動性(ERL)與內部流動性(IRL)，判斷目前往哪邊抽")
int    dealRangeLen = input.int(50, "Dealing Range 回看根數", minval=10, group="ERL/IRL流動性")
float  eqTolPct = input.float(0.05, "視為到達IRL(均衡)容差（佔區間）", minval=0.01, maxval=0.25, step=0.01, group="ERL/IRL流動性")
bool   erlIrlFilter = input.bool(false, "進場需順DOL方向", group="ERL/IRL流動性", tooltip="開啟後：多單需DOL偏多、空單需DOL偏空")

// ===== ERT 交易系統（Entry / Risk / Target）=====
bool   ertRequireHtf = input.bool(true, "ERT強制要求HTF同向", group="ERT交易系統")
float  ertT1RR = input.float(1.0, "T1 部分目標（報酬比）", minval=0.5, step=0.5, group="ERT交易系統")
bool   showErtChecklist = input.bool(true, "狀態表顯示模型列", group="ERT交易系統")

// ===== 盈虧比 / 停損停利 =====
string tpMode = input.string("兩者取遠", "停利計算方式", options=["固定報酬比", "結構投射", "兩者取遠"], group="盈虧設定", tooltip="固定報酬比=進場±風險×目標倍數；結構投射=掃蕩深度投射；兩者取遠=取較遠目標（報酬比較高）")
float  targetRR = input.float(2.0, "目標報酬比（1:X）= T2", minval=0.5, step=0.5, group="盈虧設定")
float  minRR = input.float(1.5, "最小可接受報酬比", minval=0.5, step=0.1, group="盈虧設定", tooltip="算出來的實際RR低於此值，整筆設定作廢")
float  stopBufAtrMult = input.float(0.05, "停損緩衝（×ATR）", minval=0.0, step=0.01, group="盈虧設定")

// ===== 結構偵測 =====
int   lookback = input.int(20, "累積區間回看根數", minval=5, group="結構偵測")
int   minAccBars = input.int(5, "最少累積根數", minval=2, group="結構偵測")
int   atrPeriod = input.int(14, "ATR 週期", minval=1, group="結構偵測")
float maxRangeAtrMult = input.float(2.5, "最大區間寬度（×ATR）", minval=0.5, step=0.1, group="結構偵測")
float manipAtrMult = input.float(0.25, "最少掃蕩深度（×ATR）", minval=0.0, step=0.05, group="結構偵測")
float minSweepOfRange = input.float(0.15, "最少掃蕩深度（佔區間比例）", minval=0.0, step=0.05, group="結構偵測")
float dispBodyRatio = input.float(0.55, "位移K線實體比例", minval=0.1, maxval=1.0, step=0.05, group="結構偵測")
float dispAtrMult = input.float(0.9, "位移K線最小幅度（×ATR）", minval=0.1, step=0.1, group="結構偵測")
int   maxWaitBars = input.int(20, "最多等待回踩根數", minval=3, group="結構偵測")

// ===== 顯示（預設精簡：圖上只留進場三角，盈虧看右上表）=====
bool showBuy = input.bool(true, "顯示作多模型（MMBM）", group="顯示設定")
bool showSell = input.bool(true, "顯示作空模型（MMSM）", group="顯示設定")
bool showMarkers = input.bool(true, "顯示進場三角標記", group="顯示設定")
bool showInfoTable = input.bool(true, "顯示右上固定資訊表", group="顯示設定")
bool showPending = input.bool(false, "顯示等待回踩背景", group="顯示設定")
bool showRrBoxes = input.bool(false, "顯示進場區短色帶（可選）", group="顯示設定")
int  boxBars = input.int(12, "短色帶根數", minval=3, maxval=50, group="顯示設定")

color buyRiskCol = input.color(color.new(#ef5350, 80), "作多風險色帶", group="顏色")
color buyRewardCol = input.color(color.new(#26a69a, 80), "作多獲利色帶", group="顏色")
color sellRiskCol = input.color(color.new(#ef5350, 80), "作空風險色帶", group="顏色")
color sellRewardCol = input.color(color.new(#26a69a, 80), "作空獲利色帶", group="顏色")

bool isErtMode = entryModel == "ERT交易系統"
bool isPo3Mode = entryModel == "PO3派發進場"
bool isAlgoMode = entryModel == "ICT演算法"
bool htfFilterOn = useHtfFilter or (isErtMode and ertRequireHtf) or isPo3Mode or (isAlgoMode and algoRequireHtf)
bool po3FilterOn = usePo3 and (po3Filter or isPo3Mode or (isAlgoMode and algoRequirePo3Dist))
bool algoFilterOn = useAlgo and isAlgoMode
bool liqFilterOn = useLiqAlgo
bool timeFilterOn = useTimeAlgo
bool dispFilterOn = useDispAlgo
bool targetFilterOn = useTargetAlgo

float atrVal = ta.atr(atrPeriod)

int IDLE = 0
int ACC = 1
int MAN = 2
int EXP = 3
int WAIT = 4
int ENT = 5
int INV = 6

// 提前宣告：ICT 演算法函式會讀取階段（Pine 不可引用尚未宣告的識別字）
var int bPhase = IDLE
var int sPhase = IDLE

f_phaseName(int p) =>
    switch p
        ACC => "累積中"
        MAN => "掃蕩中"
        EXP => "擴張中"
        WAIT => "等待回踩"
        ENT => "已進場"
        INV => "已失效"
        => "待機"

f_isDisp(bool bull) =>
    float rng = high - low
    float body = math.abs(close - open)
    bool ok = rng > 0.0 and not na(atrVal) and atrVal > 0.0 and body / rng >= dispBodyRatio and rng >= dispAtrMult * atrVal
    ok and (bull ? close > open : close < open)

f_hasBullFvg() =>
    low > high[2]

f_hasBearFvg() =>
    high < low[2]

f_bullFvgTop() =>
    low

f_bullFvgBot() =>
    high[2]

f_bearFvgTop() =>
    low[2]

f_bearFvgBot() =>
    high

f_px(float v) =>
    str.tostring(v, format.mintick)

// HTF bias: 1=bull, -1=bear, 0=flat/unknown
f_htfBiasCalc() =>
    float swingHi = ta.highest(high, htfSwingLen)
    float swingLo = ta.lowest(low, htfSwingLen)
    float mid = (swingHi + swingLo) * 0.5
    float ema = ta.ema(close, htfEmaLen)
    int bias = 0
    if htfBiasMode == "EMA方向"
        if not na(ema)
            bias := close > ema ? 1 : close < ema ? -1 : 0
    else if htfBiasMode == "收盤相對中軸"
        if not na(mid)
            bias := close > mid ? 1 : close < mid ? -1 : 0
    else
        bool bullBos = not na(swingHi[1]) and close > swingHi[1]
        bool bearBos = not na(swingLo[1]) and close < swingLo[1]
        if bullBos
            bias := 1
        else if bearBos
            bias := -1
        else if not na(mid)
            bias := close >= mid ? 1 : -1
    bias

int htfBiasRaw = request.security(syminfo.tickerid, htfTf, f_htfBiasCalc(), barmerge.gaps_off, barmerge.lookahead_off)
int htfBias = nz(htfBiasRaw, 0)

f_htfName(int b) =>
    b > 0 ? "偏多" : b < 0 ? "偏空" : "中性"

f_htfAllows(bool isBuy) =>
    if not htfFilterOn
        true
    else if htfBias == 0
        htfAllowFlat
    else
        isBuy ? htfBias > 0 : htfBias < 0

// ----- ERL / IRL：Dealing Range 與流動性抽向 -----
// ERL = 區間外緣高低（BSL/SSL）；IRL = 區間內均衡(EQ)等內部目標
// 典型路徑：掃到 ERL → 回抽 IRL → 再往另一側 ERL
float drHi = ta.highest(high, dealRangeLen)
float drLo = ta.lowest(low, dealRangeLen)
float drEq = (drHi + drLo) * 0.5
float drSpan = drHi - drLo
float eqBand = drSpan > 0.0 ? drSpan * eqTolPct : 0.0

var int lastErlSide = 0  // 1=掃到ERL高(BSL), -1=掃到ERL低(SSL)
var int dolDir = 0       // 1=偏多, -1=偏空
var int dolPhase = 0     // 1=ERL→IRL, 2=IRL→ERL
var float dolTarget = float(na)

bool sweptErlHigh = not na(drHi[1]) and high >= drHi[1]
bool sweptErlLow = not na(drLo[1]) and low <= drLo[1]
if useErlIrl
    if sweptErlHigh
        lastErlSide := 1
    else if sweptErlLow
        lastErlSide := -1

    bool nearIrl = not na(drEq) and math.abs(close - drEq) <= eqBand
    bool aboveEq = not na(drEq) and close > drEq
    bool belowEq = not na(drEq) and close < drEq

    if lastErlSide < 0
        // 剛掃 SSL(ERL低) → 先往上抽 IRL，過均衡後往 ERL高
        dolDir := 1
        if belowEq or nearIrl
            dolPhase := 1
            dolTarget := drEq
        else
            dolPhase := 2
            dolTarget := drHi
    else if lastErlSide > 0
        // 剛掃 BSL(ERL高) → 先往下抽 IRL，過均衡後往 ERL低
        dolDir := -1
        if aboveEq or nearIrl
            dolPhase := 1
            dolTarget := drEq
        else
            dolPhase := 2
            dolTarget := drLo
    else
        // 尚無掃蕩：依溢價/折價推估下一抽向
        if aboveEq
            dolDir := -1
            dolPhase := 2
            dolTarget := drLo
        else if belowEq
            dolDir := 1
            dolPhase := 2
            dolTarget := drHi
        else
            dolDir := 0
            dolPhase := 0
            dolTarget := drEq

f_dolPathName() =>
    if not useErlIrl
        "關閉"
    else if dolPhase == 1 and dolDir > 0
        "ERL→IRL 偏多"
    else if dolPhase == 1 and dolDir < 0
        "ERL→IRL 偏空"
    else if dolPhase == 2 and dolDir > 0
        "IRL→ERL 偏多"
    else if dolPhase == 2 and dolDir < 0
        "IRL→ERL 偏空"
    else
        "觀望"

f_dolTargetName() =>
    if not useErlIrl or na(dolTarget)
        "-"
    else if dolPhase == 1
        "IRL均衡 " + f_px(dolTarget)
    else if dolDir > 0
        "ERL高 " + f_px(dolTarget)
    else if dolDir < 0
        "ERL低 " + f_px(dolTarget)
    else
        f_px(dolTarget)

f_dolAllows(bool isBuy) =>
    if not useErlIrl or not erlIrlFilter
        true
    else if dolDir == 0
        false
    else
        isBuy ? dolDir > 0 : dolDir < 0

// ----- 流動性演算法：BSL / SSL 池 → 掃蕩後才允許進場 -----
// BSL = Buy Side Liquidity（上方樞紐高 / 空單停損池）
// SSL = Sell Side Liquidity（下方樞紐低 / 多單停損池）
// 規則：作多需先掃 SSL；作空需先掃 BSL（可要求收回收復）
var float[] bslPool = array.new_float()
var float[] sslPool = array.new_float()
var int lastSslSweepBar = na
var int lastBslSweepBar = na
var float lastSslLevel = float(na)
var float lastBslLevel = float(na)

float liqPh = ta.pivothigh(high, liqPivotLen, liqPivotLen)
float liqPl = ta.pivotlow(low, liqPivotLen, liqPivotLen)

bool sslSweepNow = false
bool bslSweepNow = false
bool trackLiqPools = useLiqAlgo or useRevSignal

if trackLiqPools
    if not na(liqPh)
        bool phExists = false
        int nB = array.size(bslPool)
        if nB > 0
            for i = 0 to nB - 1
                if math.abs(array.get(bslPool, i) - liqPh) <= syminfo.mintick
                    phExists := true
                    break
        if not phExists
            array.push(bslPool, liqPh)
            if array.size(bslPool) > liqMaxLevels
                array.shift(bslPool)
    if not na(liqPl)
        bool plExists = false
        int nS = array.size(sslPool)
        if nS > 0
            for i = 0 to nS - 1
                if math.abs(array.get(sslPool, i) - liqPl) <= syminfo.mintick
                    plExists := true
                    break
        if not plExists
            array.push(sslPool, liqPl)
            if array.size(sslPool) > liqMaxLevels
                array.shift(sslPool)

    // 掃 SSL：低點刺破下方流動性後（可選）收盤收回 → 偏多
    int nSsl = array.size(sslPool)
    if nSsl > 0
        for i = nSsl - 1 to 0
            float lvl = array.get(sslPool, i)
            bool pierced = low < lvl
            bool reclaimed = close > lvl
            if pierced and (not liqRequireReclaim or reclaimed)
                sslSweepNow := true
                lastSslSweepBar := bar_index
                lastSslLevel := lvl
                array.remove(sslPool, i)
                if liqClearOpposite
                    lastBslSweepBar := na
                    lastBslLevel := float(na)
                break

    // 掃 BSL：高點刺破上方流動性後（可選）收盤收回 → 偏空
    int nBsl = array.size(bslPool)
    if nBsl > 0
        for i = nBsl - 1 to 0
            float lvl = array.get(bslPool, i)
            bool pierced = high > lvl
            bool reclaimed = close < lvl
            if pierced and (not liqRequireReclaim or reclaimed)
                bslSweepNow := true
                lastBslSweepBar := bar_index
                lastBslLevel := lvl
                array.remove(bslPool, i)
                if liqClearOpposite
                    lastSslSweepBar := na
                    lastSslLevel := float(na)
                break

bool sslSweptActive = trackLiqPools and not na(lastSslSweepBar) and (bar_index - lastSslSweepBar) <= liqValidBars
bool bslSweptActive = trackLiqPools and not na(lastBslSweepBar) and (bar_index - lastBslSweepBar) <= liqValidBars

f_liqAllows(bool isBuy) =>
    if not liqFilterOn
        true
    else
        isBuy ? sslSweptActive : bslSweptActive

f_liqStatus() =>
    if not useLiqAlgo
        "關閉"
    else if sslSweptActive and bslSweptActive
        "雙掃 有效"
    else if sslSweptActive
        "已掃SSL↑ " + f_px(lastSslLevel)
    else if bslSweptActive
        "已掃BSL↓ " + f_px(lastBslLevel)
    else
        "待掃 BSL/SSL"

f_liqAge() =>
    if sslSweptActive and not na(lastSslSweepBar)
        "SSL " + str.tostring(bar_index - lastSslSweepBar) + "根內"
    else if bslSweptActive and not na(lastBslSweepBar)
        "BSL " + str.tostring(bar_index - lastBslSweepBar) + "根內"
    else
        "池 " + str.tostring(array.size(bslPool)) + "H/" + str.tostring(array.size(sslPool)) + "L"

// ----- ①時間演算法：Asia range → Judas swing → London/NY continuation -----
f_inHourRange(int h, int h0, int h1) =>
    h0 == h1 ? true : h0 < h1 ? (h >= h0 and h < h1) : (h >= h0 or h < h1)

int hTime = hour(time, timeTz)
int dayTime = year(time, timeTz) * 10000 + month(time, timeTz) * 100 + dayofmonth(time, timeTz)
bool inAsiaSes = f_inHourRange(hTime, asiaStartH, asiaEndH)
bool inJudasSes = f_inHourRange(hTime, judasStartH, judasEndH)
bool inContSes = (timeContLondon and hTime >= 2 and hTime < 5) or (timeContNy and hTime >= 8 and hTime < 11)

var int asiaDayKey = na
var float asiaHi = float(na)
var float asiaLo = float(na)
var bool asiaFrozen = false
var int judasDir = 0
var bool timeContBuy = false
var bool timeContSell = false
var int asiaBoxLeft = na
var box asiaBox = na
bool asiaJustOpen = inAsiaSes and not inAsiaSes[1]

if useTimeAlgo
    if asiaJustOpen or (na(asiaHi) and inAsiaSes)
        asiaDayKey := dayTime
        asiaHi := high
        asiaLo := low
        asiaFrozen := false
        judasDir := 0
        timeContBuy := false
        timeContSell := false
        asiaBoxLeft := bar_index
        asiaBox := na

    if inAsiaSes and not na(asiaHi)
        asiaHi := math.max(asiaHi, high)
        asiaLo := math.min(asiaLo, low)
        if showAsiaBox and not na(asiaBoxLeft)
            if na(asiaBox)
                asiaBox := box.new(asiaBoxLeft, asiaHi, bar_index, asiaLo, xloc=xloc.bar_index, bgcolor=color.new(#5c6bc0, 88), border_color=color.new(#3949ab, 50), border_width=1, text="Asia", text_size=size.tiny)
            else
                box.set_right(asiaBox, bar_index)
                box.set_top(asiaBox, asiaHi)
                box.set_bottom(asiaBox, asiaLo)
    else if not na(asiaHi) and not na(asiaLo)
        asiaFrozen := true
        if showAsiaBox and not na(asiaBox)
            box.set_right(asiaBox, bar_index)

    // Judas：掃 Asia 高低後收回
    if asiaFrozen and inJudasSes and not na(asiaHi) and not na(asiaLo)
        bool sweepSsl = low < asiaLo and (not timeRequireReclaim or close > asiaLo)
        bool sweepBsl = high > asiaHi and (not timeRequireReclaim or close < asiaHi)
        if sweepSsl
            judasDir := 1
            timeContSell := false
        else if sweepBsl
            judasDir := -1
            timeContBuy := false

    // Continuation：Judas 後在倫敦/紐約往反方向延續
    if asiaFrozen and inContSes and judasDir != 0 and not na(asiaHi) and not na(asiaLo)
        float asiaMid = (asiaHi + asiaLo) * 0.5
        if judasDir > 0 and close > asiaMid
            timeContBuy := true
        if judasDir < 0 and close < asiaMid
            timeContSell := true

f_timeAllows(bool isBuy) =>
    if not timeFilterOn
        true
    else if not asiaFrozen or na(asiaHi)
        false
    else
        isBuy ? timeContBuy : timeContSell

f_timeStatus() =>
    if not useTimeAlgo
        "關閉"
    else if not asiaFrozen or na(asiaHi)
        inAsiaSes ? "Asia累積中" : "待Asia"
    else if timeContBuy
        "延續偏多"
    else if timeContSell
        "延續偏空"
    else if judasDir > 0
        "已Judas↓ 待延續"
    else if judasDir < 0
        "已Judas↑ 待延續"
    else
        "Asia完成 待Judas"

// ----- ③位移：CISD 輔助 -----
f_cisdBull() =>
    float maxBearOpen = float(na)
    int run = 0
    for i = 1 to 5
        if close[i] < open[i]
            run := run + 1
            maxBearOpen := na(maxBearOpen) ? open[i] : math.max(maxBearOpen, open[i])
        else if run > 0
            break
    run >= 1 and not na(maxBearOpen) and close > maxBearOpen and close > open

f_cisdBear() =>
    float minBullOpen = float(na)
    int run = 0
    for i = 1 to 5
        if close[i] > open[i]
            run := run + 1
            minBullOpen := na(minBullOpen) ? open[i] : math.min(minBullOpen, open[i])
        else if run > 0
            break
    run >= 1 and not na(minBullOpen) and close < minBullOpen and close < open

var bool bDispValid = false
var bool sDispValid = false
var string bDispTag = "-"
var string sDispTag = "-"

f_dispAllows(bool isBuy) =>
    if not dispFilterOn
        true
    else
        isBuy ? bDispValid : sDispValid

f_dispStatus() =>
    if not useDispAlgo
        "關閉"
    else
        string b = bDispValid ? "多✓" + bDispTag : "多✗"
        string s = sDispValid ? "空✓" + sDispTag : "空✗"
        b + " / " + s

// ----- PO3 Power of Three：Accumulation → Manipulation → Distribution -----
// 視覺：累積區底色、操控區底色、派發前三角提示進場
int PO3_OFF = 0
int PO3_ACC = 1
int PO3_MAN = 2
int PO3_DIST = 3

float po3OpenRaw = request.security(syminfo.tickerid, po3Tf, open, barmerge.gaps_off, barmerge.lookahead_off)
bool po3NewPeriod = timeframe.change(po3Tf)

var int po3Phase = 0
var int po3Dir = 0
var float po3O = float(na)
var float po3AccHi = float(na)
var float po3AccLo = float(na)
var float po3ManExt = float(na)
var float po3ManInner = float(na)
var int po3AccBars = 0
var int po3AccStart = na
var int po3ManStart = na
var box po3AccBox = na
var box po3ManBox = na
var bool po3TipBuy = false
var bool po3TipSell = false

po3TipBuy := false
po3TipSell := false

if usePo3
    if po3NewPeriod or na(po3O)
        po3O := nz(po3OpenRaw, open)
        po3AccHi := high
        po3AccLo := low
        po3Phase := PO3_ACC
        po3Dir := 0
        po3ManExt := float(na)
        po3ManInner := float(na)
        po3AccBars := 1
        po3AccStart := bar_index
        po3ManStart := na
        po3AccBox := na
        po3ManBox := na
        if showPo3Zones
            po3AccBox := box.new(bar_index, high, bar_index, low, xloc=xloc.bar_index, bgcolor=po3AccCol, border_color=color.new(#1565c0, 40), border_width=1, text="累積", text_size=size.tiny, text_color=color.new(#0d47a1, 0))
    else if po3Phase == PO3_ACC
        bool goManDown = po3AccBars >= po3MinAccBars and not na(po3AccLo) and low < po3AccLo
        bool goManUp = po3AccBars >= po3MinAccBars and not na(po3AccHi) and high > po3AccHi
        if not goManDown and not goManUp and po3AccBars >= po3MinAccBars and not na(po3O)
            goManDown := low < po3O and low <= po3AccLo
            goManUp := high > po3O and high >= po3AccHi
        if goManDown
            po3Phase := PO3_MAN
            po3Dir := 1
            po3ManExt := low
            po3ManInner := po3AccLo
            po3ManStart := bar_index
            if showPo3Zones and not na(po3AccBox)
                box.set_right(po3AccBox, bar_index)
                box.set_top(po3AccBox, po3AccHi)
                box.set_bottom(po3AccBox, po3AccLo)
            if showPo3Zones
                po3ManBox := box.new(bar_index, math.max(po3ManInner, low), bar_index, math.min(po3ManInner, low), xloc=xloc.bar_index, bgcolor=po3ManCol, border_color=color.new(#c62828, 40), border_width=1, text="操控", text_size=size.tiny, text_color=color.new(#b71c1c, 0))
        else if goManUp
            po3Phase := PO3_MAN
            po3Dir := -1
            po3ManExt := high
            po3ManInner := po3AccHi
            po3ManStart := bar_index
            if showPo3Zones and not na(po3AccBox)
                box.set_right(po3AccBox, bar_index)
                box.set_top(po3AccBox, po3AccHi)
                box.set_bottom(po3AccBox, po3AccLo)
            if showPo3Zones
                po3ManBox := box.new(bar_index, math.max(po3ManInner, high), bar_index, math.min(po3ManInner, high), xloc=xloc.bar_index, bgcolor=po3ManCol, border_color=color.new(#c62828, 40), border_width=1, text="操控", text_size=size.tiny, text_color=color.new(#b71c1c, 0))
        else
            po3AccHi := math.max(po3AccHi, high)
            po3AccLo := math.min(po3AccLo, low)
            po3AccBars := po3AccBars + 1
            if showPo3Zones
                if na(po3AccBox)
                    po3AccBox := box.new(po3AccStart, po3AccHi, bar_index, po3AccLo, xloc=xloc.bar_index, bgcolor=po3AccCol, border_color=color.new(#1565c0, 40), border_width=1, text="累積", text_size=size.tiny, text_color=color.new(#0d47a1, 0))
                else
                    box.set_right(po3AccBox, bar_index)
                    box.set_top(po3AccBox, po3AccHi)
                    box.set_bottom(po3AccBox, po3AccLo)
    else if po3Phase == PO3_MAN
        if po3Dir > 0
            if not na(po3ManExt) and low < po3ManExt
                po3ManExt := low
            if showPo3Zones and not na(po3ManBox) and not na(po3ManInner)
                box.set_right(po3ManBox, bar_index)
                box.set_top(po3ManBox, po3ManInner)
                box.set_bottom(po3ManBox, po3ManExt)
            bool reclaim = close > po3O or (not na(po3AccHi) and close > po3AccHi)
            if reclaim and (f_isDisp(true) or close > open)
                po3Phase := PO3_DIST
                po3TipBuy := true
                if showPo3Zones and not na(po3ManBox)
                    box.set_right(po3ManBox, bar_index)
        else if po3Dir < 0
            if not na(po3ManExt) and high > po3ManExt
                po3ManExt := high
            if showPo3Zones and not na(po3ManBox) and not na(po3ManInner)
                box.set_right(po3ManBox, bar_index)
                box.set_top(po3ManBox, po3ManExt)
                box.set_bottom(po3ManBox, po3ManInner)
            bool reclaim = close < po3O or (not na(po3AccLo) and close < po3AccLo)
            if reclaim and (f_isDisp(false) or close < open)
                po3Phase := PO3_DIST
                po3TipSell := true
                if showPo3Zones and not na(po3ManBox)
                    box.set_right(po3ManBox, bar_index)

f_po3Name() =>
    if not usePo3
        "關閉"
    else
        switch po3Phase
            PO3_ACC => "①累積 ACC"
            PO3_MAN => po3Dir > 0 ? "②操控 MAN↓(偏多)" : po3Dir < 0 ? "②操控 MAN↑(偏空)" : "②操控 MAN"
            PO3_DIST => po3Dir > 0 ? "③派發 DIST↑" : po3Dir < 0 ? "③派發 DIST↓" : "③派發 DIST"
            => "待機"

f_po3Allows(bool isBuy) =>
    if not po3FilterOn
        true
    else if po3Phase != PO3_DIST or po3Dir == 0
        false
    else
        isBuy ? po3Dir > 0 : po3Dir < 0

// ----- ICT 演算法：Killzone時間 + IPDA區間 + 合流計分 -----
int hEt = hour(time, algoTz)
bool kzLondon = useLondonKz and hEt >= 2 and hEt < 5
bool kzNy = useNyKz and hEt >= 8 and hEt < 11
bool kzSb = useSilverBullet and hEt >= 10 and hEt < 11
bool inKillzone = kzLondon or kzNy or kzSb

f_kzName() =>
    kzSb ? "Silver Bullet" : kzNy ? "紐約KZ" : kzLondon ? "倫敦KZ" : "非Killzone"

// IPDA 20/40/60 日高低（用日線，取前一日完成值避免lookahead）
f_ipdaHL(int n) =>
    [ta.highest(high, n)[1], ta.lowest(low, n)[1]]

[ipda20H, ipda20L] = request.security(syminfo.tickerid, "D", f_ipdaHL(20), barmerge.gaps_off, barmerge.lookahead_off)
[ipda40H, ipda40L] = request.security(syminfo.tickerid, "D", f_ipdaHL(40), barmerge.gaps_off, barmerge.lookahead_off)
[ipda60H, ipda60L] = request.security(syminfo.tickerid, "D", f_ipdaHL(60), barmerge.gaps_off, barmerge.lookahead_off)

float ipdaNearHi = useIpda ? math.min(nz(ipda20H, 1e10), math.min(nz(ipda40H, 1e10), nz(ipda60H, 1e10))) : float(na)
float ipdaNearLo = useIpda ? math.max(nz(ipda20L, -1e10), math.max(nz(ipda40L, -1e10), nz(ipda60L, -1e10))) : float(na)
bool nearIpdaHi = useIpda and not na(ipdaNearHi) and ipdaNearHi < 1e10 and high >= ipdaNearHi
bool nearIpdaLo = useIpda and not na(ipdaNearLo) and ipdaNearLo > -1e10 and low <= ipdaNearLo

// ----- ④目標演算法：下一未掃流動性 / EQH-EQL / IPDA 對側 -----
var float algoBuyTarget = float(na)
var float algoSellTarget = float(na)
var string algoBuyTargetTag = "-"
var string algoSellTargetTag = "-"

f_nearestAbove(float[] pool, float px) =>
    float best = float(na)
    int n = array.size(pool)
    if n > 0
        for i = 0 to n - 1
            float lv = array.get(pool, i)
            if lv > px and (na(best) or lv < best)
                best := lv
    best

f_nearestBelow(float[] pool, float px) =>
    float best = float(na)
    int n = array.size(pool)
    if n > 0
        for i = 0 to n - 1
            float lv = array.get(pool, i)
            if lv < px and (na(best) or lv > best)
                best := lv
    best

f_eqhLevel(float px) =>
    // 兩個接近的樞紐高視為 EQH
    float best = float(na)
    int n = array.size(bslPool)
    float tol = nz(atrVal, 0.0) * eqTolAtr
    if n >= 2 and tol > 0.0
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                float a = array.get(bslPool, i)
                float b = array.get(bslPool, j)
                if math.abs(a - b) <= tol
                    float eq = (a + b) * 0.5
                    if eq > px and (na(best) or eq < best)
                        best := eq
    best

f_eqlLevel(float px) =>
    float best = float(na)
    int n = array.size(sslPool)
    float tol = nz(atrVal, 0.0) * eqTolAtr
    if n >= 2 and tol > 0.0
        for i = 0 to n - 2
            for j = i + 1 to n - 1
                float a = array.get(sslPool, i)
                float b = array.get(sslPool, j)
                if math.abs(a - b) <= tol
                    float eq = (a + b) * 0.5
                    if eq < px and (na(best) or eq > best)
                        best := eq
    best

f_ipdaAbove(float px) =>
    float best = float(na)
    if useIpda
        if not na(ipda20H) and ipda20H > px
            best := ipda20H
        if not na(ipda40H) and ipda40H > px and (na(best) or ipda40H < best)
            best := ipda40H
        if not na(ipda60H) and ipda60H > px and (na(best) or ipda60H < best)
            best := ipda60H
    best

f_ipdaBelow(float px) =>
    float best = float(na)
    if useIpda
        if not na(ipda20L) and ipda20L < px
            best := ipda20L
        if not na(ipda40L) and ipda40L < px and (na(best) or ipda40L > best)
            best := ipda40L
        if not na(ipda60L) and ipda60L < px and (na(best) or ipda60L > best)
            best := ipda60L
    best

f_pickBuyTarget(float entry) =>
    float unswept = f_nearestAbove(bslPool, entry)
    float eqh = f_eqhLevel(entry)
    float ipda = f_ipdaAbove(entry)
    float chosen = float(na)
    string tag = "-"
    if targetPriority == "僅未掃流動性"
        chosen := unswept
        tag := na(chosen) ? "-" : "未掃BSL"
    else if targetPriority == "僅EQH/EQL"
        chosen := eqh
        tag := na(chosen) ? "-" : "EQH"
    else if targetPriority == "僅IPDA對側"
        chosen := ipda
        tag := na(chosen) ? "-" : "IPDA"
    else
        if not na(unswept)
            chosen := unswept
            tag := "未掃BSL"
        else if not na(eqh)
            chosen := eqh
            tag := "EQH"
        else if not na(ipda)
            chosen := ipda
            tag := "IPDA"
    [chosen, tag]

f_pickSellTarget(float entry) =>
    float unswept = f_nearestBelow(sslPool, entry)
    float eql = f_eqlLevel(entry)
    float ipda = f_ipdaBelow(entry)
    float chosen = float(na)
    string tag = "-"
    if targetPriority == "僅未掃流動性"
        chosen := unswept
        tag := na(chosen) ? "-" : "未掃SSL"
    else if targetPriority == "僅EQH/EQL"
        chosen := eql
        tag := na(chosen) ? "-" : "EQL"
    else if targetPriority == "僅IPDA對側"
        chosen := ipda
        tag := na(chosen) ? "-" : "IPDA"
    else
        if not na(unswept)
            chosen := unswept
            tag := "未掃SSL"
        else if not na(eql)
            chosen := eql
            tag := "EQL"
        else if not na(ipda)
            chosen := ipda
            tag := "IPDA"
    [chosen, tag]

if useTargetAlgo
    [tBuy, tagBuy] = f_pickBuyTarget(close)
    [tSell, tagSell] = f_pickSellTarget(close)
    algoBuyTarget := tBuy
    algoBuyTargetTag := tagBuy
    algoSellTarget := tSell
    algoSellTargetTag := tagSell
else
    algoBuyTarget := float(na)
    algoSellTarget := float(na)
    algoBuyTargetTag := "-"
    algoSellTargetTag := "-"

f_targetAllows(bool isBuy) =>
    if not targetFilterOn or not targetRequireLevel
        true
    else
        isBuy ? not na(algoBuyTarget) : not na(algoSellTarget)

f_targetStatus() =>
    if not useTargetAlgo
        "關閉"
    else
        "多" + algoBuyTargetTag + " / 空" + algoSellTargetTag

f_algoScore(bool isBuy) =>
    int sc = 0
    if inKillzone
        sc += 1
    if f_htfAllows(isBuy)
        sc += 1
    if usePo3 and po3Phase == PO3_DIST and ((isBuy and po3Dir > 0) or (not isBuy and po3Dir < 0))
        sc += 1
    if useErlIrl and ((isBuy and dolDir > 0) or (not isBuy and dolDir < 0))
        sc += 1
    if useTimeAlgo and f_timeAllows(isBuy)
        sc += 1
    if useLiqAlgo and ((isBuy and sslSweptActive) or (not isBuy and bslSweptActive))
        sc += 1
    if useDispAlgo and ((isBuy and bDispValid) or (not isBuy and sDispValid))
        sc += 1
    if useTargetAlgo and ((isBuy and not na(algoBuyTarget)) or (not isBuy and not na(algoSellTarget)))
        sc += 1
    sc

f_modulesPass(bool isBuy) =>
    f_timeAllows(isBuy) and f_liqAllows(isBuy) and f_dispAllows(isBuy) and f_targetAllows(isBuy)

f_algoPass(bool isBuy) =>
    bool modOk = f_modulesPass(isBuy)
    if not useAlgo or not algoFilterOn
        modOk
    else
        bool tOk = not algoRequireKz or inKillzone
        bool hOk = not algoRequireHtf or f_htfAllows(isBuy)
        bool pOk = not algoRequirePo3Dist or (usePo3 and po3Phase == PO3_DIST and ((isBuy and po3Dir > 0) or (not isBuy and po3Dir < 0)))
        bool dOk = not algoRequireDol or (useErlIrl and ((isBuy and dolDir > 0) or (not isBuy and dolDir < 0)))
        bool scoreOk = f_algoScore(isBuy) >= algoMinScore
        modOk and tOk and hOk and pOk and dOk and scoreOk

f_algoStatus() =>
    if not useAlgo and not useTimeAlgo and not useLiqAlgo and not useDispAlgo and not useTargetAlgo
        "關閉"
    else
        int sb = f_algoScore(true)
        int ss = f_algoScore(false)
        int best = math.max(sb, ss)
        string side = sb > ss ? "偏多" : ss > sb ? "偏空" : "中性"
        bool modOk = f_modulesPass(true) or f_modulesPass(false)
        string gate = not modOk ? "模組擋" : algoFilterOn and best < algoMinScore ? "等待" : "模組OK"
        gate + " " + side + " " + str.tostring(best) + "/" + str.tostring(algoMinScore)

f_entryLevel(bool isBuy, float top, float bot, float manip, float expExtreme) =>
    float proximal = isBuy ? bot : top
    float mid = (top + bot) * 0.5
    float ote = isBuy ? (expExtreme - (expExtreme - manip) * 0.62) : (expExtreme + (manip - expExtreme) * 0.62)
    float result = mid
    if entryFill == "近端"
        result := proximal
    else if entryFill == "OTE62"
        bool oteInFvg = ote <= top and ote >= bot
        result := oteInFvg ? ote : mid
    result

// 盈虧顯示：畫面固定用「水平價位線 + linefill + 右上表格」
// （不用 box/label 貼在進場K上，移動圖表時不會跟蠟燭分離）
type TradeSetup
    int x1
    float entry
    float sl
    float tp
    bool isBuy
    string modeTxt

var TradeSetup[] trades = array.new<TradeSetup>()

f_registerSetup(bool isBuy, float entry, float sl, float tp, float fvgTop, float fvgBot, float accHi, float accLo, int accStartBar, int fvgBar, string modeTxt) =>
    float risk = math.abs(entry - sl)
    float reward = math.abs(tp - entry)
    float rr = risk > 0.0 ? reward / risk : 0.0
    array.push(trades, TradeSetup.new(bar_index, entry, sl, tp, isBuy, modeTxt))
    if array.size(trades) > 40
        array.shift(trades)
    rr

f_entryConfirmed(bool isBuy, float entry, float fvgTop, float fvgBot) =>
    bool tappedZone = isBuy ? (low <= fvgTop and high >= fvgBot) : (high >= fvgBot and low <= fvgTop)
    bool tappedCE = low <= entry and high >= entry
    bool closeInFvg = close <= fvgTop and close >= fvgBot
    bool closeBack = isBuy ? (close >= entry or close >= fvgBot) : (close <= entry or close <= fvgTop)
    bool dirOk = not requireBullBearClose or (isBuy ? close > open : close < open)
    bool ok = false
    if entryTrigger == "觸價可進場"
        ok := tappedZone or tappedCE
    else if entryTrigger == "收K進入失衡區"
        ok := closeInFvg and dirOk
    else
        ok := (tappedZone or tappedCE) and closeBack and dirOk
    ok

// ---- Buy state ----
var float bAccHi = float(na)
var float bAccLo = float(na)
var int bAccStartBar = 0
var int bAccStartTime = na
var int bAccCount = 0
var float bManip = float(na)
var int bExpBar = 0
var int bFvgBar = 0
var int bFvgTime = na
var float bFvgTop = float(na)
var float bFvgBot = float(na)
var float bExpExt = float(na)
var float bEntry = float(na)
var float bSL = float(na)
var float bTP = float(na)

// ---- Sell state ----
var float sAccHi = float(na)
var float sAccLo = float(na)
var int sAccStartBar = 0
var int sAccStartTime = na
var int sAccCount = 0
var float sManip = float(na)
var int sExpBar = 0
var int sFvgBar = 0
var int sFvgTime = na
var float sFvgTop = float(na)
var float sFvgBot = float(na)
var float sExpExt = float(na)
var float sEntry = float(na)
var float sSL = float(na)
var float sTP = float(na)

var bool buySignal = false
var bool sellSignal = false
var float buyRR = float(na)
var float sellRR = float(na)

buySignal := false
sellSignal := false

float candHi = ta.highest(high, lookback)
float candLo = ta.lowest(low, lookback)
bool candTight = not na(atrVal) and atrVal > 0.0 and not na(candHi) and not na(candLo) and (candHi - candLo) <= maxRangeAtrMult * atrVal and (candHi - candLo) > 0.0

bool runModel = entryModel == "MMXM第四階段" or entryModel == "ERT交易系統" or entryModel == "PO3派發進場" or entryModel == "ICT演算法"

if bar_index >= math.max(lookback, atrPeriod) and runModel
    // ===================== BUY =====================
    if bPhase == ENT or bPhase == INV
        bPhase := IDLE
        bAccHi := float(na)
        bAccLo := float(na)
        bAccCount := 0
        bManip := float(na)
        bExpBar := 0
        bFvgBar := 0
        bFvgTime := na
        bFvgTop := float(na)
        bFvgBot := float(na)
        bExpExt := float(na)
        bEntry := float(na)
        bSL := float(na)
        bTP := float(na)
        bDispValid := false
        bDispTag := "-"

    if bPhase == IDLE or bPhase == ACC
        if bPhase == ACC and bAccCount >= minAccBars and not na(bAccLo)
            float sweepDepth = bAccLo - low
            float minSweep = math.max(manipAtrMult * atrVal, minSweepOfRange * (bAccHi - bAccLo))
            if sweepDepth >= minSweep
                bPhase := MAN
                bManip := low
            else if candTight
                bAccCount := bAccCount + 1
            else
                bPhase := IDLE
                bAccHi := float(na)
                bAccLo := float(na)
                bAccCount := 0
                bManip := float(na)
                bExpBar := 0
                bFvgBar := 0
                bFvgTime := na
                bFvgTop := float(na)
                bFvgBot := float(na)
                bExpExt := float(na)
                bEntry := float(na)
                bSL := float(na)
                bTP := float(na)
        else if candTight
            if bPhase == IDLE or na(bAccLo)
                bPhase := ACC
                bAccHi := candHi
                bAccLo := candLo
                bAccStartBar := bar_index - lookback + 1
                bAccStartTime := time[lookback - 1]
                bAccCount := lookback
            else
                bAccHi := math.min(bAccHi, candHi)
                bAccLo := math.max(bAccLo, candLo)
                if bAccHi <= bAccLo
                    bAccHi := candHi
                    bAccLo := candLo
                bAccCount := bAccCount + 1
        else
            bPhase := IDLE
            bAccHi := float(na)
            bAccLo := float(na)
            bAccCount := 0
            bManip := float(na)
            bExpBar := 0
            bFvgBar := 0
            bFvgTime := na
            bFvgTop := float(na)
            bFvgBot := float(na)
            bExpExt := float(na)
            bEntry := float(na)
            bSL := float(na)
            bTP := float(na)

    else if bPhase == MAN
        if not na(bManip) and low < bManip
            bManip := low
        bool mssHit = close > bAccHi
        bool mssOk = not requireMss or mssHit
        bool cisdOk = f_cisdBull()
        bool structFlip = mssOk
        if useDispAlgo
            structFlip := (dispNeedMss and mssHit) or (dispNeedCisd and cisdOk)
            if not dispNeedMss and not dispNeedCisd
                structFlip := mssHit or cisdOk
        bool bullDisp = f_isDisp(true) and structFlip
        bool fvgNow = f_hasBullFvg()
        if bullDisp
            bPhase := EXP
            bExpBar := bar_index
            bExpExt := high
            bDispValid := not useDispAlgo
            bDispTag := (cisdOk ? "CISD" : "") + (mssHit ? (cisdOk ? "+MSS" : "MSS") : "")
            if fvgNow
                bFvgTop := f_bullFvgTop()
                bFvgBot := f_bullFvgBot()
                bFvgBar := bar_index
                bFvgTime := time
                if useDispAlgo
                    bDispValid := true
                    bDispTag := bDispTag + "+FVG"
        else if close < bAccLo - math.max(manipAtrMult * atrVal, bAccHi - bAccLo) * 1.5
            bPhase := INV

    else if bPhase == EXP
        if high > bExpExt
            bExpExt := high
        if na(bFvgTop) and f_hasBullFvg()
            bFvgTop := f_bullFvgTop()
            bFvgBot := f_bullFvgBot()
            bFvgBar := bar_index
            bFvgTime := time
            if useDispAlgo and bar_index - bExpBar <= dispFvgMaxBars
                bDispValid := true
                bDispTag := bDispTag + "+FVG"
        if useDispAlgo and dispRequireFvg and na(bFvgTop) and bar_index - bExpBar >= dispFvgMaxBars
            bPhase := INV
        else if not na(bFvgTop) and not na(bFvgBot) and not na(bManip)
            if useDispAlgo and dispRequireFvg and not bDispValid
                bPhase := INV
            else
                float entry = f_entryLevel(true, bFvgTop, bFvgBot, bManip, bExpExt)
                float sl = bManip - stopBufAtrMult * atrVal
                float risk = entry - sl
                float fixedTp = entry + risk * targetRR
                float depth = bAccHi - bManip
                float structTp = math.max(bAccHi + depth, bAccHi + (bAccHi - bAccLo))
                float tp = fixedTp
                if tpMode == "結構投射"
                    tp := structTp
                else if tpMode == "兩者取遠"
                    tp := math.max(fixedTp, structTp)
                if useTargetAlgo
                    [tAlgo, tTag] = f_pickBuyTarget(entry)
                    if not na(tAlgo) and tAlgo > entry
                        tp := tAlgo
                        algoBuyTarget := tAlgo
                        algoBuyTargetTag := tTag
                float reward = tp - entry
                float rr = risk > 0.0 ? reward / risk : 0.0
                if risk > 0.0 and reward > 0.0 and rr >= minRR and (not useDispAlgo or bDispValid or not dispRequireFvg)
                    bEntry := entry
                    bSL := sl
                    bTP := tp
                    bPhase := WAIT
                    if not useDispAlgo
                        bDispValid := true
                else
                    bPhase := INV
        else if bar_index - bExpBar >= math.max(3, dispFvgMaxBars)
            bPhase := INV

    else if bPhase == WAIT
        bool timedOut = bar_index - bFvgBar >= maxWaitBars
        bool stopped = close < bSL
        bool fvgBroken = close < bFvgBot
        if timedOut or stopped or fvgBroken
            bPhase := INV
        else if f_entryConfirmed(true, bEntry, bFvgTop, bFvgBot) and showBuy and f_htfAllows(true) and f_dolAllows(true) and f_po3Allows(true) and f_modulesPass(true) and f_algoPass(true)
            buySignal := true
            buyRR := f_registerSetup(true, bEntry, bSL, bTP, bFvgTop, bFvgBot, bAccHi, bAccLo, bAccStartBar, bFvgBar, entryTrigger)
            bPhase := ENT
            if useLiqAlgo
                lastSslSweepBar := na
                lastSslLevel := float(na)

    // ===================== SELL =====================
    if sPhase == ENT or sPhase == INV
        sPhase := IDLE
        sAccHi := float(na)
        sAccLo := float(na)
        sAccCount := 0
        sManip := float(na)
        sExpBar := 0
        sFvgBar := 0
        sFvgTime := na
        sFvgTop := float(na)
        sFvgBot := float(na)
        sExpExt := float(na)
        sEntry := float(na)
        sSL := float(na)
        sTP := float(na)
        sDispValid := false
        sDispTag := "-"

    if sPhase == IDLE or sPhase == ACC
        if sPhase == ACC and sAccCount >= minAccBars and not na(sAccHi)
            float sweepDepth = high - sAccHi
            float minSweep = math.max(manipAtrMult * atrVal, minSweepOfRange * (sAccHi - sAccLo))
            if sweepDepth >= minSweep
                sPhase := MAN
                sManip := high
            else if candTight
                sAccCount := sAccCount + 1
            else
                sPhase := IDLE
                sAccHi := float(na)
                sAccLo := float(na)
                sAccCount := 0
                sManip := float(na)
                sExpBar := 0
                sFvgBar := 0
                sFvgTime := na
                sFvgTop := float(na)
                sFvgBot := float(na)
                sExpExt := float(na)
                sEntry := float(na)
                sSL := float(na)
                sTP := float(na)
        else if candTight
            if sPhase == IDLE or na(sAccHi)
                sPhase := ACC
                sAccHi := candHi
                sAccLo := candLo
                sAccStartBar := bar_index - lookback + 1
                sAccStartTime := time[lookback - 1]
                sAccCount := lookback
            else
                sAccHi := math.min(sAccHi, candHi)
                sAccLo := math.max(sAccLo, candLo)
                if sAccHi <= sAccLo
                    sAccHi := candHi
                    sAccLo := candLo
                sAccCount := sAccCount + 1
        else
            sPhase := IDLE
            sAccHi := float(na)
            sAccLo := float(na)
            sAccCount := 0
            sManip := float(na)
            sExpBar := 0
            sFvgBar := 0
            sFvgTime := na
            sFvgTop := float(na)
            sFvgBot := float(na)
            sExpExt := float(na)
            sEntry := float(na)
            sSL := float(na)
            sTP := float(na)

    else if sPhase == MAN
        if not na(sManip) and high > sManip
            sManip := high
        bool mssHit = close < sAccLo
        bool mssOk = not requireMss or mssHit
        bool cisdOk = f_cisdBear()
        bool structFlip = mssOk
        if useDispAlgo
            structFlip := (dispNeedMss and mssHit) or (dispNeedCisd and cisdOk)
            if not dispNeedMss and not dispNeedCisd
                structFlip := mssHit or cisdOk
        bool bearDisp = f_isDisp(false) and structFlip
        bool fvgNow = f_hasBearFvg()
        if bearDisp
            sPhase := EXP
            sExpBar := bar_index
            sExpExt := low
            sDispValid := not useDispAlgo
            sDispTag := (cisdOk ? "CISD" : "") + (mssHit ? (cisdOk ? "+MSS" : "MSS") : "")
            if fvgNow
                sFvgTop := f_bearFvgTop()
                sFvgBot := f_bearFvgBot()
                sFvgBar := bar_index
                sFvgTime := time
                if useDispAlgo
                    sDispValid := true
                    sDispTag := sDispTag + "+FVG"
        else if close > sAccHi + math.max(manipAtrMult * atrVal, sAccHi - sAccLo) * 1.5
            sPhase := INV

    else if sPhase == EXP
        if low < sExpExt
            sExpExt := low
        if na(sFvgTop) and f_hasBearFvg()
            sFvgTop := f_bearFvgTop()
            sFvgBot := f_bearFvgBot()
            sFvgBar := bar_index
            sFvgTime := time
            if useDispAlgo and bar_index - sExpBar <= dispFvgMaxBars
                sDispValid := true
                sDispTag := sDispTag + "+FVG"
        if useDispAlgo and dispRequireFvg and na(sFvgTop) and bar_index - sExpBar >= dispFvgMaxBars
            sPhase := INV
        else if not na(sFvgTop) and not na(sFvgBot) and not na(sManip)
            if useDispAlgo and dispRequireFvg and not sDispValid
                sPhase := INV
            else
                float entry = f_entryLevel(false, sFvgTop, sFvgBot, sManip, sExpExt)
                float sl = sManip + stopBufAtrMult * atrVal
                float risk = sl - entry
                float fixedTp = entry - risk * targetRR
                float depth = sManip - sAccLo
                float structTp = math.min(sAccLo - depth, sAccLo - (sAccHi - sAccLo))
                float tp = fixedTp
                if tpMode == "結構投射"
                    tp := structTp
                else if tpMode == "兩者取遠"
                    tp := math.min(fixedTp, structTp)
                if useTargetAlgo
                    [tAlgoS, tTagS] = f_pickSellTarget(entry)
                    if not na(tAlgoS) and tAlgoS < entry
                        tp := tAlgoS
                        algoSellTarget := tAlgoS
                        algoSellTargetTag := tTagS
                float reward = entry - tp
                float rr = risk > 0.0 ? reward / risk : 0.0
                if risk > 0.0 and reward > 0.0 and rr >= minRR and (not useDispAlgo or sDispValid or not dispRequireFvg)
                    sEntry := entry
                    sSL := sl
                    sTP := tp
                    sPhase := WAIT
                    if not useDispAlgo
                        sDispValid := true
                else
                    sPhase := INV
        else if bar_index - sExpBar >= math.max(3, dispFvgMaxBars)
            sPhase := INV

    else if sPhase == WAIT
        bool timedOut = bar_index - sFvgBar >= maxWaitBars
        bool stopped = close > sSL
        bool fvgBroken = close > sFvgTop
        if timedOut or stopped or fvgBroken
            sPhase := INV
        else if f_entryConfirmed(false, sEntry, sFvgTop, sFvgBot) and showSell and f_htfAllows(false) and f_dolAllows(false) and f_po3Allows(false) and f_modulesPass(false) and f_algoPass(false)
            sellSignal := true
            sellRR := f_registerSetup(false, sEntry, sSL, sTP, sFvgTop, sFvgBot, sAccHi, sAccLo, sAccStartBar, sFvgBar, entryTrigger)
            sPhase := ENT
            if useLiqAlgo
                lastBslSweepBar := na
                lastBslLevel := float(na)

// ----- 反轉訊號 + 過濾系統 -----
// 原始結構：掃對側流動性 → CISD/位移（可選FVG/MSS）→ 反向進場
var int lastRevBuyBar = na
var int lastRevSellBar = na
var bool revBuySignal = false
var bool revSellSignal = false
var float revBuyRR = float(na)
var float revSellRR = float(na)
var string revStatus = "關閉"

revBuySignal := false
revSellSignal := false

float revSwingHi = ta.highest(high, revSwingLen)[1]
float revSwingLo = ta.lowest(low, revSwingLen)[1]
bool revMssBuy = not na(revSwingHi) and close > revSwingHi
bool revMssSell = not na(revSwingLo) and close < revSwingLo
bool revCisdBuy = f_cisdBull()
bool revCisdSell = f_cisdBear()
bool revDispBuy = f_isDisp(true)
bool revDispSell = f_isDisp(false)
bool revFvgBuy = f_hasBullFvg()
bool revFvgSell = f_hasBearFvg()
bool revLiqBuy = sslSweptActive or sslSweepNow
bool revLiqSell = bslSweptActive or bslSweepNow

f_revScore(bool isBuy) =>
    int sc = 0
    if isBuy ? revLiqBuy : revLiqSell
        sc += 1
    if isBuy ? revCisdBuy : revCisdSell
        sc += 1
    if isBuy ? revDispBuy : revDispSell
        sc += 1
    if isBuy ? revFvgBuy : revFvgSell
        sc += 1
    if isBuy ? revMssBuy : revMssSell
        sc += 1
    if f_htfAllows(isBuy)
        sc += 1
    if inKillzone
        sc += 1
    if f_timeAllows(isBuy)
        sc += 1
    sc

f_revHardPass(bool isBuy) =>
    bool ok = true
    if revFiltLiq
        ok := ok and (isBuy ? revLiqBuy : revLiqSell)
    if revFiltCisd
        ok := ok and (isBuy ? revCisdBuy : revCisdSell)
    if revFiltDisp
        ok := ok and (isBuy ? revDispBuy : revDispSell)
    if revFiltFvg
        ok := ok and (isBuy ? revFvgBuy : revFvgSell)
    if revFiltMss
        ok := ok and (isBuy ? revMssBuy : revMssSell)
    if revFiltHtf
        ok := ok and f_htfAllows(isBuy)
    if revFiltKz
        ok := ok and inKillzone
    if revFiltTime
        ok := ok and f_timeAllows(isBuy)
    if revFiltModules
        ok := ok and f_modulesPass(isBuy)
    ok and f_revScore(isBuy) >= revMinScore

f_revStatus() =>
    if not useRevSignal
        "關閉"
    else
        int sb = f_revScore(true)
        int ss = f_revScore(false)
        string side = sb > ss ? "偏多反轉" : ss > sb ? "偏空反轉" : "觀望"
        string gate = f_revHardPass(true) or f_revHardPass(false) ? "可觸發" : "過濾中"
        gate + " " + side + " " + str.tostring(math.max(sb, ss)) + "/" + str.tostring(revMinScore)

// 原始觸發：至少要有掃蕩跡象 + 結構切換之一（分數/硬過濾再收斂）
bool revBuyRaw = revLiqBuy and (revCisdBuy or revDispBuy or revMssBuy)
bool revSellRaw = revLiqSell and (revCisdSell or revDispSell or revMssSell)
bool revBuyCool = na(lastRevBuyBar) or bar_index - lastRevBuyBar >= revCooldown
bool revSellCool = na(lastRevSellBar) or bar_index - lastRevSellBar >= revCooldown
bool revBuyMutex = not revFiltMutex or not buySignal
bool revSellMutex = not revFiltMutex or not sellSignal

if useRevSignal and bar_index >= math.max(lookback, atrPeriod)
    if revBuyRaw and f_revHardPass(true) and revBuyCool and revBuyMutex and showBuy
        revBuySignal := true
        lastRevBuyBar := bar_index
        float entry = close
        float sl = (not na(lastSslLevel) ? math.min(low, lastSslLevel) : low) - revStopAtr * nz(atrVal, 0.0)
        float risk = entry - sl
        float tp = entry + risk * revTargetRR
        if useTargetAlgo
            [tAlgoR, tTagR] = f_pickBuyTarget(entry)
            if not na(tAlgoR) and tAlgoR > entry
                tp := tAlgoR
        if risk > 0.0 and tp > entry
            if revRegisterErt
                revBuyRR := f_registerSetup(true, entry, sl, tp, high, low, high, low, bar_index, bar_index, "反轉多")
            else
                revBuyRR := risk > 0.0 ? (tp - entry) / risk : float(na)
        // 消耗 SSL 掃蕩，避免連發
        if useLiqAlgo or revFiltLiq
            lastSslSweepBar := na
            lastSslLevel := float(na)

    if revSellRaw and f_revHardPass(false) and revSellCool and revSellMutex and showSell and not revBuySignal
        revSellSignal := true
        lastRevSellBar := bar_index
        float entry = close
        float sl = (not na(lastBslLevel) ? math.max(high, lastBslLevel) : high) + revStopAtr * nz(atrVal, 0.0)
        float risk = sl - entry
        float tp = entry - risk * revTargetRR
        if useTargetAlgo
            [tAlgoRs, tTagRs] = f_pickSellTarget(entry)
            if not na(tAlgoRs) and tAlgoRs < entry
                tp := tAlgoRs
        if risk > 0.0 and tp < entry
            if revRegisterErt
                revSellRR := f_registerSetup(false, entry, sl, tp, high, low, high, low, bar_index, bar_index, "反轉空")
            else
                revSellRR := risk > 0.0 ? (entry - tp) / risk : float(na)
        if useLiqAlgo or revFiltLiq
            lastBslSweepBar := na
            lastBslLevel := float(na)

revStatus := f_revStatus()

// ---- 最新訊號數值（只給右上表用；圖上不畫滿版線）----
float lastEntry = float(na)
float lastSl = float(na)
float lastTp = float(na)
float lastT1 = float(na)
float lastRr = float(na)
bool lastIsBuy = false
string lastSide = "-"

if array.size(trades) > 0
    TradeSetup lastT = array.get(trades, array.size(trades) - 1)
    lastEntry := lastT.entry
    lastSl := lastT.sl
    lastTp := lastT.tp
    float lastRisk = math.abs(lastT.entry - lastT.sl)
    lastT1 := lastT.isBuy ? lastT.entry + lastRisk * ertT1RR : lastT.entry - lastRisk * ertT1RR
    lastRr := lastRisk > 0.0 ? math.abs(lastT.tp - lastT.entry) / lastRisk : float(na)
    lastIsBuy := lastT.isBuy
    lastSide := lastT.isBuy ? "作多" : "作空"

// 可選：進場附近短色帶（預設關，避免整圖亂）
float rrEntry = float(na)
float rrSl = float(na)
float rrTp = float(na)
bool rrOn = false
bool rrIsBuy = false
if showRrBoxes and array.size(trades) > 0
    for i = 0 to array.size(trades) - 1
        TradeSetup t = array.get(trades, i)
        if bar_index >= t.x1 and bar_index <= t.x1 + boxBars
            rrEntry := t.entry
            rrSl := t.sl
            rrTp := t.tp
            rrOn := true
            rrIsBuy := t.isBuy

plotE = plot(rrOn ? rrEntry : na, title="E區", color=color.new(color.teal, 100), style=plot.style_linebr)
plotR = plot(rrOn ? rrSl : na, title="R區", color=color.new(color.red, 100), style=plot.style_linebr)
plotT = plot(rrOn ? rrTp : na, title="T區", color=color.new(color.lime, 100), style=plot.style_linebr)
fill(plotE, plotR, title="風險區", color=rrOn ? (rrIsBuy ? buyRiskCol : sellRiskCol) : na)
fill(plotE, plotT, title="目標區", color=rrOn ? (rrIsBuy ? buyRewardCol : sellRewardCol) : na)

bgcolor(showPending and bPhase == WAIT ? color.new(#ffca28, 90) : na, title="等待作多回踩")
bgcolor(showPending and sPhase == WAIT ? color.new(#ffb300, 90) : na, title="等待作空回踩")
bgcolor(showKzBg and useAlgo and inKillzone ? color.new(#7e57c2, 92) : na, title="Killzone")

// IPDA 線（預設關）
var line lnIpda20H = na
var line lnIpda20L = na
var line lnIpda40H = na
var line lnIpda40L = na
var line lnIpda60H = na
var line lnIpda60L = na
if barstate.islast and useIpda and showIpdaLines
    if not na(lnIpda20H)
        line.delete(lnIpda20H)
    if not na(lnIpda20L)
        line.delete(lnIpda20L)
    if not na(lnIpda40H)
        line.delete(lnIpda40H)
    if not na(lnIpda40L)
        line.delete(lnIpda40L)
    if not na(lnIpda60H)
        line.delete(lnIpda60H)
    if not na(lnIpda60L)
        line.delete(lnIpda60L)
    int xL = math.max(bar_index - 50, 0)
    int xR = bar_index + 5
    if not na(ipda20H)
        lnIpda20H := line.new(xL, ipda20H, xR, ipda20H, color=color.new(#90caf9, 0), width=1, style=line.style_dotted, extend=extend.right)
    if not na(ipda20L)
        lnIpda20L := line.new(xL, ipda20L, xR, ipda20L, color=color.new(#90caf9, 0), width=1, style=line.style_dotted, extend=extend.right)
    if not na(ipda40H)
        lnIpda40H := line.new(xL, ipda40H, xR, ipda40H, color=color.new(#64b5f6, 0), width=1, style=line.style_dotted, extend=extend.right)
    if not na(ipda40L)
        lnIpda40L := line.new(xL, ipda40L, xR, ipda40L, color=color.new(#64b5f6, 0), width=1, style=line.style_dotted, extend=extend.right)
    if not na(ipda60H)
        lnIpda60H := line.new(xL, ipda60H, xR, ipda60H, color=color.new(#1976d2, 0), width=1, style=line.style_dotted, extend=extend.right)
    if not na(ipda60L)
        lnIpda60L := line.new(xL, ipda60L, xR, ipda60L, color=color.new(#1976d2, 0), width=1, style=line.style_dotted, extend=extend.right)

// PO3：派發前三角提示（操控結束、即將派發）
plotshape(showPo3Tip and usePo3 and po3TipBuy, title="PO3派發前提示多", style=shape.triangleup, location=location.belowbar, color=color.new(#00897b, 0), size=size.normal, text="派發進場")
plotshape(showPo3Tip and usePo3 and po3TipSell, title="PO3派發前提示空", style=shape.triangledown, location=location.abovebar, color=color.new(#e65100, 0), size=size.normal, text="派發進場")

// BSL/SSL 掃蕩標記（預設關）
plotshape(showLiqSweepMark and useLiqAlgo and sslSweepNow, title="SSL掃蕩", style=shape.diamond, location=location.belowbar, color=color.new(#26a69a, 0), size=size.tiny, text="SSL")
plotshape(showLiqSweepMark and useLiqAlgo and bslSweepNow, title="BSL掃蕩", style=shape.diamond, location=location.abovebar, color=color.new(#ef5350, 0), size=size.tiny, text="BSL")

plotshape(showMarkers and showBuy and buySignal and isAlgoMode, title="演算法作多", style=shape.triangleup, location=location.belowbar, color=color.new(#6a1b9a, 0), size=size.small, text="ALG多")
plotshape(showMarkers and showBuy and buySignal and isPo3Mode, title="PO3作多", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="PO3多")
plotshape(showMarkers and showBuy and buySignal and isErtMode, title="ERT作多", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="E多")
plotshape(showMarkers and showBuy and buySignal and not isErtMode and not isPo3Mode and not isAlgoMode, title="作多進場", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="作多")
plotshape(showMarkers and showSell and sellSignal and isAlgoMode, title="演算法作空", style=shape.triangledown, location=location.abovebar, color=color.new(#6a1b9a, 0), size=size.small, text="ALG空")
plotshape(showMarkers and showSell and sellSignal and isPo3Mode, title="PO3作空", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="PO3空")
plotshape(showMarkers and showSell and sellSignal and isErtMode, title="ERT作空", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="E空")
plotshape(showMarkers and showSell and sellSignal and not isErtMode and not isPo3Mode and not isAlgoMode, title="作空進場", style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 0), size=size.small, text="作空")

// 反轉訊號標記
plotshape(showRevMarkers and useRevSignal and revBuySignal, title="反轉作多", style=shape.labelup, location=location.belowbar, color=color.new(#1565c0, 0), size=size.small, text="反轉多", textcolor=color.white)
plotshape(showRevMarkers and useRevSignal and revSellSignal, title="反轉作空", style=shape.labeldown, location=location.abovebar, color=color.new(#c62828, 0), size=size.small, text="反轉空", textcolor=color.white)

// 右上表：四大模組 + 反轉 + 盈虧
var table info = table.new(position.top_right, 2, 19, bgcolor=color.new(#111111, 15), border_width=1, border_color=color.gray)
if showInfoTable and barstate.islast
    color algoCol = algoFilterOn and math.max(f_algoScore(true), f_algoScore(false)) >= algoMinScore ? color.lime : color.orange
    color timeCol = useTimeAlgo and (timeContBuy or timeContSell) ? color.lime : useTimeAlgo ? color.orange : color.gray
    color liqCol = sslSweptActive ? color.teal : bslSweptActive ? color.orange : useLiqAlgo ? color.gray : color.gray
    color dispCol = useDispAlgo and (bDispValid or sDispValid) ? color.lime : useDispAlgo ? color.orange : color.gray
    color tgtCol = useTargetAlgo and (not na(algoBuyTarget) or not na(algoSellTarget)) ? color.lime : useTargetAlgo ? color.orange : color.gray
    color revCol = revBuySignal or revSellSignal ? color.lime : useRevSignal and (f_revHardPass(true) or f_revHardPass(false)) ? color.aqua : useRevSignal ? color.orange : color.gray
    color po3Col = po3Phase == PO3_DIST ? color.lime : po3Phase == PO3_MAN ? color.orange : po3Phase == PO3_ACC ? color.aqua : color.gray
    color dolCol = dolDir > 0 ? color.teal : dolDir < 0 ? color.orange : color.gray
    table.cell(info, 0, 0, "合流", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, f_algoStatus(), text_color=algoCol, text_size=size.small)
    table.cell(info, 0, 1, "①時間", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 1, f_timeStatus(), text_color=timeCol, text_size=size.small)
    table.cell(info, 0, 2, "②流動性", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 2, f_liqStatus(), text_color=liqCol, text_size=size.small)
    table.cell(info, 0, 3, "③位移", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 3, f_dispStatus(), text_color=dispCol, text_size=size.small)
    table.cell(info, 0, 4, "④目標", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 4, f_targetStatus(), text_color=tgtCol, text_size=size.small)
    table.cell(info, 0, 5, "反轉", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 5, revStatus, text_color=revCol, text_size=size.small)
    table.cell(info, 0, 6, "Killzone", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 6, f_kzName(), text_color=inKillzone ? color.lime : color.gray, text_size=size.tiny)
    table.cell(info, 0, 7, "PO3", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 7, f_po3Name(), text_color=po3Col, text_size=size.small)
    table.cell(info, 0, 8, "路徑", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 8, f_dolPathName(), text_color=dolCol, text_size=size.small)
    table.cell(info, 0, 9, "E", text_color=color.aqua, text_size=size.small)
    table.cell(info, 1, 9, not na(lastEntry) ? f_px(lastEntry) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 10, "R", text_color=color.red, text_size=size.small)
    table.cell(info, 1, 10, not na(lastSl) ? f_px(lastSl) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 11, "T1", text_color=color.yellow, text_size=size.small)
    table.cell(info, 1, 11, not na(lastT1) ? f_px(lastT1) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 12, "T2", text_color=color.lime, text_size=size.small)
    table.cell(info, 1, 12, not na(lastTp) ? f_px(lastTp) : "-", text_color=color.white, text_size=size.small)
    table.cell(info, 0, 13, "RR", text_color=color.gray, text_size=size.small)
    table.cell(info, 1, 13, not na(lastRr) ? "1:" + str.tostring(lastRr, "#.##") : "-", text_color=color.lime, text_size=size.small)
    table.cell(info, 0, 14, "HTF", text_color=color.gray, text_size=size.tiny)
    color htfCol = htfBias > 0 ? color.teal : htfBias < 0 ? color.orange : color.gray
    table.cell(info, 1, 14, htfFilterOn ? f_htfName(htfBias) : "關", text_color=htfCol, text_size=size.tiny)
    table.cell(info, 0, 15, "多階段", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 15, f_phaseName(bPhase), text_color=color.teal, text_size=size.tiny)
    table.cell(info, 0, 16, "空階段", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 16, f_phaseName(sPhase), text_color=color.orange, text_size=size.tiny)
    table.cell(info, 0, 17, "掃蕩時效", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 17, f_liqAge(), text_color=liqCol, text_size=size.tiny)
    table.cell(info, 0, 18, "模型", text_color=color.gray, text_size=size.tiny)
    table.cell(info, 1, 18, showErtChecklist ? entryModel : "-", text_color=color.aqua, text_size=size.tiny)

alertcondition(buySignal, "作多進場", "ICT 演算法/MMXM 作多進場")
alertcondition(sellSignal, "作空進場", "ICT 演算法/MMXM 作空進場")
alertcondition(revBuySignal, "反轉作多", "反轉訊號：流動性掃蕩後作多反轉（已過過濾）")
alertcondition(revSellSignal, "反轉作空", "反轉訊號：流動性掃蕩後作空反轉（已過過濾）")
alertcondition(po3TipBuy, "PO3派發進場多", "PO3 操控結束，派發前提示作多")
alertcondition(po3TipSell, "PO3派發進場空", "PO3 操控結束，派發前提示作空")
alertcondition(useAlgo and inKillzone, "Killzone開啟", "目前位於ICT Killzone")
alertcondition(useTimeAlgo and timeContBuy, "時間延續多", "時間演算法：Asia Judas 後倫敦/紐約延續偏多")
alertcondition(useTimeAlgo and timeContSell, "時間延續空", "時間演算法：Asia Judas 後倫敦/紐約延續偏空")
alertcondition(useLiqAlgo and sslSweepNow, "SSL掃蕩", "流動性演算法：已掃 SSL（偏多條件）")
alertcondition(useLiqAlgo and bslSweepNow, "BSL掃蕩", "流動性演算法：已掃 BSL（偏空條件）")
alertcondition(useErlIrl and dolPhase == 1 and dolDir != 0, "ERL→IRL", "流動性路徑：ERL→IRL")
alertcondition(useErlIrl and dolPhase == 2 and dolDir != 0, "IRL→ERL", "流動性路徑：IRL→ERL")
