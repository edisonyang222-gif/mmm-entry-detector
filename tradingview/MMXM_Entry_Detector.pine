//@version=6
indicator("MMXM 進場偵測器", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=500)

// ICT Market Maker Model 進場偵測
// 流程：HTF 偏向 → LTF 累積 → 掃蕩 → 擴張/MSS + FVG → 第四階段回踩進場
// ERT 交易系統：Entry（進場）/ Risk（風險停損）/ Target（T1·T2 目標）
// 時區無關（只看 OHLC）。禁止在函式內改全域變數（CE10088）。

// ===== ICT 進場模型 =====
string entryModel = input.string("ICT演算法", "進場模型", options=["MMXM第四階段", "ERT交易系統", "PO3派發進場", "ICT演算法"], group="ICT進場模型", tooltip="ICT演算法=四大模組可勾選合流。請在「四大演算法模組」勾選要啟用的規則。")
string entryFill  = input.string("中點CE", "進場參考價", options=["中點CE", "近端", "OTE62"], group="ICT進場模型", tooltip="中點CE=FVG 50%；近端=先碰到的FVG邊界；OTE62=位移腿 62% 回撤（若落在FVG內優先，否則用中點）")
string entryTrigger = input.string("收K確認進場", "進場確認方式", options=["觸價可進場", "收K確認進場", "收K進入失衡區"], group="ICT進場模型", tooltip="觸價可進場=影線碰到即可（偏限價）；收K確認進場=碰到後收盤回到進場側；收K進入失衡區=收盤落入FVG內才算")
bool   requireMss = input.bool(true, "需要結構突破MSS（收破累積區間）", group="ICT進場模型")
bool   requireBullBearClose = input.bool(true, "收K確認時需同向收盤（多收陽/空收陰）", group="ICT進場模型")

// ===== 四大演算法模組（各自勾選啟用）=====
bool useTimeAlgo = input.bool(true, "①時間演算法 Asia→Judas→London/NY", group="四大演算法模組", tooltip="亞洲區間 → Judas假突破 → 倫敦/紐約延續，才允許該方向進場")
bool useLiqAlgo = input.bool(true, "②流動性演算法 BSL/SSL", group="四大演算法模組", tooltip="多需先掃SSL、空需先掃BSL，掃蕩後才允許進場")
bool useDispAlgo = input.bool(true, "③位移演算法 CISD/MSS+FVG", group="四大演算法模組", tooltip="需 CISD 或 MSS，且位移腿出現 FVG 才算有效結構")
bool useTargetAlgo = input.bool(true, "④目標演算法 未掃流動性/EQH-EQL/IPDA", group="四大演算法模組", tooltip="停利優先：下一未掃流動性 → EQH/EQL → IPDA對側")

// ===== ①時間演算法 =====
string timeTz = input.string("America/New_York", "時間演算法時區", options=["America/New_York", "America/Chicago", "Europe/London", "Asia/Taipei", "UTC"], group="①時間演算法")
int    asiaStartH = input.int(20, "Asia開始小時", minval=0, maxval=23, group="①時間演算法", tooltip="ICT常見：紐約20:00開始亞洲區間")
int    asiaEndH = input.int(0, "Asia結束小時", minval=0, maxval=23, group="①時間演算法", tooltip="ICT常見：紐約00:00結束")
int    judasStartH = input.int(2, "Judas視窗起", minval=0, maxval=23, group="①時間演算法")
int    judasEndH = input.int(5, "Judas視窗迄", minval=0, maxval=23, group="①時間演算法")
bool   timeRequireReclaim = input.bool(true, "Judas需收回收復Asia邊", group="①時間演算法")
bool   timeContLondon = input.bool(true, "延續允許倫敦KZ 02–05", group="①時間演算法")
bool   timeContNy = input.bool(true, "延續允許紐約KZ 08–11", group="①時間演算法")
bool   showAsiaBox = input.bool(false, "顯示Asia區間（可選）", group="①時間演算法")

// ===== ②流動性演算法 BSL / SSL =====
int    liqPivotLen = input.int(5, "流動性樞紐左右根數", minval=2, maxval=20, group="②流動性演算法BSL/SSL", tooltip="樞紐高低點形成 BSL/SSL 池")
int    liqMaxLevels = input.int(8, "追蹤流動性池數量", minval=2, maxval=30, group="②流動性演算法BSL/SSL")
int    liqValidBars = input.int(50, "掃蕩有效根數", minval=5, maxval=300, group="②流動性演算法BSL/SSL", tooltip="掃蕩後超過此根數未進場則失效")
bool   liqRequireReclaim = input.bool(true, "掃蕩後需收回收復水位", group="②流動性演算法BSL/SSL", tooltip="影線掃破後收盤收回水位才算有效掃蕩（Judas）")
bool   liqClearOpposite = input.bool(true, "新掃蕩清除對側狀態", group="②流動性演算法BSL/SSL")
bool   showLiqSweepMark = input.bool(false, "顯示掃蕩標記（可選）", group="②流動性演算法BSL/SSL")

// ===== ③位移演算法 =====
bool   dispNeedCisd = input.bool(true, "接受CISD作為結構切換", group="③位移演算法", tooltip="Change in State of Delivery")
bool   dispNeedMss = input.bool(true, "接受MSS作為結構切換", group="③位移演算法", tooltip="收破累積區間")
bool   dispRequireFvg = input.bool(true, "位移腿必須出現FVG", group="③位移演算法")
int    dispFvgMaxBars = input.int(3, "位移後最多幾根內出FVG", minval=1, maxval=10, group="③位移演算法")

// ===== ④目標演算法 =====
string targetPriority = input.string("未掃流動性→EQ→IPDA", "目標優先序", options=["未掃流動性→EQ→IPDA", "僅未掃流動性", "僅EQH/EQL", "僅IPDA對側"], group="④目標演算法")
float  eqTolAtr = input.float(0.15, "EQH/EQL容差（×ATR）", minval=0.01, step=0.05, group="④目標演算法")
bool   targetRequireLevel = input.bool(false, "進場需已算出演算法目標", group="④目標演算法", tooltip="開啟後：找不到未掃/EQ/IPDA目標則不進場")

// ===== 反轉訊號 + 過濾系統 =====
bool   useRevSignal = input.bool(true, "啟用反轉訊號", group="反轉訊號", tooltip="流動性掃蕩後 CISD/位移 反轉；獨立於 MMXM 延續進場")
bool   showRevMarkers = input.bool(true, "顯示反轉標記", group="反轉訊號")
bool   revRegisterErt = input.bool(true, "反轉寫入E/R/T表", group="反轉訊號")
int    revSwingLen = input.int(5, "反轉結構回看根數", minval=2, maxval=30, group="反轉訊號")
int    revCooldown = input.int(12, "反轉冷卻根數", minval=1, maxval=100, group="反轉訊號", tooltip="同向反轉訊號最短間隔")
float  revStopAtr = input.float(0.2, "反轉停損緩衝（×ATR）", minval=0.0, step=0.05, group="反轉訊號")
