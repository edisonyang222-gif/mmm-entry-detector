//@version=6
indicator("MMXM Entry Detector", overlay=true, max_labels_count=500, max_lines_count=500)

// ICT Market Maker Model entry detector
// Phases: Accumulation -> Manipulation (SSL/BSL) -> Expansion -> FVG Entry

int   lookback        = input.int(20, "Accumulation Lookback", minval=5)
int   atrPeriod       = input.int(14, "ATR Period", minval=1)
float maxRangeAtrMult = input.float(3.5, "Max Range ATR Mult", minval=0.1, step=0.1)
float manipAtrMult    = input.float(0.3, "Manipulation ATR Mult", minval=0.0, step=0.05)
float dispBodyRatio   = input.float(0.65, "Displacement Body Ratio", minval=0.1, maxval=1.0, step=0.05)
float dispAtrMult     = input.float(0.8, "Displacement ATR Mult", minval=0.1, step=0.1)
float minRR           = input.float(1.5, "Min Risk/Reward", minval=0.1, step=0.1)
float stopBufAtrMult  = input.float(0.05, "Stop Buffer ATR Mult", minval=0.0, step=0.01)
string entryFill      = input.string("midpoint", "Entry Fill", options=["midpoint", "proximal", "distal"])
bool  showBuy         = input.bool(true, "Show Buy Model (MMBM)")
bool  showSell        = input.bool(true, "Show Sell Model (MMSM)")
bool  showLevels      = input.bool(true, "Show Entry/SL/TP Lines")

float atrVal    = ta.atr(atrPeriod)
float rangeHigh = ta.highest(high, lookback)
float rangeLow  = ta.lowest(low, lookback)

// phases
int IDLE = 0
int ACC  = 1
int MAN  = 2
int EXP  = 3
int ENT  = 4
int INV  = 5

f_isDisp(bool bull) =>
    float rng = high - low
    float body = math.abs(close - open)
    bool ok = rng > 0.0 and not na(atrVal) and atrVal > 0.0 and body / rng >= dispBodyRatio and rng >= dispAtrMult * atrVal
    ok and (bull ? close > open : close < open)

f_fvgTop(bool bull) =>
    float result = bull ? low : low[2]
    result

f_fvgBot(bool bull) =>
    float result = bull ? high[2] : high
    result

f_hasFvg(bool bull) =>
    bull ? low > high[2] : high < low[2]

f_entryFromFvg(bool bull, float top, float bot) =>
    float proximal = bull ? bot : top
    float distal   = bull ? top : bot
    float mid      = (top + bot) * 0.5
    float result = entryFill == "proximal" ? proximal : entryFill == "distal" ? distal : mid
    result

// Buy state
var int   bPhase = IDLE
var float bAccHi = float(na)
var float bAccLo = float(na)
var float bManip = float(na)
var int   bExpBar = 0
var float bFvgTop = float(na)
var float bFvgBot = float(na)

// Sell state
var int   sPhase = IDLE
var float sAccHi = float(na)
var float sAccLo = float(na)
var float sManip = float(na)
var int   sExpBar = 0
var float sFvgTop = float(na)
var float sFvgBot = float(na)

var bool  buySignal = false
var bool  sellSignal = false
var float buyEntry = float(na)
var float buySL = float(na)
var float buyTP = float(na)
var float sellEntry = float(na)
var float sellSL = float(na)
var float sellTP = float(na)

buySignal := false
sellSignal := false
buyEntry := float(na)
buySL := float(na)
buyTP := float(na)
sellEntry := float(na)
sellSL := float(na)
sellTP := float(na)

bool isTight = not na(atrVal) and atrVal > 0.0 and not na(rangeHigh) and not na(rangeLow) and (rangeHigh - rangeLow) <= maxRangeAtrMult * atrVal

// -------- BUY MODEL --------
if bar_index >= math.max(lookback, atrPeriod)
    if bPhase == ENT or bPhase == INV
        bPhase := IDLE
        bAccHi := float(na)
        bAccLo := float(na)
        bManip := float(na)
        bExpBar := 0
        bFvgTop := float(na)
        bFvgBot := float(na)

    float bFrozenHi = bAccHi
    float bFrozenLo = bAccLo

    if bPhase == IDLE or bPhase == ACC
        if bPhase == ACC and not na(bFrozenLo) and low < bFrozenLo - manipAtrMult * atrVal
            bPhase := MAN
            bManip := low
            bAccHi := bFrozenHi
            bAccLo := bFrozenLo
        else if isTight
            bPhase := ACC
            bAccHi := rangeHigh
            bAccLo := rangeLow
        else
            bPhase := IDLE
            bAccHi := float(na)
            bAccLo := float(na)
    else if bPhase == MAN
        if not na(bManip) and low < bManip
            bManip := low
        bool bullDisp = f_isDisp(true) and not na(bAccHi) and close > bAccHi
        if bullDisp
            bPhase := EXP
            bExpBar := bar_index
            if f_hasFvg(true)
                bFvgTop := f_fvgTop(true)
                bFvgBot := f_fvgBot(true)
        else if not na(bAccLo) and close < bAccLo - manipAtrMult * atrVal * 3.0
            bPhase := INV
    else if bPhase == EXP
        if na(bFvgTop) and f_hasFvg(true)
            bFvgTop := f_fvgTop(true)
            bFvgBot := f_fvgBot(true)
        if not na(bFvgTop) and not na(bFvgBot) and not na(bManip) and not na(bAccHi) and not na(bAccLo)
            float e1 = f_entryFromFvg(true, bFvgTop, bFvgBot)
            float e2 = bFvgBot
            float buf = stopBufAtrMult * atrVal
            float sl = bManip - buf
            float depth = bAccHi - bManip
            float tp = math.max(bAccHi + depth, bAccHi + (bAccHi - bAccLo))
            float rr1 = (e1 - sl) > 0.0 ? (tp - e1) / (e1 - sl) : 0.0
            float rr2 = (e2 - sl) > 0.0 ? (tp - e2) / (e2 - sl) : 0.0
            if rr1 >= minRR
                buySignal := true
                buyEntry := e1
                buySL := sl
                buyTP := tp
                bPhase := ENT
            else if rr2 >= minRR
                buySignal := true
                buyEntry := e2
                buySL := sl
                buyTP := tp
                bPhase := ENT
            else
                bPhase := INV
        else if bar_index - bExpBar >= 3
            bPhase := INV

// -------- SELL MODEL --------
if bar_index >= math.max(lookback, atrPeriod)
    if sPhase == ENT or sPhase == INV
        sPhase := IDLE
        sAccHi := float(na)
        sAccLo := float(na)
        sManip := float(na)
        sExpBar := 0
        sFvgTop := float(na)
        sFvgBot := float(na)

    float sFrozenHi = sAccHi
    float sFrozenLo = sAccLo

    if sPhase == IDLE or sPhase == ACC
        if sPhase == ACC and not na(sFrozenHi) and high > sFrozenHi + manipAtrMult * atrVal
            sPhase := MAN
            sManip := high
            sAccHi := sFrozenHi
            sAccLo := sFrozenLo
        else if isTight
            sPhase := ACC
            sAccHi := rangeHigh
            sAccLo := rangeLow
        else
            sPhase := IDLE
            sAccHi := float(na)
            sAccLo := float(na)
    else if sPhase == MAN
        if not na(sManip) and high > sManip
            sManip := high
        bool bearDisp = f_isDisp(false) and not na(sAccLo) and close < sAccLo
        if bearDisp
            sPhase := EXP
            sExpBar := bar_index
            if f_hasFvg(false)
                sFvgTop := f_fvgTop(false)
                sFvgBot := f_fvgBot(false)
        else if not na(sAccHi) and close > sAccHi + manipAtrMult * atrVal * 3.0
            sPhase := INV
    else if sPhase == EXP
        if na(sFvgTop) and f_hasFvg(false)
            sFvgTop := f_fvgTop(false)
            sFvgBot := f_fvgBot(false)
        if not na(sFvgTop) and not na(sFvgBot) and not na(sManip) and not na(sAccHi) and not na(sAccLo)
            float e1 = f_entryFromFvg(false, sFvgTop, sFvgBot)
            float e2 = sFvgTop
            float buf = stopBufAtrMult * atrVal
            float sl = sManip + buf
            float depth = sManip - sAccLo
            float tp = math.min(sAccLo - depth, sAccLo - (sAccHi - sAccLo))
            float rr1 = (sl - e1) > 0.0 ? (e1 - tp) / (sl - e1) : 0.0
            float rr2 = (sl - e2) > 0.0 ? (e2 - tp) / (sl - e2) : 0.0
            if rr1 >= minRR
                sellSignal := true
                sellEntry := e1
                sellSL := sl
                sellTP := tp
                sPhase := ENT
            else if rr2 >= minRR
                sellSignal := true
                sellEntry := e2
                sellSL := sl
                sellTP := tp
                sPhase := ENT
            else
                sPhase := INV
        else if bar_index - sExpBar >= 3
            sPhase := INV

plotshape(showBuy and buySignal, title="MMBM Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="MMBM")
plotshape(showSell and sellSignal, title="MMSM Entry", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="MMSM")

if showLevels and buySignal and not na(buyEntry) and not na(buySL) and not na(buyTP)
    line.new(bar_index, buyEntry, bar_index + 8, buyEntry, color=color.teal, width=1)
    line.new(bar_index, buySL, bar_index + 8, buySL, color=color.red, width=1, style=line.style_dotted)
    line.new(bar_index, buyTP, bar_index + 8, buyTP, color=color.green, width=1, style=line.style_dotted)
    label.new(bar_index, buyEntry, "Buy " + str.tostring(buyEntry, format.mintick), style=label.style_label_up, color=color.new(color.teal, 70), textcolor=color.white, size=size.tiny)

if showLevels and sellSignal and not na(sellEntry) and not na(sellSL) and not na(sellTP)
    line.new(bar_index, sellEntry, bar_index + 8, sellEntry, color=color.red, width=1)
    line.new(bar_index, sellSL, bar_index + 8, sellSL, color=color.red, width=1, style=line.style_dotted)
    line.new(bar_index, sellTP, bar_index + 8, sellTP, color=color.green, width=1, style=line.style_dotted)
    label.new(bar_index, sellEntry, "Sell " + str.tostring(sellEntry, format.mintick), style=label.style_label_down, color=color.new(color.red, 70), textcolor=color.white, size=size.tiny)

alertcondition(buySignal, "MMBM Entry", "MMXM Buy Model entry")
alertcondition(sellSignal, "MMSM Entry", "MMXM Sell Model entry")
