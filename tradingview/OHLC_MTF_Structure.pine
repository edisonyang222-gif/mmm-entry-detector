//@version=6
indicator("OHLC多時框結構進場", overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=100)

//══════════════════════════════════════════════════════════════
// 輸入
//══════════════════════════════════════════════════════════════
grpTF   = "時框"
htfTF   = input.timeframe("60",  "高週期（趨勢）", group=grpTF)
mtfTF   = input.timeframe("15",  "中週期（結構）", group=grpTF)

grpStr  = "結構參數"
swingLen     = input.int(2, "擺盪左右K數", minval=1, group=grpStr)
atrLen       = input.int(14, "ATR週期", group=grpStr)
sweepLookback= input.int(30, "流動性有效窗口（K）", group=grpStr)
sweepWickAtr = input.float(0.05, "掃除影線ATR倍數", step=0.01, group=grpStr)
zoneAtr      = input.float(0.35, "回踩區寬度ATR", step=0.05, group=grpStr)
confirmBody  = input.float(0.45, "確認K實體占比", step=0.05, group=grpStr)
stopBufAtr   = input.float(0.15, "停損緩衝ATR", step=0.05, group=grpStr)
minRR        = input.float(1.5, "最小盈虧比", step=0.1, group=grpStr)
tpRR         = input.float(2.0, "停利RR", step=0.1, group=grpStr)
requireHtf   = input.bool(true, "須符合高週期偏向", group=grpStr)
requireSweep = input.bool(true, "須先掃除流動性", group=grpStr)
onePerSetup  = input.bool(true, "同一掃除僅一次進場", group=grpStr)

grpShow = "顯示"
showPanel    = input.bool(true, "顯示中文面版", group=grpShow)
showSR       = input.bool(true, "顯示有效支撐/阻力", group=grpShow)
showSweep    = input.bool(true, "顯示流動性掃除標記", group=grpShow)
showBuy      = input.bool(true, "顯示買入訊號", group=grpShow)
showSell     = input.bool(true, "顯示賣出訊號", group=grpShow)
showPlan     = input.bool(true, "顯示進場/SL/TP", group=grpShow)
sessionHour  = input.int(4, "日分隔：時", minval=0, maxval=23, group=grpShow)
sessionMinute= input.int(45, "日分隔：分", minval=0, maxval=59, group=grpShow)
showSessionV = input.bool(true, "每天開始畫黃色虛線（垂直）", group=grpShow)
showLiqPool  = input.bool(true, "顯示流動性池數量", group=grpShow)
liqTouchBars = input.int(3, "流動性量能回看K數", minval=1, maxval=20, group=grpShow)
liqEqualAtr  = input.float(0.08, "同等高低合併ATR", step=0.01, group=grpShow)
maxLiqPools  = input.int(40, "最多保留流動性池數", minval=5, maxval=100, group=grpShow)

atr = ta.atr(atrLen)
wickMin = sweepWickAtr * atr

// 每天 04:45（可調）黃色虛線垂直分隔
sessToday = timestamp(year, month, dayofmonth, sessionHour, sessionMinute)
sessKey   = time >= sessToday ? sessToday : sessToday - 86400000
newSess   = nz(ta.change(sessKey), 0) != 0
if showSessionV and newSess
    line.new(time, low, time, high, xloc=xloc.bar_time, extend=extend.both, color=color.yellow, style=line.style_dashed, width=1)

biasCN(int b) =>
    b == 1 ? "偏多 ▲" : b == -1 ? "偏空 ▼" : "盤整 ─"
consensusCN(int b) =>
    b == 1 ? "大概率向上" : b == -1 ? "大概率向下" : "方向不明，觀望"
biasColor(int b) =>
    b == 1 ? color.new(color.teal, 0) : b == -1 ? color.new(color.red, 0) : color.new(color.gray, 0)
fmtVol(float v) =>
    v >= 1000000 ? str.tostring(v / 1000000, "#.##") + "M" : v >= 1000 ? str.tostring(v / 1000, "#.#") + "K" : str.tostring(math.round(v))

//══════════════════════════════════════════════════════════════
// 擺盪 / 多時框偏向
//══════════════════════════════════════════════════════════════
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

tfBias() =>
    pHi = ta.pivothigh(high, swingLen, swingLen)
    pLo = ta.pivotlow(low, swingLen, swingLen)
    var float sHi1 = na
    var float sHi2 = na
    var float sLo1 = na
    var float sLo2 = na
    if not na(pHi)
        sHi2 := sHi1
        sHi1 := pHi
    if not na(pLo)
        sLo2 := sLo1
        sLo1 := pLo
    int b = 0
    if not na(sHi1) and not na(sHi2) and not na(sLo1) and not na(sLo2)
        hh = sHi1 > sHi2
        hl = sLo1 > sLo2
        lh = sHi1 < sHi2
        ll = sLo1 < sLo2
        if hh and hl
            b := 1
        else if lh and ll
            b := -1
    b

ltfBias = tfBias()
htfBias = nz(request.security(syminfo.tickerid, htfTF, tfBias(), barmerge.gaps_off, barmerge.lookahead_off), 0)
mtfBias = nz(request.security(syminfo.tickerid, mtfTF, tfBias(), barmerge.gaps_off, barmerge.lookahead_off), 0)
consensus =
     htfBias == mtfBias and htfBias != 0 ? htfBias :
     htfBias != 0 and mtfBias == 0 ? htfBias :
     htfBias == 0 and mtfBias != 0 ? mtfBias :
     htfBias != 0 and ltfBias == htfBias ? htfBias : 0
reasonTxt =
     consensus == 1 ? "高週期與中週期結構偏多，優先找回踩做多" :
     consensus == -1 ? "高週期與中週期結構偏空，優先找回踩做空" :
     "多時框未對齊，等待結構轉折或流動性掃除"

var float lastSwingLow = na
var float lastSwingHigh = na
var int   lastSwingLowBar = na
var int   lastSwingHighBar = na
if not na(pl)
    lastSwingLow := pl
    lastSwingLowBar := bar_index - swingLen
if not na(ph)
    lastSwingHigh := ph
    lastSwingHighBar := bar_index - swingLen
swingLowBroken = not na(lastSwingLow) and close < lastSwingLow
swingHighBroken = not na(lastSwingHigh) and close > lastSwingHigh

//══════════════════════════════════════════════════════════════
// 流動性池數量：未獵取保留數字；被獵取後取消
//══════════════════════════════════════════════════════════════
poolVolAt(int pivBar, float lvl, bool isHigh) =>
    float tol = math.max(nz(atr, 0) * liqEqualAtr, syminfo.mintick)
    float acc = 0.0
    int centerOff = bar_index - pivBar
    if centerOff >= 0
        int fromOff = math.max(0, centerOff - liqTouchBars)
        int toOff = centerOff + liqTouchBars
        for j = fromOff to toOff
            float px = isHigh ? high[j] : low[j]
            if math.abs(px - lvl) <= tol
                acc += nz(volume[j], 0.0)
        if acc <= 0
            acc := math.max(nz(volume[centerOff], 0.0), 1.0)
    else
        acc := 1.0
    acc

var array<float> liqPrice = array.new_float()
var array<bool>  liqIsHigh = array.new_bool()
var array<float> liqVol = array.new_float()
var array<label> liqLbl = array.new_label()
var array<bool>  liqAlive = array.new_bool()
var array<int>   liqTime = array.new_int()

countAlive() =>
    int c = 0
    int n = array.size(liqAlive)
    if n > 0
        for i = 0 to n - 1
            if array.get(liqAlive, i)
                c += 1
    c

f_fmtPool(bool isHigh, float vol) =>
    (isHigh ? "R↑ " : "S↓ ") + fmtVol(vol)

f_killOldest() =>
    int n = array.size(liqAlive)
    if n > 0
        for k = 0 to n - 1
            if array.get(liqAlive, k)
                label old = array.get(liqLbl, k)
                if not na(old)
                    label.delete(old)
                array.set(liqAlive, k, false)
                break

f_addOrMergePool(float lvl, bool isHigh, float vol, int pivBar) =>
    float tol = math.max(nz(atr, 0) * liqEqualAtr, syminfo.mintick)
    // 用 K 線時間錨點（bar_time），拖移圖表時標示跟著蠟燭走
    int pivOff = bar_index - pivBar
    int pivTime = pivOff >= 0 ? time[pivOff] : time
    bool merged = false
    int n = array.size(liqPrice)
    if n > 0
        for i = 0 to n - 1
            if array.get(liqAlive, i) and array.get(liqIsHigh, i) == isHigh and math.abs(array.get(liqPrice, i) - lvl) <= tol
                float nv = array.get(liqVol, i) + vol
                array.set(liqVol, i, nv)
                array.set(liqPrice, i, (array.get(liqPrice, i) + lvl) * 0.5)
                label lb = array.get(liqLbl, i)
                if not na(lb)
                    label.set_text(lb, f_fmtPool(isHigh, nv))
                    label.set_y(lb, array.get(liqPrice, i))
                    // x 保持原樞軸時間，不改動
                merged := true
                break
    if not merged and showLiqPool
        for __i = 0 to 10
            if countAlive() < maxLiqPools
                break
            f_killOldest()
        string style_ = isHigh ? label.style_label_down : label.style_label_up
        color bg = isHigh ? color.new(color.fuchsia, 20) : color.new(color.aqua, 20)
        label lbNew = label.new(pivTime, lvl, f_fmtPool(isHigh, vol), xloc=xloc.bar_time, yloc=yloc.price, style=style_, color=bg, textcolor=color.white, size=size.small)
        array.push(liqPrice, lvl)
        array.push(liqIsHigh, isHigh)
        array.push(liqVol, vol)
        array.push(liqLbl, lbNew)
        array.push(liqAlive, true)
        array.push(liqTime, pivTime)

if not na(ph) and showLiqPool
    f_addOrMergePool(ph, true, poolVolAt(bar_index - swingLen, ph, true), bar_index - swingLen)
if not na(pl) and showLiqPool
    f_addOrMergePool(pl, false, poolVolAt(bar_index - swingLen, pl, false), bar_index - swingLen)

// 被獵取 → 取消數字；未獵取 → 保留
if barstate.isconfirmed and showLiqPool and array.size(liqAlive) > 0
    for i = 0 to array.size(liqAlive) - 1
        if array.get(liqAlive, i)
            float lvl = array.get(liqPrice, i)
            bool isH = array.get(liqIsHigh, i)
            bool hunted = isH ? high > lvl + wickMin : low < lvl - wickMin
            if hunted
                label lb = array.get(liqLbl, i)
                if not na(lb)
                    label.delete(lb)
                array.set(liqAlive, i, false)

alivePools = countAlive()
float aliveVol = 0.0
if array.size(liqAlive) > 0
    for i = 0 to array.size(liqAlive) - 1
        if array.get(liqAlive, i)
            aliveVol += array.get(liqVol, i)

//══════════════════════════════════════════════════════════════
// 流動性掃除狀態（進場前置）
//══════════════════════════════════════════════════════════════
prevSwingLowBroken = bar_index > 0 ? swingLowBroken[1] : false
prevSwingHighBroken = bar_index > 0 ? swingHighBroken[1] : false
sweepLowNow = barstate.isconfirmed and not na(lastSwingLow) and not prevSwingLowBroken and low < lastSwingLow - wickMin and close > lastSwingLow and close > open
sweepHighNow = barstate.isconfirmed and not na(lastSwingHigh) and not prevSwingHighBroken and high > lastSwingHigh + wickMin and close < lastSwingHigh and close < open

var bool  hasLowSweep = false
var bool  hasHighSweep = false
var float lowSweepLevel = na
var float highSweepLevel = na
var int   lowSweepBar = na
var int   highSweepBar = na
var bool  lowConsumed = false
var bool  highConsumed = false
var bool  lowLeftZone = false
var bool  highLeftZone = false

if barstate.isconfirmed
    if hasLowSweep and not na(lowSweepBar) and (bar_index - lowSweepBar) > sweepLookback
        hasLowSweep := false
        lowConsumed := false
        lowLeftZone := false
    if hasHighSweep and not na(highSweepBar) and (bar_index - highSweepBar) > sweepLookback
        hasHighSweep := false
        highConsumed := false
        highLeftZone := false
    if sweepLowNow
        hasLowSweep := true
        lowSweepLevel := lastSwingLow
        lowSweepBar := bar_index
        lowConsumed := false
        lowLeftZone := false
    if sweepHighNow
        hasHighSweep := true
        highSweepLevel := lastSwingHigh
        highSweepBar := bar_index
        highConsumed := false
        highLeftZone := false
    if hasLowSweep and not lowConsumed and not na(lowSweepLevel) and close > lowSweepLevel + zoneAtr * atr
        lowLeftZone := true
    if hasHighSweep and not highConsumed and not na(highSweepLevel) and close < highSweepLevel - zoneAtr * atr
        highLeftZone := true

float validSupport = hasLowSweep and not na(lowSweepLevel) ? lowSweepLevel : (not na(lastSwingLow) and not swingLowBroken and close > lastSwingLow ? lastSwingLow : na)
float validResist  = hasHighSweep and not na(highSweepLevel) ? highSweepLevel : (not na(lastSwingHigh) and not swingHighBroken and close < lastSwingHigh ? lastSwingHigh : na)
supNote = hasLowSweep ? "掃除後有效支撐" : (not na(validSupport) ? "擺盪低點支撐" : "無")
resNote = hasHighSweep ? "掃除後有效阻力" : (not na(validResist) ? "擺盪高點阻力" : "無")

//══════════════════════════════════════════════════════════════
// 回踩進場
//══════════════════════════════════════════════════════════════
rng = high - low
bodyRatio = rng > 0 ? math.abs(close - open) / rng : 0.0
bullConfirm = close > open and bodyRatio >= confirmBody
bearConfirm = close < open and bodyRatio >= confirmBody
bullBiasOk = not requireHtf or consensus == 1 or htfBias == 1
bearBiasOk = not requireHtf or consensus == -1 or htfBias == -1

buySignal = false
sellSignal = false
var float sigEntry = na
var float sigSL = na
var float sigTP = na
var string sigType = ""

if barstate.isconfirmed
    if bullBiasOk and not na(validSupport)
        sweepOk = not requireSweep or hasLowSweep
        unused = not onePerSetup or not lowConsumed
        pulled = not requireSweep or lowLeftZone
        afterSweep = not hasLowSweep or bar_index > nz(lowSweepBar, -1)
        zoneTop = validSupport + zoneAtr * atr
        zoneBot = validSupport - zoneAtr * atr
        touched = (low <= zoneTop and low >= zoneBot) or (low <= validSupport and close >= validSupport)
        if sweepOk and unused and pulled and afterSweep and touched and bullConfirm and close >= validSupport
            entry = close
            sl = math.min(zoneBot, validSupport) - stopBufAtr * atr
            risk = entry - sl
            tp = entry + tpRR * risk
            rr = risk > 0 ? (tp - entry) / risk : 0.0
            if rr >= minRR
                buySignal := true
                sigEntry := entry
                sigSL := sl
                sigTP := tp
                sigType := "S 回踩有效支撐"
                if onePerSetup
                    lowConsumed := true
    if not buySignal and bearBiasOk and not na(validResist)
        sweepOk = not requireSweep or hasHighSweep
        unused = not onePerSetup or not highConsumed
        pulled = not requireSweep or highLeftZone
        afterSweep = not hasHighSweep or bar_index > nz(highSweepBar, -1)
        zoneTop = validResist + zoneAtr * atr
        zoneBot = validResist - zoneAtr * atr
        touched = (high >= zoneBot and high <= zoneTop) or (high >= validResist and close <= validResist)
        if sweepOk and unused and pulled and afterSweep and touched and bearConfirm and close <= validResist
            entry = close
            sl = math.max(zoneTop, validResist) + stopBufAtr * atr
            risk = sl - entry
            tp = entry - tpRR * risk
            rr = risk > 0 ? (entry - tp) / risk : 0.0
            if rr >= minRR
                sellSignal := true
                sigEntry := entry
                sigSL := sl
                sigTP := tp
                sigType := "R 回踩有效阻力"
                if onePerSetup
                    highConsumed := true

plotshape(showBuy and buySignal, title="買入", style=shape.triangleup, location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="S")
plotshape(showSell and sellSignal, title="賣出", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="R")
plotshape(showSweep and sweepLowNow, title="掃除下方", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.tiny)
plotshape(showSweep and sweepHighNow, title="掃除上方", style=shape.diamond, location=location.abovebar, color=color.fuchsia, size=size.tiny)

//══════════════════════════════════════════════════════════════
// S/R 線與標籤：只在最後一根維護；標籤釘在「目前可視區右側」
// 使用 chart.right_visible_bar_time → 拖移/縮放圖表時會重算並跟著走
//══════════════════════════════════════════════════════════════
var line lnSup = na
var line lnRes = na
var label lbSup = na
var label lbRes = na
var int sessStartTime = na

if newSess
    if not na(lnSup)
        line.set_x2(lnSup, time[1])
    if not na(lnRes)
        line.set_x2(lnRes, time[1])
    sessStartTime := time
    // 換日時清掉舊標籤（線段保留到昨日收尾）
    if not na(lbSup)
        label.delete(lbSup)
    if not na(lbRes)
        label.delete(lbRes)
    lnSup := na
    lnRes := na
    lbSup := na
    lbRes := na

// 歷史過程只延長線，不碰標籤座標（避免跑掉）
if showSR and not na(validSupport) and not barstate.islast
    if na(lnSup)
        lnSup := line.new(nz(sessStartTime, time), validSupport, time, validSupport, xloc=xloc.bar_time, extend=extend.none, color=color.teal, style=line.style_solid, width=2)
    else
        line.set_x2(lnSup, time)
        line.set_y1(lnSup, validSupport)
        line.set_y2(lnSup, validSupport)

if showSR and not na(validResist) and not barstate.islast
    if na(lnRes)
        lnRes := line.new(nz(sessStartTime, time), validResist, time, validResist, xloc=xloc.bar_time, extend=extend.none, color=color.red, style=line.style_solid, width=2)
    else
        line.set_x2(lnRes, time)
        line.set_y1(lnRes, validResist)
        line.set_y2(lnRes, validResist)

if barstate.islast
    int tagX = nz(chart.right_visible_bar_time, time)
    int lineX2 = math.max(time, tagX)
    int lineX1 = nz(sessStartTime, time)

    if showSR and not na(validSupport)
        if na(lnSup)
            lnSup := line.new(lineX1, validSupport, lineX2, validSupport, xloc=xloc.bar_time, extend=extend.none, color=color.teal, style=line.style_solid, width=2)
        else
            line.set_xy1(lnSup, lineX1, validSupport)
            line.set_xy2(lnSup, lineX2, validSupport)
        if na(lbSup)
            lbSup := label.new(tagX, validSupport, "S", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.teal, 20), textcolor=color.white, size=size.normal)
        else
            label.set_xy(lbSup, tagX, validSupport)
            label.set_text(lbSup, "S")
    else
        if not na(lbSup)
            label.delete(lbSup)
            lbSup := na

    if showSR and not na(validResist)
        if na(lnRes)
            lnRes := line.new(lineX1, validResist, lineX2, validResist, xloc=xloc.bar_time, extend=extend.none, color=color.red, style=line.style_solid, width=2)
        else
            line.set_xy1(lnRes, lineX1, validResist)
            line.set_xy2(lnRes, lineX2, validResist)
        if na(lbRes)
            lbRes := label.new(tagX, validResist, "R", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.red, 20), textcolor=color.white, size=size.normal)
        else
            label.set_xy(lbRes, tagX, validResist)
            label.set_text(lbRes, "R")
    else
        if not na(lbRes)
            label.delete(lbRes)
            lbRes := na

    // 流動性池：強制用當初紀錄的樞軸時間重釘（防止跑掉）
    if showLiqPool and array.size(liqAlive) > 0
        for i = 0 to array.size(liqAlive) - 1
            if array.get(liqAlive, i)
                label lb = array.get(liqLbl, i)
                if not na(lb)
                    label.set_xy(lb, array.get(liqTime, i), array.get(liqPrice, i))
                    label.set_text(lb, f_fmtPool(array.get(liqIsHigh, i), array.get(liqVol, i)))

if showPlan and (buySignal or sellSignal)
    int tEnd = time + timeframe.in_seconds() * 1000 * 8
    line.new(time, sigEntry, tEnd, sigEntry, xloc=xloc.bar_time, color=buySignal ? color.teal : color.red, width=1)
    line.new(time, sigSL, tEnd, sigSL, xloc=xloc.bar_time, color=color.red, style=line.style_dotted)
    line.new(time, sigTP, tEnd, sigTP, xloc=xloc.bar_time, color=color.lime, style=line.style_dotted)
    label.new(time, buySignal ? low : high, buySignal ? "S 回踩有效支撐" : "R 回踩有效阻力", xloc=xloc.bar_time, yloc=yloc.price, style=buySignal ? label.style_label_up : label.style_label_down, color=buySignal ? color.teal : color.maroon, textcolor=color.white, size=size.small)

//══════════════════════════════════════════════════════════════
// 中文面版
//══════════════════════════════════════════════════════════════
var table panel = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)
liqTxt = hasLowSweep ? "已掃除下方 ✓" : hasHighSweep ? "已掃除上方 ✓" : "尚未掃除"
liqCol = hasLowSweep ? color.aqua : hasHighSweep ? color.fuchsia : color.gray
armTxt =
     hasLowSweep and not lowConsumed and lowLeftZone ? "偏多｜已離開，等待回踩支撐" :
     hasLowSweep and not lowConsumed ? "偏多｜已掃除，等待離開後回踩" :
     hasHighSweep and not highConsumed and highLeftZone ? "偏空｜已離開，等待回踩阻力" :
     hasHighSweep and not highConsumed ? "偏空｜已掃除，等待離開後回踩" :
     "等待流動性掃除"
poolTxt = str.tostring(alivePools) + " 池｜量 " + fmtVol(aliveVol) + "（未獵取保留）"

f_cell(int r, string a, string b, color c) =>
    table.cell(panel, 0, r, a, text_color=color.silver, text_halign=text.align_left, text_size=size.small)
    table.cell(panel, 1, r, b, text_color=c, text_halign=text.align_left, text_size=size.small)

if showPanel and barstate.islast
    table.cell(panel, 0, 0, "多時框結構面版", text_color=color.yellow, text_halign=text.align_left, text_size=size.normal)
    table.cell(panel, 1, 0, "", text_color=color.yellow)
    f_cell(1, "高週期 " + htfTF, biasCN(htfBias), biasColor(htfBias))
    f_cell(2, "中週期 " + mtfTF, biasCN(mtfBias), biasColor(mtfBias))
    f_cell(3, "低週期 圖表", biasCN(ltfBias), biasColor(ltfBias))
    f_cell(4, "綜合偏向", consensusCN(consensus), biasColor(consensus))
    f_cell(5, "理由", reasonTxt, color.white)
    f_cell(6, "流動性狀態", liqTxt, liqCol)
    f_cell(7, "流動性池", poolTxt, color.orange)
    f_cell(8, "有效支撐 S", na(validSupport) ? "無" : str.tostring(validSupport, format.mintick) + "（" + supNote + "）", color.teal)
    f_cell(9, "有效阻力 R", na(validResist) ? "無" : str.tostring(validResist, format.mintick) + "（" + resNote + "）", color.red)
    f_cell(10, "設置狀態", armTxt, color.aqua)
    lastSigTxt = buySignal ? "買入｜" + sigType : sellSignal ? "賣出｜" + sigType : "無（僅收K確認）"
    f_cell(11, "最近訊號", lastSigTxt, buySignal ? color.lime : sellSignal ? color.red : color.gray)
    planTxt = (buySignal or sellSignal) ? ("進場 " + str.tostring(sigEntry, format.mintick) + "  SL " + str.tostring(sigSL, format.mintick) + "  TP " + str.tostring(sigTP, format.mintick)) : "未獵取池保留數字；獵取後取消"
    f_cell(12, "計畫", planTxt, color.white)

alertcondition(buySignal, "結構買入", "回踩有效支撐買入訊號")
alertcondition(sellSignal, "結構賣出", "回踩有效阻力賣出訊號")
alertcondition(sweepLowNow, "掃除下方流動性", "已掃除下方流動性")
alertcondition(sweepHighNow, "掃除上方流動性", "已掃除上方流動性")
